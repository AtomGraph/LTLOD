@prefix def:  <https://w3id.org/atomgraph/linkeddatahub/default#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a def:Root ;
    dct:title "Lietuvos susietieji atvirieji duomenys"@lt, "Lithuanian Linked Open Data"@en ;
    dct:description "Oficialių Lietuvos registrų duomenys vienoje vietoje: administraciniai vienetai, Seimo nariai, juridiniai asmenys, klasifikatoriai."@lt, "Data from official Lithuanian registers in one place: administrative units, members of the Seimas, legal entities, classifications."@en ;
    rdf:_1 <#intro> ;
    rdf:_2 <#counties-intro> ;
    rdf:_3 <#counties-block> ;
    rdf:_4 <#counties-map-block> ;
    rdf:_5 <#chart-factions-intro> ;
    rdf:_6 <#chart-factions-block> ;
    rdf:_7 <#parties-intro> ;
    rdf:_8 <#parties-block> ;
    rdf:_9 <#table-chairs-intro> ;
    rdf:_10 <#table-chairs-block> ;
    rdf:_11 <#sittings-intro> ;
    rdf:_12 <#sittings-block> ;
    rdf:_13 <#browse-intro> ;
    rdf:_14 <#select-children> .

# rdf:_1 — mission intro (title/description already render above)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lede">Oficialių Lietuvos registrų duomenys vienoje vietoje: administraciniai vienetai, Seimo nariai, partijos, juridiniai asmenys ir klasifikatoriai. Duomenys susieti tarpusavyje, tad nuo vieno objekto galite pereiti prie visų su juo susijusių — nuo apskrities prie savivaldybių, nuo Seimo nario prie jo komitetų ir partijos.</p>
        <p>Žemiau — keli pjūviai iš duomenų: apskritys žemėlapyje, Seimo frakcijos, partijos, komitetų pirmininkai ir naujausi plenariniai posėdžiai. Visi duomenų rinkiniai — puslapio apačioje.</p>
    </div>"""^^rdf:XMLLiteral .

# rdf:_2 / rdf:_3 — top-level administrative units (counties) as a grid of coats of arms

<#counties-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Apskritys</h3>
        <p>Dešimt Lietuvos apskričių — aukščiausias administracinio suskirstymo lygmuo. Kiekviena apima savivaldybes, seniūnijas ir gyvenamąsias vietoves; atverkite apskritį, kad naršytumėte jos sudedamuosius vienetus.</p>
    </div>"""^^rdf:XMLLiteral .

<#counties-block> a ldh:Object ;
    rdf:value <#counties-view> .

<#counties-view> a ldh:View ;
    dct:title "Apskritys"@lt, "Counties"@en ;
    spin:query <#counties-query> ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false .

<#counties-query> a sp:Select ;
    dct:title "Apskritys"@lt, "Counties"@en ;
    sp:text """PREFIX cv:   <http://data.europa.eu/m8g/>
PREFIX atu:  <http://publications.europa.eu/resource/authority/atu-type/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# Top-level admin units = counties (apskritys), identified by EU ATU level LTU_APS.
# LDH DESCRIBEs each ?unit; GridMode renders it as a card with one image. The SELECT
# can't pick which (it's DESCRIBE-wrapped, and LDH's ac:image shows the single most
# representative image) — so reconciliation puts the coat of arms (P94) on foaf:img
# (which outranks foaf:depiction) and any scenery photo (P18) on foaf:depiction,
# giving every card a coat of arms deterministically. Project a single entity type.
SELECT DISTINCT ?unit
WHERE
{
    GRAPH ?graph
    {
        ?unit a cv:AdminUnit ;
            cv:level atu:LTU_APS ;
            skos:prefLabel ?label .
    }
}
ORDER BY ?label""" .

# rdf:_4 — the same counties as a map. Admin units carry WGS84 geo:lat/geo:long
# (AR-spatial *-geo.trig, merged on load); ac:MapMode plots each apskritis as a
# marker over OpenStreetMap. Reuses <#counties-query> — LDH DESCRIBEs each ?unit
# and reads its coordinates.

<#counties-map-block> a ldh:Object ;
    rdf:value <#counties-map-view> .

<#counties-map-view> a ldh:View ;
    dct:title "Apskritys žemėlapyje"@lt, "Counties on the map"@en ;
    spin:query <#counties-query> ;
    ac:mode ac:MapMode ;
    ldh:showWhenEmpty false .

# rdf:_5 / rdf:_6 — faction sizes bar chart

<#chart-factions-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Frakcijų dydžiai</h3>
        <p>Kiek narių šiuo metu turi kiekviena Seimo frakcija. Skaičiuojami tik dabartiniai frakcijų nariai.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-factions-block> a ldh:Object ;
    rdf:value <#chart-factions> .

<#chart-factions> a ldh:ResultSetChart ;
    dct:title "Frakcijų dydžiai"@lt, "Faction sizes"@en ;
    spin:query <#chart-factions-query> ;
    ldh:chartType ac:BarChart ;
    ldh:categoryVarName "faction" ;
    ldh:seriesVarName "members" .

<#chart-factions-query> a sp:Select ;
    dct:title "Nariai pagal frakciją"@lt, "Members by faction"@en ;
    sp:text """PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>

SELECT ?faction (COUNT(DISTINCT ?person) AS ?members)
WHERE
{
    GRAPH ?personGraph
    {
        ?membership org:member ?person ;
            org:organization ?org ;
            org:memberDuring ?interval .
        FILTER NOT EXISTS { ?interval time:hasEnd ?end }
    }
    GRAPH ?orgGraph
    {
        ?org dct:type ?type ;
            skos:prefLabel ?faction .
    }
    GRAPH ?typeGraph { ?type skos:prefLabel ?typeLabel }
    FILTER(CONTAINS(LCASE(STR(?typeLabel)), "frakcij"))
    FILTER(LANG(?faction) = "lt")
}
GROUP BY ?faction
ORDER BY DESC(?members)""" .

# rdf:_7 / rdf:_8 — parties that nominated Seimas members (clickable list)

<#parties-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Seimo narius iškėlusios partijos</h3>
        <p>Partijos, iškėlusios dabartinius ir buvusius Seimo narius. Atverkite partiją, kad pamatytumėte jos iškeltus narius.</p>
    </div>"""^^rdf:XMLLiteral .

<#parties-block> a ldh:Object ;
    rdf:value <#parties-view> .

<#parties-view> a ldh:View ;
    dct:title "Seimo narius iškėlusios partijos"@lt, "Parties that nominated members of the Seimas"@en ;
    spin:query <#parties-query> ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false .

<#parties-query> a sp:Select ;
    dct:title "Seimo narius iškėlusios partijos"@lt, "Parties that nominated members of the Seimas"@en ;
    sp:text """PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>

# LDH renders a view by DESCRIBE-ing the projected terms, so project a single
# entity type — the parties. Each party's label/links come from its own
# description. (Per-party member counts are not shown — a DESCRIBE view can't
# render an aggregate; those counts stay available via SPARQL / EXAMPLES.md.)
SELECT DISTINCT ?party
WHERE
{
    GRAPH ?personGraph { ?person ltlod:nominatedBy ?party }
    GRAPH ?partyGraph { ?party skos:prefLabel ?label }
}
ORDER BY ?label""" .

# rdf:_9 / rdf:_10 — committee chairs (single entity type: the chair persons)

<#table-chairs-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Komitetų ir komisijų pirmininkai</h3>
        <p>Seimo nariai, kurie šiuo metu vadovauja komitetams, komisijoms ir frakcijoms — pirmininkai ir frakcijų seniūnai.</p>
    </div>"""^^rdf:XMLLiteral .

<#table-chairs-block> a ldh:Object ;
    rdf:value <#table-chairs-view> .

<#table-chairs-view> a ldh:View ;
    dct:title "Komitetų ir komisijų pirmininkai"@lt, "Committee and commission chairs"@en ;
    spin:query <#table-chairs-query> ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false .

<#table-chairs-query> a sp:Select ;
    dct:title "Komitetų ir komisijų pirmininkai"@lt, "Committee and commission chairs"@en ;
    sp:text """PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX time:  <http://www.w3.org/2006/time#>

# LDH renders a view by DESCRIBE-ing the projected terms, so project a single
# entity type — the chair persons. LDH resolves each person's label, portrait
# and links from their own description. (Projecting several types, or label
# literals, produces a muddled or empty table.) The role-per-unit detail lives
# in the full query in queries/committee-chairs.rq and EXAMPLES.md.
SELECT DISTINCT ?person
WHERE
{
    GRAPH ?personGraph
    {
        ?membership a org:Membership ;
            org:member ?person ;
            org:role ?roleConcept ;
            org:memberDuring ?interval .
        FILTER NOT EXISTS { ?interval time:hasEnd ?end }
    }
    GRAPH ?roleGraph { ?roleConcept skos:prefLabel ?role }
    FILTER(LANG(?role) = "lt" &&
           (CONTAINS(LCASE(STR(?role)), "pirminink") || CONTAINS(LCASE(STR(?role)), "seniūn")))
    FILTER(!CONTAINS(LCASE(STR(?role)), "pavaduotoj"))   # skip deputies
}
ORDER BY ?person""" .

# rdf:_11 / rdf:_12 — plenary sittings of the ongoing session (the one without an
# end date), latest first; each links on to its protocol and stenogram

<#sittings-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Dabartinės sesijos posėdžiai</h3>
        <p>Šiuo metu vykstančios Seimo sesijos plenariniai posėdžiai, naujausi viršuje. Visi posėdžiai nuo 1990 m. — su protokolais ir stenogramomis — suskirstyti pagal kadencijas ir sesijas.</p>
    </div>"""^^rdf:XMLLiteral .

<#sittings-block> a ldh:Object ;
    rdf:value <#sittings-view> .

<#sittings-view> a ldh:View ;
    dct:title "Dabartinės sesijos posėdžiai"@lt, "Sittings of the current session"@en ;
    spin:query <#sittings-query> ;
    ldh:showWhenEmpty false .

<#sittings-query> a sp:Select ;
    dct:title "Dabartinės sesijos posėdžiai"@lt, "Sittings of the current session"@en ;
    sp:text """PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>

# Project a single entity type — the sittings. The ongoing session is the one
# without eli-dl:activity_end_date (sessions.rq).
SELECT DISTINCT ?sitting
WHERE
{
    GRAPH ?sessionGraph
    {
        ?session a schema:EventSeries ;
            eli-dl:activity_start_date ?sessionStart .
        FILTER NOT EXISTS { ?session eli-dl:activity_end_date ?sessionEnd }
    }
    GRAPH ?sittingGraph
    {
        ?sitting eli-dl:forms_part_of ?session ;
            eli-dl:activity_date ?date .
    }
}
ORDER BY DESC(?date) DESC(?sitting)""" .

# rdf:_13 — browse prompt, then rdf:_14 — the container listing (LAST)

<#browse-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Naršyti duomenų rinkinius</h3>
        <p>Visi rinkiniai — administraciniai vienetai, asmenys, organizacijos, partijos, juridiniai asmenys, gatvės ir klasifikatoriai. Pasirinkite rinkinį žemiau ir naršykite jo įrašus.</p>
    </div>"""^^rdf:XMLLiteral .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
