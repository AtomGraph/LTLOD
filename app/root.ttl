@prefix def:  <https://w3id.org/atomgraph/linkeddatahub/default#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a def:Root ;
    dct:title "Lietuvos susietieji atvirieji duomenys"@lt ;
    dct:description "Lietuvos atvirieji duomenys, sujungti į vientisą RDF žinių grafą: administraciniai vienetai, Seimo nariai, juridiniai asmenys, klasifikatoriai."@lt ;
    rdf:_1 <#intro> ;
    rdf:_2 <#chart-factions-intro> ;
    rdf:_3 <#chart-factions-block> ;
    rdf:_4 <#chart-parties-intro> ;
    rdf:_5 <#chart-parties-block> ;
    rdf:_6 <#table-chairs-intro> ;
    rdf:_7 <#table-chairs-block> ;
    rdf:_8 <#browse-intro> ;
    rdf:_9 <#select-children> .

# rdf:_1 — mission intro (title/description already render above)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lead">Lietuvos atvirieji duomenys iš oficialių registrų, sujungti į vientisą, standartais grįstą RDF žinių grafą — kiekvienas objektas turi pasaulinį URI, tad rinkiniai susijungia savaime ir yra susieti su Wikidata bei ES žodynais.</p>
        <p>Visą grafą galima užklausti <a href="sparql">SPARQL</a> kalba; pavyzdinės užklausos su rezultatais — <a href="https://github.com/AtomGraph/LTLOD/blob/master/etl/queries/EXAMPLES.md" target="_blank">etl/queries/EXAMPLES.md</a>. Žemiau — keli pjūviai iš gyvo grafo; konteineriai su visais rinkiniais — puslapio apačioje.</p>
    </div>"""^^rdf:XMLLiteral .

# rdf:_2 / rdf:_3 — faction sizes bar chart

<#chart-factions-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Frakcijų dydžiai</h3>
        <p>Dabartinių Seimo frakcijų sudėtis pagal narių skaičių. Objektai susiejami dviem duomenų rinkiniais: asmenys ↔ padaliniai per <code>org:Membership</code>; „dabartinis“ — narystės intervalas be pabaigos datos.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-factions-block> a ldh:Object ;
    rdf:value <#chart-factions> .

<#chart-factions> a ldh:ResultSetChart ;
    dct:title "Frakcijų dydžiai"@lt ;
    spin:query <#chart-factions-query> ;
    ldh:chartType ac:BarChart ;
    ldh:categoryVarName "faction" ;
    ldh:seriesVarName "members" .

<#chart-factions-query> a sp:Select ;
    dct:title "Nariai pagal frakciją"@lt ;
    sp:text """PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>

SELECT ?faction (COUNT(DISTINCT ?person) AS ?members)
FROM <urn:x-arq:UnionGraph>
WHERE
{
    ?membership org:member ?person ;
        org:organization ?org ;
        org:memberDuring ?interval .
    FILTER NOT EXISTS { ?interval time:hasEnd ?end }

    ?org dct:type/skos:prefLabel ?typeLabel ;
        skos:prefLabel ?faction .
    FILTER(CONTAINS(LCASE(STR(?typeLabel)), "frakcij"))
    FILTER(LANG(?faction) = "lt")
}
GROUP BY ?faction
ORDER BY DESC(?members)""" .

# rdf:_4 / rdf:_5 — members per nominating party bar chart

<#chart-parties-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Nariai pagal partiją</h3>
        <p>Kiek Seimo narių iškėlė kiekviena partija. Sieja asmenis su partijomis per <code>ltlod:nominatedBy</code> — vienintelį savą LTLOD terminą, kuriam ES/W3C atitikmens nėra.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-parties-block> a ldh:Object ;
    rdf:value <#chart-parties> .

<#chart-parties> a ldh:ResultSetChart ;
    dct:title "Nariai pagal partiją"@lt ;
    spin:query <#chart-parties-query> ;
    ldh:chartType ac:BarChart ;
    ldh:categoryVarName "party" ;
    ldh:seriesVarName "members" .

<#chart-parties-query> a sp:Select ;
    dct:title "Nariai pagal iškėlusią partiją"@lt ;
    sp:text """PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT ?party (COUNT(DISTINCT ?person) AS ?members)
FROM <urn:x-arq:UnionGraph>
WHERE
{
    ?person ltlod:nominatedBy ?p .
    ?p skos:prefLabel ?party .
    FILTER(LANG(?party) = "lt")
}
GROUP BY ?party
ORDER BY DESC(?members)""" .

# rdf:_6 / rdf:_7 — committee chairs (single entity type: the chair persons)

<#table-chairs-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Komitetų ir komisijų pirmininkai</h3>
        <p>Seimo nariai, kurie šiuo metu vadovauja komitetams, komisijoms ir frakcijoms — pirmininkai ir frakcijų seniūnai.</p>
    </div>"""^^rdf:XMLLiteral .

<#table-chairs-block> a ldh:Object ;
    rdf:value <#table-chairs-view> .

<#table-chairs-view> a ldh:View ;
    spin:query <#table-chairs-query> ;
    ac:mode ac:TableMode .

<#table-chairs-query> a sp:Select ;
    dct:title "Komitetų ir komisijų pirmininkai"@lt ;
    sp:text """PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX time:  <http://www.w3.org/2006/time#>

# LDH renders a view by DESCRIBE-ing the projected terms, so project a single
# entity type — the chair persons. LDH resolves each person's label, portrait
# and links from their own description. (Projecting several types, or label
# literals, produces a muddled or empty table.) The role-per-unit detail lives
# in the full query in etl/queries/committee-chairs.rq and EXAMPLES.md.
SELECT DISTINCT ?person
FROM <urn:x-arq:UnionGraph>
WHERE
{
    ?membership a org:Membership ;
        org:member ?person ;
        org:role ?roleConcept ;
        org:memberDuring ?interval .
    FILTER NOT EXISTS { ?interval time:hasEnd ?end }

    ?roleConcept skos:prefLabel ?role .
    FILTER(LANG(?role) = "lt" &&
           (CONTAINS(LCASE(STR(?role)), "pirminink") || CONTAINS(LCASE(STR(?role)), "seniūn")))
    FILTER(!CONTAINS(LCASE(STR(?role)), "pavaduotoj"))   # skip deputies
}
ORDER BY ?person""" .

# rdf:_8 — browse prompt, then rdf:_9 — the container listing (LAST)

<#browse-intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <h3>Naršyti duomenų rinkinius</h3>
        <p>Visi rinkiniai — administraciniai vienetai, asmenys, organizacijos, partijos, juridiniai asmenys, gatvės ir taksonomijos — pasiekiami per konteinerius žemiau.</p>
    </div>"""^^rdf:XMLLiteral .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
