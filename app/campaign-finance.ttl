@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a dh:Container ;
    dct:title "Politinių kampanijų finansai"@lt, "Political campaign finance"@en ;
    rdf:_1 <#intro> ;
    rdf:_2 <#chart-spending-block> ;
    rdf:_3 <#select-children> .

# rdf:_1 / rdf:_2 — intro + 2024 campaign spending by party (campaign-finance x parties); rdf:_3 — the listing (LAST)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lede">Seimo rinkimų politinių kampanijų pajamos ir išlaidos nuo 2008 m. pagal VRK duomenis: kiekvienas kampanijos dalyvis (kandidatas, partija, sąrašas) — atskiras dokumentas, susietas su rinkimais, Seimo nariu ar partija ir kandidato rezultatu apygardoje.</p>
        <p>Juridinių asmenų įnašai ir apmokėtos paslaugos rodomi kiekvienas atskirai ir susieti su juridiniu asmeniu (JAR kodu); fizinių asmenų aukos ir paslaugos — tik sumos pagal lėšų šaltinį ar išlaidų paskirtį, be asmenų duomenų.</p>
        <p>2024 m. Seimo rinkimų kampanijų išlaidos juridiniams asmenims pagal partiją (partijos ir jos iškeltų kandidatų kampanijos), tūkst. EUR.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-spending-block> a ldh:Object ;
    rdf:value <#chart-spending> .

<#chart-spending> a ldh:ResultSetChart ;
    dct:title "2024 m. Seimo rinkimų kampanijų išlaidos pagal partiją"@lt, "2024 Seimas campaign spending by party"@en ;
    spin:query <#chart-spending-query> ;
    ldh:chartType ac:BarChart ;
    ldh:categoryVarName "partija" ;
    ldh:seriesVarName "tukst_eur" .

<#chart-spending-query> a sp:Select ;
    dct:title "2024 m. Seimo rinkimų kampanijų išlaidos pagal partiją"@lt, "2024 Seimas campaign spending by party"@en ;
    sp:text """PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>

# A participant document holds the participant and its expense fragments, so one GRAPH
# block; the party is the participant's own (a party campaign) or its candidate's
# nominating party. Only payments to legal persons (#expense-…) are itemised.
SELECT ?partija (ROUND(SUM(?value) / 100) / 10 AS ?tukst_eur)
WHERE
{
    GRAPH ?participantGraph
    {
        ?participant a ltlod:CampaignParticipant ;
            ltlod:inElection ?election .
        { ?participant ltlod:campaignOf ?party } UNION { ?participant ltlod:nominatedBy ?party }
        ?expense ltlod:payer ?participant ;
            a ltlod:CampaignExpense ;
            schema:value ?value .
    }
    FILTER(STRENDS(STR(?election), "/elections/seimas-2024/#this"))
    GRAPH ?partyGraph { ?party skos:prefLabel ?partija }
}
GROUP BY ?partija
ORDER BY DESC(?tukst_eur)
LIMIT 12""" .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
