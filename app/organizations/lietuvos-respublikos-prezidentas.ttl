@prefix cv:   <http://data.europa.eu/m8g/> .
@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The President of the Republic as an institution of state power (Constitution,
# art. 5): every office holder since 1990 is an org:Membership in it (etl/officials/),
# acting Presidents included. Static data, so it lives in scaffolding.
<> a dh:Item ;
    dct:title "Lietuvos Respublikos Prezidentas"@lt, "President of the Republic of Lithuania"@en ;
    foaf:primaryTopic <#this> .

<#this> a org:FormalOrganization, cv:PublicOrganisation ;
    skos:prefLabel "Lietuvos Respublikos Prezidentas"@lt, "President of the Republic of Lithuania"@en ;
    foaf:homepage <https://www.lrp.lt/> .
