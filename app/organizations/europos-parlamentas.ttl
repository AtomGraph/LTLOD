@prefix cv:   <http://data.europa.eu/m8g/> .
@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The European Parliament, as far as this dataspace is concerned: the MEPs elected in
# Lithuania are org:Memberships in it, one per mandate (etl/officials/, from the EP
# open data API). Static data, so it lives in scaffolding.
<> a dh:Item ;
    dct:title "Europos Parlamentas"@lt, "European Parliament"@en ;
    foaf:primaryTopic <#this> .

<#this> a org:FormalOrganization, cv:PublicOrganisation ;
    skos:prefLabel "Europos Parlamentas"@lt, "European Parliament"@en ;
    owl:sameAs <http://www.wikidata.org/entity/Q8889> ;
    foaf:homepage <https://www.europarl.europa.eu/> .
