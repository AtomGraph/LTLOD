@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a dh:Container ;
    dct:title "Seimo plenariniai posėdžiai"@lt ;
    rdf:_1 <#sittings-block> .

# Custom children listing instead of the stock ldh:ChildrenView, as in
# app/persons.ttl: the focus variable is the entity (#this), so its activity
# type and term become filter pills and its date the sort column (newest first).
# Sittings are eli-dl:Activity + schema:Event (sittings.rq). The 8 undated rows
# (scheduled, not yet held) have no eli-dl:activity_date and are left out here;
# they still list under their session.

<#sittings-block> a ldh:Object ;
    rdf:value <#sittings-view> .

<#sittings-view> a ldh:View ;
    dct:title "Seimo plenariniai posėdžiai"@lt, "Plenary sittings of the Seimas"@en ;
    spin:query <#sittings-query> ;
    ldh:showWhenEmpty false .

<#sittings-query> a sp:Select ;
    dct:title "Seimo plenariniai posėdžiai"@lt, "Plenary sittings of the Seimas"@en ;
    sp:text """
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX sioc:   <http://rdfs.org/sioc/ns#>
PREFIX schema: <https://schema.org/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>

SELECT DISTINCT ?sitting
WHERE
  { GRAPH ?graph
      { ?doc  sioc:has_container  $this ;
              foaf:primaryTopic   ?sitting .
        ?sitting  a                          schema:Event ;
                 eli-dl:had_activity_type   ?type ;
                 eli-dl:parliamentary_term  ?term ;
                 eli-dl:activity_date  ?date
      }
  }
ORDER BY DESC(?date)
""" .
