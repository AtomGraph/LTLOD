@prefix cv:   <http://data.europa.eu/m8g/> .
@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The Government: the Prime Minister and the ministers are its members
# (org:Membership in etl/officials/, role = their position-types concept). Static
# data, so it lives in scaffolding rather than ETL output, like the Seimas document.
<> a dh:Item ;
    dct:title "Lietuvos Respublikos Vyriausybė"@lt, "Government of the Republic of Lithuania"@en ;
    foaf:primaryTopic <#this> .

<#this> a org:FormalOrganization, cv:PublicOrganisation ;
    skos:prefLabel "Lietuvos Respublikos Vyriausybė"@lt, "Government of the Republic of Lithuania"@en ;
    owl:sameAs <http://www.wikidata.org/entity/Q277656> ;
    foaf:homepage <https://lrv.lt/> .
