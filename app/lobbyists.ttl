@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a dh:Container ;
    dct:title "Lobistai"@lt, "Lobbyists"@en ;
    rdf:_1 <#intro> ;
    rdf:_2 <#chart-active-block> ;
    rdf:_3 <#select-children> .

# rdf:_1 / rdf:_2 — intro + the most active lobbyists; rdf:_3 — the listing (LAST)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lede">VTEK lobistų sąrašas (SKAIDRIS): juridiniai ir fiziniai asmenys, įregistruoti vykdyti lobistinę veiklą, su sprendimo data ir numeriu. Juridinis asmuo susietas su Juridinių asmenų registru (pagal kodą), fizinis — su Seimo nariu, jei vardas ir pavardė vienareikšmiškai sutampa.</p>
        <p>Kas lobizmą vykdo aktyviausiai? Lobisto pateiktų skaidrumo deklaracijų ir jį deklaravusių pareigūnų deklaracijų skaičius.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-active-block> a ldh:Object ;
    rdf:value <#chart-active> .

<#chart-active> a ldh:ResultSetChart ;
    dct:title "Aktyviausi lobistai"@lt, "Most active lobbyists"@en ;
    spin:query <#chart-active-query> ;
    ldh:chartType ac:BarChart ;
    ldh:categoryVarName "lobistas" ;
    ldh:seriesVarName "deklaracijos" .

<#chart-active-query> a sp:Select ;
    dct:title "Lobistai pagal lobistinės veiklos deklaracijų skaičių"@lt, "Lobbyists by number of lobbying declarations"@en ;
    sp:text """PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT ?lobistas (COUNT(DISTINCT ?declaration) AS ?deklaracijos)
WHERE
{
    GRAPH ?declarationGraph { ?declaration a ltlod:LobbyingDeclaration ; ltlod:lobbyist ?lobbyist }
    GRAPH ?lobbyistGraph { ?lobbyist foaf:name ?lobistas }
}
GROUP BY ?lobbyist ?lobistas
ORDER BY DESC(?deklaracijos)
LIMIT 15""" .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
