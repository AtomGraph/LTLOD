@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a dh:Container ;
    dct:title "Kultūros paveldas"@lt, "Cultural heritage"@en ;
    rdf:_1 <#intro> ;
    rdf:_2 <#chart-status-block> .

# rdf:_1 / rdf:_2 — intro + objects by protection status. No children listing: 26k objects in
# title order answer nothing; they are reached by municipality and by kind, status, value and
# significance (see "Container listings" in CLAUDE.md)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lede">Nekilnojamosios kultūros vertybės iš Kultūros vertybių registro (KVR) — piliakalniai, bažnyčios, dvarai, kapinės, koplytstulpiai — su apsaugos statusu, reikšmingumo lygmeniu, vertingųjų savybių pobūdžiu, savivaldybe ir seniūnija; komplekso dalys susietos su kompleksu.</p>
        <p>Kultūros paveldo departamentas registro duomenis atvėrė kaip 2023 m. vasario 1 d. momentinę kopiją; koordinačių joje nėra.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-status-block> a ldh:Object ;
    rdf:value <#chart-status> .

<#chart-status> a ldh:ResultSetChart ;
    dct:title "Objektai pagal apsaugos statusą"@lt, "Objects by protection status"@en ;
    spin:query <#chart-status-query> ;
    ldh:chartType ac:BarChart ;
    ldh:categoryVarName "statusas" ;
    ldh:seriesVarName "objektai" .

<#chart-status-query> a sp:Select ;
    dct:title "Kultūros paveldo objektai pagal apsaugos statusą"@lt, "Cultural heritage objects by protection status"@en ;
    sp:text """PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT ?statusas (COUNT(DISTINCT ?object) AS ?objektai)
WHERE
{
    GRAPH ?objectGraph { ?object ltlod:protectionStatus ?status }
    GRAPH ?statusGraph { ?status skos:prefLabel ?statusas }
}
GROUP BY ?statusas
ORDER BY DESC(?objektai)""" .
