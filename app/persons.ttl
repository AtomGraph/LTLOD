@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a dh:Container ;
    dct:title "Asmenys"@lt, "Persons"@en ;
    rdf:_1 <#intro> ;
    rdf:_2 <#chart-women-block> ;
    rdf:_3 <#persons-block> .

# rdf:_1 / rdf:_2 — intro + the share of women per Seimas term (persons x terms)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lede">Visi asmenys, nuo 1990 m. turėję Seimo nario mandatą: jų kadencijos, frakcijos, komitetai, juos iškėlusios partijos, rinkimų apygardos, balsavimai ir turto deklaracijos.</p>
        <p>Kiek moterų buvo kiekvienos kadencijos Seime? Skaičiuojami visi kadencijos metu mandatą turėję asmenys, įskaitant pakeitusius išėjusius narius.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-women-block> a ldh:Object ;
    rdf:value <#chart-women> .

<#chart-women> a ldh:ResultSetChart ;
    dct:title "Moterų dalis Seime"@lt, "Share of women in the Seimas"@en ;
    spin:query <#chart-women-query> ;
    ldh:chartType ac:LineChart ;
    ldh:categoryVarName "kadencija" ;
    ldh:seriesVarName "moterys_proc" .

<#chart-women-query> a sp:Select ;
    dct:title "Moterų dalis pagal kadenciją"@lt, "Share of women per term"@en ;
    sp:text """PREFIX epvoc: <https://data.europarl.europa.eu/def/epvoc#>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX time:  <http://www.w3.org/2006/time#>

# Everyone who held a seat during the term (epvoc:memberDuringParliamentaryTerm is on the
# Seimas seat memberships only), as a percentage with one decimal; ordered by term start.
SELECT ?kadencija (ROUND(1000 * SUM(?female) / COUNT(?person)) / 10 AS ?moterys_proc)
WHERE
{
    {
        SELECT DISTINCT ?term ?person ?gender
        WHERE
        {
            GRAPH ?personGraph
            {
                ?membership epvoc:memberDuringParliamentaryTerm ?term ;
                    org:member ?person .
                ?person foaf:gender ?gender .
            }
        }
    }
    BIND(IF(?gender = "female", 1, 0) AS ?female)
    GRAPH ?termGraph
    {
        ?term skos:prefLabel ?label ;
            time:hasTime/time:hasBeginning/time:inXSDDate ?start .
    }
    BIND(REPLACE(STR(?label), " metų kadencija", "") AS ?kadencija)
}
GROUP BY ?start ?kadencija
ORDER BY ?start""" .

# Custom children listing instead of the stock ldh:ChildrenView. LDH derives the
# view's filter pills and sort options from the BGP triples whose SUBJECT is the
# query's FIRST projected variable and whose OBJECT is a variable (see the
# "View filter/sort columns" note in CLAUDE.md) — so the focus variable has to be
# the person entity (?person = {doc}#this), not the document, because that is
# where foaf:givenName / foaf:familyName / foaf:gender / ltlod:nominatedBy sit.
# The stock ChildrenView projects the document (?child) and therefore offers no
# person columns at all.
#
# Filter pills need the ldh:bgp-value-counts override in files/client.xsl to be
# usable here: the label lookup LDH appends to the facet-value query uses an
# alternative property path, which ARQ does not index inside a GRAPH block (~104 s
# per pill over this dataspace's ~117k graphs). The override rewrites it to a
# variable predicate + FILTER IN, so a pill loads in ~0.1 s.

<#persons-block> a ldh:Object ;
    rdf:value <#persons-view> .

<#persons-view> a ldh:View ;
    dct:title "Seimo nariai"@lt, "Members of the Seimas"@en ;
    spin:query <#persons-query> ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false .

# dct:title (not just rdfs:label) is mandatory on sp:Select — LDH enforces
# def:MissingTitle as a SPIN constraint and rejects the PUT with 422 otherwise.
<#persons-query> a sp:Select ;
    dct:title "Seimo nariai"@lt, "Members of the Seimas"@en ;
    sp:text """
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX sioc:  <http://rdfs.org/sioc/ns#>
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?doc  sioc:has_container  $this ;
              foaf:primaryTopic   ?person .
        ?person  a                  foaf:Person ;
                 foaf:givenName     ?givenName ;
                 foaf:familyName    ?familyName ;
                 foaf:gender        ?gender ;
                 ltlod:nominatedBy  ?party
      }
  }
ORDER BY ?familyName ?givenName
""" .
