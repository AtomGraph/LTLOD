@prefix dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix ldh:  <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:   <https://w3id.org/atomgraph/client#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sp:   <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .

<> a dh:Container ;
    dct:title "Sveikatos priežiūros įstaigos"@lt, "Health-care institutions"@en ;
    rdf:_1 <#intro> ;
    rdf:_2 <#chart-licences-block> ;
    rdf:_3 <#select-children> .

# rdf:_1 / rdf:_2 — intro + licences issued per year; rdf:_3 — the listing (LAST)

<#intro> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
        <p class="lede">Asmens sveikatos priežiūros įstaigos, turinčios Valstybinės akreditavimo sveikatos priežiūros veiklai tarnybos (VASPVT) licenciją — ligoninės, poliklinikos, odontologijos klinikos, laboratorijos — su licencija, teisine forma ir veiklos adresais savivaldybėse.</p>
        <p>Kiekviena įstaiga susieta su juridiniu asmeniu pagal įmonės kodą. Grafikas rodo, kiek dabar galiojančių licencijų išduota kiekvienais metais.</p>
    </div>"""^^rdf:XMLLiteral .

<#chart-licences-block> a ldh:Object ;
    rdf:value <#chart-licences> .

<#chart-licences> a ldh:ResultSetChart ;
    dct:title "Išduotos licencijos"@lt, "Licences issued"@en ;
    spin:query <#chart-licences-query> ;
    ldh:chartType ac:LineChart ;
    ldh:categoryVarName "metai" ;
    ldh:seriesVarName "licencijos" .

<#chart-licences-query> a sp:Select ;
    dct:title "Galiojančios licencijos pagal išdavimo metus"@lt, "Valid licences by year of issue"@en ;
    sp:text """PREFIX schema: <https://schema.org/>

# The year is a string so the chart draws it as a category axis.
SELECT ?metai (COUNT(DISTINCT ?licence) AS ?licencijos)
WHERE
{
    GRAPH ?graph
    {
        ?licence a schema:Permit ;
            schema:validFrom ?date .
    }
    BIND(YEAR(?date) AS ?year)
    BIND(STR(?year) AS ?metai)
}
GROUP BY ?year ?metai
ORDER BY ?year""" .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
