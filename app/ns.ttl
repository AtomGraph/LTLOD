# LTLOD namespace ontology — the LinkedDataHub app ontology served at {base}ns.
# app/import-ns.sh installs it with `ldh admin import ontology --file`, which
# parses it against the ontology IRI ({base}ns#), so the : prefix (<#>) resolves
# to the end-user namespace.
#
# Domains and ranges describe the instance data (and, for ELI-DL, follow its
# hierarchy: Vote ⊑ Decision ⊑ Activity). A domain spanning several classes is an
# owl:unionOf; a range on a property with an ldh:inverseView stays a plain list
# (below). Generic properties used on many types (dct:title, skos:prefLabel,
# owl:sameAs, foaf:depiction, …) carry no domain.
#
# 1:N views: <property> ldh:inverseView <View> surfaces the View block on every
# instance whose rdf:type matches the property's declared rdfs:range; LDH
# replaces $about in the sp:text query with the instance URI at render time.
# Multiple rdfs:range values are LDH view-discovery metadata, not strict OWL
# semantics (same approach as the northwind-traders demo app).
#
# ac:mode picks the layout LDH renders the projected entities with (ac:ListMode
# default, else Table/Grid/Map/…). Admin units carry WGS84 geo:lat/geo:long (from
# the AR-spatial *-geo.trig), so :SubUnits uses ac:MapMode — LDH plots each unit as
# a map marker (RDFXML2GeoJSON keys on geo:lat+geo:long) or a gsp:asWKT shape, so
# its query only selects units carrying either (anything else can't be plotted).
# Views that project image-bearing persons (foaf:depiction portraits from lrs.lt)
# use ac:GridMode so LDH lays them out as a thumbnail grid (ac:Grid →
# foaf:depiction per card). Imageless targets (Seimas org-units) keep the default list.
#
# Filter/sort columns: LDH turns the BGP triples whose subject is the query's
# FIRST projected variable — and whose object is a variable — into the view's
# facet pills and sort-dropdown options. Those variables stay UNPROJECTED: LDH
# wraps the SELECT into DESCRIBE *, so anything else in the projection would be
# rendered as its own card. So the person views (:CurrentMembers, :FormerMembers,
# :NominatedMembers, :MembersElectedHere, and the persons/ container view in
# app/persons.ttl) project ?person alone and carry foaf:givenName /
# foaf:familyName / foaf:gender — plus ltlod:nominatedBy wherever the party is not
# already pinned by $about — then ORDER BY family, given name (the first ORDER BY
# condition is the initial sort, the second the tie-breaker). Facet and sort
# labels resolve against the property labels below, so a column predicate without
# an rdfs:label here degrades to its local name.
#
# Those pills only work because files/client.xsl overrides LDH's
# ldh:bgp-value-counts label lookup: its alternative property path is not indexed
# by ARQ inside a GRAPH block and scans all ~117k named graphs (~104 s per pill);
# rewritten to a variable predicate + FILTER IN it is ~0.1 s. Keep the GRAPH ?graph
# form in these queries — the override, not the query shape, is what pays for it.

@prefix :       <#> .
@prefix ldh:    <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:     <https://w3id.org/atomgraph/client#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix sp:     <http://spinrdf.org/sp#> .
@prefix spin:   <http://spinrdf.org/spin#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix cv:     <http://data.europa.eu/m8g/> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix locn:   <http://www.w3.org/ns/locn#> .
@prefix ltlod:  <http://linkeddata.lt/ns#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rov:    <http://www.w3.org/ns/regorg#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dh:     <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#> .
@prefix epvoc:  <https://data.europarl.europa.eu/def/epvoc#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix qb:     <http://purl.org/linked-data/cube#> .
@prefix gsp:    <http://www.opengis.net/ont/geosparql#> .
@prefix epo:    <http://data.europa.eu/a4g/ontology#> .
@prefix qb:     <http://purl.org/linked-data/cube#> .
@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .

: a owl:Ontology ;
    rdfs:label "LTLOD namespace" .

# classes

cv:AdminUnit a owl:Class ;
    rdfs:label "Administracinis vienetas"@lt, "Administrative unit"@en ;
    rdfs:isDefinedBy : .

cv:PublicOrganisation a owl:Class ;
    rdfs:label "Viešojo sektoriaus organizacija"@lt, "Public organisation"@en ;
    rdfs:isDefinedBy : .

org:OrganizationalUnit a owl:Class ;
    rdfs:label "Padalinys"@lt, "Organizational unit"@en ;
    rdfs:isDefinedBy : .

schema:PoliticalParty a owl:Class ;
    rdfs:label "Politinė partija"@lt, "Political party"@en ;
    rdfs:isDefinedBy : .

foaf:Person a owl:Class ;
    rdfs:label "Asmuo"@lt, "Person"@en ;
    rdfs:isDefinedBy : .

ltlod:ElectoralDistrict a owl:Class ;
    rdfs:label "Rinkimų apygarda"@lt, "Electoral district"@en ;
    rdfs:isDefinedBy : .

# VMI annual property declarations (etl/declarations/): one per person and reporting
# year, its non-zero amounts as schema:MonetaryAmount fragments
ltlod:AssetDeclaration a owl:Class ;
    rdfs:label "Turto deklaracija"@lt, "Property declaration"@en ;
    rdfs:isDefinedBy : .

# NŽT land-acquisition applications (etl/land-acquisitions/)
ltlod:LandAcquisitionApplication a owl:Class ;
    rdfs:label "Prašymas įsigyti žemės"@lt, "Land acquisition application"@en ;
    rdfs:isDefinedBy : .

ltlod:LandAcquisitionDecision a owl:Class ;
    rdfs:label "NŽT sprendimas"@lt, "NŽT decision"@en ;
    rdfs:isDefinedBy : .

ltlod:applicant a owl:ObjectProperty ;
    rdfs:label "Pareiškėjas"@lt, "Applicant"@en ;
    rdfs:domain ltlod:LandAcquisitionApplication ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :LandApplications ;
    rdfs:isDefinedBy : .

# the land's municipality; schema:location rather than locn:adminUnit or dct:spatial, which
# carry other views (one property per view)
schema:location a owl:ObjectProperty ;
    rdfs:label "Savivaldybė"@lt, "Municipality"@en ;
    rdfs:domain ltlod:LandAcquisitionApplication ;
    rdfs:range cv:AdminUnit ;
    ldh:inverseView :MunicipalityLandApplications ;
    rdfs:isDefinedBy : .

ltlod:applicantCheck a owl:ObjectProperty ;
    rdfs:label "Pareiškėjo kodo patikra"@lt, "Applicant code check"@en ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy : .

ltlod:applicantCode a owl:DatatypeProperty ;
    rdfs:label "Pareiškėjo kodas (kaip skelbia NŽT)"@lt, "Applicant code (as published by NŽT)"@en ;
    rdfs:isDefinedBy : .

ltlod:applicantName a owl:DatatypeProperty ;
    rdfs:label "Pareiškėjo pavadinimas (kaip skelbia NŽT)"@lt, "Applicant name (as published by NŽT)"@en ;
    rdfs:isDefinedBy : .

ltlod:representation a owl:DatatypeProperty ;
    rdfs:label "Atstovavimas"@lt, "Representation"@en ;
    rdfs:isDefinedBy : .

ltlod:appliedArea a owl:DatatypeProperty ;
    rdfs:label "Prašomas plotas, ha"@lt, "Area applied for, ha"@en ;
    rdfs:isDefinedBy : .

ltlod:heldArea a owl:DatatypeProperty ;
    rdfs:label "Valdomas plotas prieš įsigyjant, ha"@lt, "Area held before, ha"@en ;
    rdfs:isDefinedBy : .

ltlod:heldAreaAfter a owl:DatatypeProperty ;
    rdfs:label "Valdomas plotas įsigijus, ha"@lt, "Area held after, ha"@en ;
    rdfs:isDefinedBy : .

ltlod:decision a owl:ObjectProperty ;
    rdfs:label "Sprendimas"@lt, "Decision"@en ;
    rdfs:domain ltlod:LandAcquisitionApplication ;
    rdfs:range ltlod:LandAcquisitionDecision ;
    rdfs:isDefinedBy : .

ltlod:applicationCount a owl:DatatypeProperty ;
    rdfs:label "Prašymų"@lt, "Applications"@en ;
    rdfs:isDefinedBy : .

ltlod:consentCount a owl:DatatypeProperty ;
    rdfs:label "Sutikimų"@lt, "Consents"@en ;
    rdfs:isDefinedBy : .

ltlod:refusalCount a owl:DatatypeProperty ;
    rdfs:label "Atmesta"@lt, "Refused"@en ;
    rdfs:isDefinedBy : .

ltlod:consentedArea a owl:DatatypeProperty ;
    rdfs:label "Leistas įsigyti plotas, ha"@lt, "Area consented, ha"@en ;
    rdfs:isDefinedBy : .

schema:MonetaryAmount a owl:Class ;
    rdfs:label "Pinigų suma"@lt, "Monetary amount"@en ;
    rdfs:isDefinedBy : .

# Sodra employer data (etl/sodra/): one qb:Observation per employer
# (employment/{ja_kodas}/#this: latest month + window aggregates) in the employment/dataset/
# qb:DataSet; with SODRA_CUBE=1 also #{yyyy-mm} monthly observations (dataset/#monthly)
qb:DataSet a owl:Class ;
    rdfs:label "Statistinių duomenų rinkinys"@lt, "Statistical dataset"@en ;
    rdfs:isDefinedBy : .

qb:Observation a owl:Class ;
    rdfs:label "Stebėjimas"@lt, "Observation"@en ;
    rdfs:isDefinedBy : .

# VTEK registers (etl/vtek/): the lobbying register SKAIDRIS (lobbyists and their /
# officials' declarations, each lobbied person or institution a contact fragment) and
# the private-interest register PINREG (declarations whose ties are org:Membership)
ltlod:Lobbyist a owl:Class ;
    rdfs:label "Lobistas"@lt, "Lobbyist"@en ;
    rdfs:subClassOf foaf:Agent ;
    rdfs:isDefinedBy : .

ltlod:LobbyingDeclaration a owl:Class ;
    rdfs:label "Lobistinės veiklos deklaracija"@lt, "Lobbying declaration"@en ;
    rdfs:isDefinedBy : .

ltlod:TransparencyDeclaration a owl:Class ;
    rdfs:label "Lobisto skaidrumo deklaracija"@lt, "Lobbyist transparency declaration"@en ;
    rdfs:subClassOf ltlod:LobbyingDeclaration ;
    rdfs:isDefinedBy : .

ltlod:InfluenceDeclaration a owl:Class ;
    rdfs:label "Asmens, patyrusio lobistinę įtaką, deklaracija"@lt, "Declaration of experienced lobbying influence"@en ;
    rdfs:subClassOf ltlod:LobbyingDeclaration ;
    rdfs:isDefinedBy : .

ltlod:LobbyingContact a owl:Class ;
    rdfs:label "Paveiktas asmuo ar institucija"@lt, "Lobbied person or institution"@en ;
    rdfs:isDefinedBy : .

ltlod:InterestDeclaration a owl:Class ;
    rdfs:label "Privačių interesų deklaracija"@lt, "Private interest declaration"@en ;
    rdfs:isDefinedBy : .

# Seimas election results (etl/elections/): an election (elections/) and its voting
# days, the contest in each single-member constituency (election-results/) with its
# rounds, candidate results and the party-list vote counted there. No W3C or EU
# vocabulary models elections (ONTOLOGY-NOTES.md), so these are ltlod: classes,
# schema:Event where they are events.
ltlod:Election a owl:Class ;
    rdfs:label "Rinkimai"@lt, "Election"@en ;
    rdfs:subClassOf schema:Event ;
    rdfs:isDefinedBy : .

ltlod:ElectionRound a owl:Class ;
    rdfs:label "Rinkimų turas"@lt, "Election round"@en ;
    rdfs:subClassOf schema:Event ;
    rdfs:isDefinedBy : .

ltlod:ConstituencyContest a owl:Class ;
    rdfs:label "Rinkimai apygardoje"@lt, "Constituency contest"@en ;
    rdfs:isDefinedBy : .

ltlod:ContestRound a owl:Class ;
    rdfs:label "Turas apygardoje"@lt, "Contest round"@en ;
    rdfs:isDefinedBy : .

ltlod:CandidateResult a owl:Class ;
    rdfs:label "Kandidato rezultatas"@lt, "Candidate result"@en ;
    rdfs:isDefinedBy : .

ltlod:PartyListResult a owl:Class ;
    rdfs:label "Sąrašo rezultatas apygardoje"@lt, "Party-list result"@en ;
    rdfs:isDefinedBy : .

# VRK political campaign finance (etl/elections/, campaign-finance/): a campaign
# participant (candidate, party, list, … in one campaign) with its income from legal
# persons one by one, from natural persons aggregated per funding source, and its
# expenses (legal-person providers one by one, natural persons aggregated).
ltlod:CampaignParticipant a owl:Class ;
    rdfs:label "Politinės kampanijos dalyvis"@lt, "Campaign participant"@en ;
    rdfs:isDefinedBy : .

ltlod:CampaignDonation a owl:Class ;
    rdfs:label "Juridinio asmens įnašas į kampaniją"@lt, "Campaign income from a legal person"@en ;
    rdfs:isDefinedBy : .

ltlod:CampaignIncomeTotal a owl:Class ;
    rdfs:label "Fizinių asmenų įnašų suma"@lt, "Campaign income from natural persons (total)"@en ;
    rdfs:isDefinedBy : .

ltlod:CampaignExpense a owl:Class ;
    rdfs:label "Kampanijos išlaida"@lt, "Campaign expense"@en ;
    rdfs:isDefinedBy : .

ltlod:CampaignExpenseTotal a owl:Class ;
    rdfs:label "Išlaidų fiziniams asmenims suma"@lt, "Campaign expenses to natural persons (total)"@en ;
    rdfs:isDefinedBy : .

# Seimas calendar (terms.rq / sessions.rq / sittings.rq). Sessions and sittings
# are both eli-dl:Activity; the schema.org second type is what the views below
# target, since LDH matches rdfs:range against rdf:type exactly.
eli-dl:ParliamentaryTerm a owl:Class ;
    rdfs:label "Seimo kadencija"@lt, "Parliamentary term"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy : .

eli-dl:Activity a owl:Class ;
    rdfs:label "Veikla"@lt, "Activity"@en ;
    rdfs:isDefinedBy : .

eli-dl:ActivityType a owl:Class ;
    rdfs:label "Veiklos tipas"@lt, "Activity type"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy : .

schema:EventSeries a owl:Class ;
    rdfs:label "Sesija"@lt, "Session"@en ;
    rdfs:isDefinedBy : .

schema:Event a owl:Class ;
    rdfs:label "Posėdis"@lt, "Sitting"@en ;
    rdfs:isDefinedBy : .

# Seimas plenary votes (votes.rq) and their voting method concepts
eli-dl:Decision a owl:Class ;
    rdfs:label "Sprendimas"@lt, "Decision"@en ;
    rdfs:subClassOf eli-dl:Activity ;
    rdfs:isDefinedBy : .

eli-dl:Vote a owl:Class ;
    rdfs:label "Balsavimas"@lt, "Vote"@en ;
    rdfs:subClassOf eli-dl:Decision ;
    rdfs:isDefinedBy : .

eli-dl:DecisionMethod a owl:Class ;
    rdfs:label "Balsavimo būdas"@lt, "Decision method"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy : .

# Seimas bills (bills.rq) and the stages agenda items are considered at
# (agenda-items.rq; the items themselves are plain eli-dl:Activity)
eli-dl:DraftLegislationWork a owl:Class ;
    rdfs:label "Teisės akto projektas"@lt, "Bill"@en ;
    rdfs:isDefinedBy : .

eli-dl:ProcessStage a owl:Class ;
    rdfs:label "Svarstymo stadija"@lt, "Stage"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy : .

# Seimas positions and seats (persons.rq): n-ary memberships and their periods
org:Membership a owl:Class ;
    rdfs:label "Narystė"@lt, "Membership"@en ;
    rdfs:isDefinedBy : .

time:Interval a owl:Class ;
    rdfs:label "Laikotarpis"@lt, "Interval"@en ;
    rdfs:isDefinedBy : .

time:Instant a owl:Class ;
    rdfs:label "Laiko momentas"@lt, "Instant"@en ;
    rdfs:isDefinedBy : .

# Calendar (etl/calendar/calendar.rq): every year, month and day document's
# entity is both a time:DateTimeInterval and a dct:PeriodOfTime (the range of
# dct:temporal); the views below target them by those exact types.
time:DateTimeInterval a owl:Class ;
    rdfs:label "Kalendorinis laikotarpis"@lt, "Calendar interval"@en ;
    rdfs:isDefinedBy : .

dct:PeriodOfTime a owl:Class ;
    rdfs:label "Laikotarpis"@lt, "Period of time"@en ;
    rdfs:isDefinedBy : .

time:DateTimeDescription a owl:Class ;
    rdfs:label "Datos aprašas"@lt, "Date-time description"@en ;
    rdfs:isDefinedBy : .

# Remaining classes used as rdf:type on data — labelled here (single source of
# truth) so files/overrides.xsl can surface them on the type badges. LDH does not
# consult this ontology for rdf:type objects on its own (only for predicates), so
# the badge localisation is bridged in XSLT — but the label text lives here.

org:FormalOrganization a owl:Class ;
    rdfs:label "Formalioji organizacija"@lt, "Formal organization"@en ;
    rdfs:isDefinedBy : .

rov:RegisteredOrganization a owl:Class ;
    rdfs:label "Registruotas juridinis asmuo"@lt, "Registered organization"@en ;
    rdfs:isDefinedBy : .

epo:Contract a owl:Class ;
    rdfs:label "Viešojo pirkimo sutartis"@lt, "Public procurement contract"@en ;
    rdfs:isDefinedBy : .

epo:Buyer a owl:Class ;
    rdfs:label "Perkančioji organizacija"@lt, "Buyer"@en ;
    rdfs:isDefinedBy : .

epo:Contractor a owl:Class ;
    rdfs:label "Tiekėjas"@lt, "Contractor"@en ;
    rdfs:isDefinedBy : .

epo:MonetaryValue a owl:Class ;
    rdfs:label "Piniginė vertė"@lt, "Monetary value"@en ;
    rdfs:isDefinedBy : .

epo:Purpose a owl:Class ;
    rdfs:label "Pirkimo objektas"@lt, "Purpose"@en ;
    rdfs:isDefinedBy : .

org:Site a owl:Class ;
    rdfs:label "Buveinė"@lt, "Site"@en ;
    rdfs:isDefinedBy : .

# Facility registers (etl/facilities/): ŠVIS education institutions, VASPVT licensed
# health-care institutions (+ their licence, schema:Permit), KVR immovable heritage.
schema:EducationalOrganization a owl:Class ;
    rdfs:label "Švietimo įstaiga"@lt, "Educational organization"@en ;
    rdfs:isDefinedBy : .

schema:MedicalOrganization a owl:Class ;
    rdfs:label "Sveikatos priežiūros įstaiga"@lt, "Medical organization"@en ;
    rdfs:isDefinedBy : .

schema:Permit a owl:Class ;
    rdfs:label "Licencija"@lt, "Permit"@en ;
    rdfs:isDefinedBy : .

schema:LandmarksOrHistoricalBuildings a owl:Class ;
    rdfs:label "Kultūros paveldo objektas"@lt, "Cultural heritage object"@en ;
    rdfs:isDefinedBy : .

locn:Address a owl:Class ;
    rdfs:label "Adresas"@lt, "Address"@en ;
    rdfs:isDefinedBy : .

dct:Location a owl:Class ;
    rdfs:label "Vietovė"@lt, "Location"@en ;
    rdfs:isDefinedBy : .

skos:Concept a owl:Class ;
    rdfs:label "Sąvoka"@lt, "Concept"@en ;
    rdfs:isDefinedBy : .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Sąvokų schema"@lt, "Concept scheme"@en ;
    rdfs:isDefinedBy : .

dh:Item a owl:Class ;
    rdfs:label "Dokumentas"@lt, "Document"@en ;
    rdfs:isDefinedBy : .

dh:Container a owl:Class ;
    rdfs:label "Katalogas"@lt, "Container"@en ;
    rdfs:isDefinedBy : .

# properties

dct:isPartOf a owl:ObjectProperty ;
    rdfs:label "Priklauso vienetui"@lt, "Is part of"@en ;
    rdfs:domain [ owl:unionOf ( cv:AdminUnit dct:Location ) ] ;
    rdfs:range cv:AdminUnit ;
    ldh:inverseView :SubUnits ;
    rdfs:isDefinedBy : .

# A registered office's address points at its municipality and settlement
# (locn:Address -> locn:adminUnit -> admin-units/{sav|gyv}/#this); the inverse view
# lists the organizations registered in a given admin unit (legal-entities.rq).
# Facility addresses (etl/facilities/) point at their municipality, eldership and
# settlement the same way and carry their own views (schools, health care, heritage).
locn:adminUnit a owl:ObjectProperty ;
    rdfs:label "Administracinis vienetas"@lt, "Administrative unit"@en ;
    rdfs:domain locn:Address ;
    rdfs:range cv:AdminUnit ;
    ldh:inverseView :OrganizationsHere, :EducationHere, :HealthCareHere, :HeritageHere ;
    rdfs:isDefinedBy : .

# ... and at its street (locn:Address -> dct:spatial -> streets/{gat}/#this; LOCN's
# own locn:thoroughfare is a literal); the inverse view lists the organizations
# registered on a given street.
dct:spatial a owl:ObjectProperty ;
    rdfs:label "Gatvė"@lt, "Street"@en ;
    rdfs:domain locn:Address ;
    rdfs:range dct:Location ;
    ldh:inverseView :OrganizationsOnStreet ;
    rdfs:isDefinedBy : .

org:organization a owl:ObjectProperty ;
    rdfs:label "Organizacija"@lt, "Organization"@en ;
    rdfs:domain org:Membership ;
    # cv:AdminUnit: a mayor's office is a membership in their municipality (etl/officials/)
    rdfs:range org:OrganizationalUnit, cv:PublicOrganisation, cv:AdminUnit ;
    ldh:inverseView :CurrentMembers, :FormerMembers, :Officeholders ;
    rdfs:isDefinedBy : .

org:unitOf a owl:ObjectProperty ;
    rdfs:label "Padalinys organizacijoje"@lt, "Unit of"@en ;
    rdfs:domain org:OrganizationalUnit ;
    rdfs:range cv:PublicOrganisation ;
    ldh:inverseView :Units ;
    rdfs:isDefinedBy : .

# On the tenure (Seimas seat) membership: the party that nominated them for that
# term — what per-term queries must use. On the person: every party that
# nominated them in any term, the facet column of the person views (LDH facets
# only on triples of the projected ?person).
ltlod:nominatedBy a owl:ObjectProperty ;
    rdfs:label "Iškelta partijos"@lt, "Nominated by"@en ;
    rdfs:domain [ owl:unionOf ( org:Membership foaf:Person ltlod:CandidateResult ltlod:CampaignParticipant ) ] ;
    rdfs:range schema:PoliticalParty ;
    ldh:inverseView :NominatedMembers ;
    rdfs:isDefinedBy : .

# A single-member seat (org:Membership tenure) points at its electoral district;
# the inverse view lists the members elected in a given apygarda (persons.rq).
ltlod:electoralDistrict a owl:ObjectProperty ;
    rdfs:label "Rinkimų apygarda"@lt, "Electoral district"@en ;
    rdfs:domain org:Membership ;
    rdfs:range ltlod:ElectoralDistrict ;
    ldh:inverseView :MembersElectedHere ;
    rdfs:isDefinedBy : .

# A property declaration -> its declarant; the inverse view lists a person's
# declarations by year. A subproperty rather than dct:creator itself: views attach per
# property and range, and dct:creator is reused loosely (LDH's own documents carry it),
# so the relationship gets its own term. dct:creator stays range-less here — LDH's view
# discovery follows rdfs:subPropertyOf+/rdfs:range, so a range on it would leak this
# view onto that type too. The data carries only ltlod:declarant (dct:creator is
# entailed by the subproperty axiom).
ltlod:declarant a owl:ObjectProperty ;
    rdfs:label "Deklaravo"@lt, "Declarant"@en ;
    rdfs:subPropertyOf dct:creator ;
    rdfs:domain [ owl:unionOf ( ltlod:AssetDeclaration ltlod:InterestDeclaration ) ] ;
    rdfs:range foaf:Person ;
    ldh:inverseView :PersonDeclarations ;
    rdfs:isDefinedBy : .

ltlod:declaredValue a owl:ObjectProperty ;
    rdfs:label "Deklaruota suma"@lt, "Declared amount"@en ;
    rdfs:domain ltlod:AssetDeclaration ;
    rdfs:range schema:MonetaryAmount ;
    rdfs:isDefinedBy : .

# VTEK lobbying (etl/vtek/mappings/lobbying.rq, lobbyists.rq). Each link that needs a
# view on its target gets its own property (views attach per property and range).

# declaration -> lobbyist; the view lists a lobbyist's declarations
ltlod:lobbyist a owl:ObjectProperty ;
    rdfs:label "Lobistas"@lt, "Lobbyist"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:range ltlod:Lobbyist ;
    ldh:inverseView :LobbyistDeclarations ;
    rdfs:isDefinedBy : .

# lobbyist -> the same agent elsewhere: a legal person's legal entity (JAR), a natural
# person's persons/ entry (a former official now lobbying). A subproperty of owl:sameAs
# so it can carry its own view (owl:sameAs is used everywhere and stays view-less); the
# view shows the lobbyist registration on the company or person page.
ltlod:agent a owl:ObjectProperty ;
    rdfs:label "Registruotas lobistu"@lt, "Registered as lobbyist"@en ;
    rdfs:subPropertyOf owl:sameAs ;
    rdfs:domain ltlod:Lobbyist ;
    rdfs:range rov:RegisteredOrganization, foaf:Person ;
    ldh:inverseView :AgentLobbyistRegistrations ;
    rdfs:isDefinedBy : .

ltlod:contact a owl:ObjectProperty ;
    rdfs:label "Paveiktas asmuo ar institucija"@lt, "Lobbied person or institution"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:range ltlod:LobbyingContact ;
    rdfs:isDefinedBy : .

# contact -> a lobbied official (resolved by unique name); the view lists the lobbying
# declarations that name the person
ltlod:influencedPerson a owl:ObjectProperty ;
    rdfs:label "Paveiktas asmuo"@lt, "Influenced person"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:range foaf:Person ;
    ldh:inverseView :PersonLobbiedBy ;
    rdfs:isDefinedBy : .

# contact -> a lobbied institution: a legal entity, the Seimas or a Seimas committee
ltlod:institution a owl:ObjectProperty ;
    rdfs:label "Institucija"@lt, "Institution"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:range rov:RegisteredOrganization, cv:PublicOrganisation, org:OrganizationalUnit ;
    ldh:inverseView :InstitutionLobbiedBy ;
    rdfs:isDefinedBy : .

# declaration -> a Seimas bill cited in it (organizations/…/bills/{number}/, etl/seimas)
ltlod:draftAct a owl:ObjectProperty ;
    rdfs:label "Teisės akto projektas"@lt, "Draft act"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:range eli-dl:DraftLegislationWork ;
    ldh:inverseView :DraftActLobbying ;
    rdfs:isDefinedBy : .

ltlod:counterpartDeclaration a owl:ObjectProperty ;
    rdfs:label "Paveikto asmens deklaracija"@lt, "Counterpart declaration"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:range ltlod:LobbyingDeclaration ;
    rdfs:isDefinedBy : .

ltlod:clientName a owl:DatatypeProperty ;
    rdfs:label "Užsakovas"@lt, "Client"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:isDefinedBy : .

ltlod:beneficiaryName a owl:DatatypeProperty ;
    rdfs:label "Naudos gavėjas"@lt, "Beneficiary"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:isDefinedBy : .

ltlod:legislationName a owl:DatatypeProperty ;
    rdfs:label "Teisės aktas"@lt, "Legislation"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:isDefinedBy : .

ltlod:activityDate a owl:DatatypeProperty ;
    rdfs:label "Lobistinės veiklos data"@lt, "Lobbying date"@en ;
    rdfs:domain ltlod:LobbyingDeclaration ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

ltlod:contactName a owl:DatatypeProperty ;
    rdfs:label "Vardas, pavardė"@lt, "Name"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:isDefinedBy : .

ltlod:occupation a owl:DatatypeProperty ;
    rdfs:label "Pareigos"@lt, "Occupation"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:isDefinedBy : .

ltlod:institutionName a owl:DatatypeProperty ;
    rdfs:label "Institucija (kaip nurodyta)"@lt, "Institution (as given)"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:isDefinedBy : .

ltlod:influenceMode a owl:DatatypeProperty ;
    rdfs:label "Įtakos būdas"@lt, "Influence mode"@en ;
    rdfs:domain ltlod:LobbyingContact ;
    rdfs:isDefinedBy : .

ltlod:registrationDecision a owl:DatatypeProperty ;
    rdfs:label "Įrašymo į sąrašą sprendimas"@lt, "Registration decision"@en ;
    rdfs:domain ltlod:Lobbyist ;
    rdfs:isDefinedBy : .

ltlod:registrationDate a owl:DatatypeProperty ;
    rdfs:label "Įrašymo į sąrašą data"@lt, "Registration date"@en ;
    rdfs:domain ltlod:Lobbyist ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

# ACTIVE / BLOCKED as in the register; UNLISTED = cited by declarations but no longer listed
ltlod:registerStatus a owl:DatatypeProperty ;
    rdfs:label "Būsena sąraše"@lt, "Register status"@en ;
    rdfs:domain ltlod:Lobbyist ;
    rdfs:isDefinedBy : .

# VTEK private interests (etl/vtek/mappings/interests.rq). A tie is an org:Membership
# (so it joins the person's memberships table); these two subproperties carry the views
# the generic ORG properties cannot (org:organization already carries :CurrentMembers).

# tie -> the legal entity; the view lists the officials who declared a tie to it
ltlod:interestOrganization a owl:ObjectProperty ;
    rdfs:label "Juridinis asmuo"@lt, "Legal entity"@en ;
    rdfs:subPropertyOf org:organization ;
    rdfs:domain org:Membership ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :InterestedOfficials ;
    rdfs:isDefinedBy : .

# tie -> its declaration; the view tabulates the declaration's ties
ltlod:declaredIn a owl:ObjectProperty ;
    rdfs:label "Deklaruota"@lt, "Declared in"@en ;
    rdfs:domain org:Membership ;
    rdfs:range ltlod:InterestDeclaration ;
    ldh:inverseView :DeclaredTies ;
    rdfs:isDefinedBy : .

ltlod:organizationName a owl:DatatypeProperty ;
    rdfs:label "Juridinio asmens pavadinimas"@lt, "Legal entity name"@en ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy : .

ltlod:positionTitle a owl:DatatypeProperty ;
    rdfs:label "Pareigos"@lt, "Position"@en ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy : .

ltlod:inPublicProcurement a owl:DatatypeProperty ;
    rdfs:label "Dalyvauja viešuosiuose pirkimuose"@lt, "Takes part in public procurement"@en ;
    rdfs:domain org:Membership ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy : .

ltlod:procurementInfo a owl:DatatypeProperty ;
    rdfs:label "Dalyvavimo viešuosiuose pirkimuose informacija"@lt, "Public procurement details"@en ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy : .

ltlod:positionName a owl:DatatypeProperty ;
    rdfs:label "Pagrindinių pareigų pobūdis"@lt, "Main position"@en ;
    rdfs:domain ltlod:InterestDeclaration ;
    rdfs:isDefinedBy : .

ltlod:workplaceName a owl:DatatypeProperty ;
    rdfs:label "Darbovietė"@lt, "Workplace"@en ;
    rdfs:domain ltlod:InterestDeclaration ;
    rdfs:isDefinedBy : .

# a lobbying declaration -> its lobbying area (taxonomies/lobbying-areas/); the view lists
# an area's declarations (on any other concept it finds nothing and stays hidden)
dct:subject a rdf:Property ;
    rdfs:label "Sritis"@lt, "Subject"@en ;
    rdfs:range skos:Concept ;
    ldh:inverseView :AreaLobbying ;
    rdfs:isDefinedBy : .

schema:value a owl:DatatypeProperty ;
    rdfs:label "Vertė"@lt, "Value"@en ;
    rdfs:isDefinedBy : .

# ISO 4217 code: LTL for reporting years up to 2014, EUR since
schema:currency a owl:DatatypeProperty ;
    rdfs:label "Valiuta"@lt, "Currency"@en ;
    rdfs:isDefinedBy : .

# Seimas election results (etl/elections/mappings/*.rq). Each link that needs its own
# 1:N listing has its own property (views attach per property).
ltlod:electedTerm a owl:ObjectProperty ;
    rdfs:label "Renkama kadencija"@lt, "Elected term"@en ;
    rdfs:domain ltlod:Election ;
    rdfs:range eli-dl:ParliamentaryTerm ;
    ldh:inverseView :TermElections ;
    rdfs:isDefinedBy : .

ltlod:election a owl:ObjectProperty ;
    rdfs:label "Rinkimai"@lt, "Election"@en ;
    rdfs:domain ltlod:ConstituencyContest ;
    rdfs:range ltlod:Election ;
    ldh:inverseView :ElectionContests ;
    rdfs:isDefinedBy : .

ltlod:constituency a owl:ObjectProperty ;
    rdfs:label "Apygarda"@lt, "Constituency"@en ;
    rdfs:domain ltlod:ConstituencyContest ;
    rdfs:range ltlod:ElectoralDistrict ;
    ldh:inverseView :ConstituencyContests ;
    rdfs:isDefinedBy : .

ltlod:candidate a owl:ObjectProperty ;
    rdfs:label "Kandidatas"@lt, "Candidate"@en ;
    rdfs:domain ltlod:CandidateResult ;
    rdfs:range foaf:Person ;
    ldh:inverseView :PersonCandidacies ;
    rdfs:isDefinedBy : .

ltlod:party a owl:ObjectProperty ;
    rdfs:label "Partija"@lt, "Party"@en ;
    rdfs:domain ltlod:PartyListResult ;
    rdfs:range schema:PoliticalParty ;
    ldh:inverseView :PartyListResults ;
    rdfs:isDefinedBy : .

ltlod:contest a owl:ObjectProperty ;
    rdfs:label "Rinkimai apygardoje"@lt, "Contest"@en ;
    rdfs:domain ltlod:ContestRound ;
    rdfs:range ltlod:ConstituencyContest ;
    rdfs:isDefinedBy : .

ltlod:electionRound a owl:ObjectProperty ;
    rdfs:label "Rinkimų turas"@lt, "Election round"@en ;
    rdfs:domain ltlod:ContestRound ;
    rdfs:range ltlod:ElectionRound ;
    rdfs:isDefinedBy : .

ltlod:contestRound a owl:ObjectProperty ;
    rdfs:label "Turas"@lt, "Round"@en ;
    rdfs:domain [ owl:unionOf ( ltlod:CandidateResult ltlod:PartyListResult ) ] ;
    rdfs:range ltlod:ContestRound ;
    rdfs:isDefinedBy : .

ltlod:decidedInRound a owl:DatatypeProperty ;
    rdfs:label "Išspręsta ture"@lt, "Decided in round"@en ;
    rdfs:domain ltlod:ConstituencyContest ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:roundNumber a owl:DatatypeProperty ;
    rdfs:label "Turas"@lt, "Round"@en ;
    rdfs:domain ltlod:ElectionRound ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:ballotsCast a owl:DatatypeProperty ;
    rdfs:label "Dalyvavo rinkėjų"@lt, "Voters who voted"@en ;
    rdfs:domain ltlod:ContestRound ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:turnout a owl:DatatypeProperty ;
    rdfs:label "Aktyvumas, %"@lt, "Turnout, %"@en ;
    rdfs:domain ltlod:ContestRound ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

ltlod:votes a owl:DatatypeProperty ;
    rdfs:label "Balsai"@lt, "Votes"@en ;
    rdfs:domain [ owl:unionOf ( ltlod:CandidateResult ltlod:PartyListResult ) ] ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:voteShare a owl:DatatypeProperty ;
    rdfs:label "Balsų dalis, %"@lt, "Vote share, %"@en ;
    rdfs:domain [ owl:unionOf ( ltlod:CandidateResult ltlod:PartyListResult ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

ltlod:rank a owl:DatatypeProperty ;
    rdfs:label "Vieta"@lt, "Rank"@en ;
    rdfs:domain ltlod:CandidateResult ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:elected a owl:DatatypeProperty ;
    rdfs:label "Išrinktas"@lt, "Elected"@en ;
    rdfs:domain ltlod:CandidateResult ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy : .

ltlod:nominatorName a owl:DatatypeProperty ;
    rdfs:label "Iškėlė"@lt, "Nominated by (as published)"@en ;
    rdfs:domain ltlod:CandidateResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

ltlod:listNumber a owl:DatatypeProperty ;
    rdfs:label "Sąrašo numeris"@lt, "List number"@en ;
    rdfs:domain ltlod:PartyListResult ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

schema:startDate a owl:DatatypeProperty ;
    rdfs:label "Data"@lt, "Date"@en ;
    rdfs:isDefinedBy : .

# VRK campaign finance (etl/elections/mappings/campaign-*.rq)
ltlod:inElection a owl:ObjectProperty ;
    rdfs:label "Rinkimai"@lt, "Election"@en ;
    rdfs:domain ltlod:CampaignParticipant ;
    rdfs:range ltlod:Election ;
    ldh:inverseView :ElectionCampaigns ;
    rdfs:isDefinedBy : .

# whose campaign it is: the candidate (a Seimas person) or the party
ltlod:campaignOf a owl:ObjectProperty ;
    rdfs:label "Kieno kampanija"@lt, "Campaign of"@en ;
    rdfs:domain ltlod:CampaignParticipant ;
    rdfs:range foaf:Person, schema:PoliticalParty ;
    ldh:inverseView :Campaigns ;
    rdfs:isDefinedBy : .

ltlod:candidacy a owl:ObjectProperty ;
    rdfs:label "Kandidato rezultatas"@lt, "Candidate result"@en ;
    rdfs:domain ltlod:CampaignParticipant ;
    rdfs:range ltlod:CandidateResult ;
    rdfs:isDefinedBy : .

ltlod:recipient a owl:ObjectProperty ;
    rdfs:label "Gavėjas"@lt, "Recipient"@en ;
    rdfs:domain [ owl:unionOf ( ltlod:CampaignDonation ltlod:CampaignIncomeTotal ) ] ;
    rdfs:range ltlod:CampaignParticipant ;
    ldh:inverseView :ParticipantIncome ;
    rdfs:isDefinedBy : .

ltlod:payer a owl:ObjectProperty ;
    rdfs:label "Mokėtojas"@lt, "Payer"@en ;
    rdfs:domain [ owl:unionOf ( ltlod:CampaignExpense ltlod:CampaignExpenseTotal ) ] ;
    rdfs:range ltlod:CampaignParticipant ;
    ldh:inverseView :ParticipantExpenses ;
    rdfs:isDefinedBy : .

ltlod:donor a owl:ObjectProperty ;
    rdfs:label "Aukotojas"@lt, "Donor"@en ;
    rdfs:domain ltlod:CampaignDonation ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :CampaignDonationsMade ;
    rdfs:isDefinedBy : .

ltlod:provider a owl:ObjectProperty ;
    rdfs:label "Paslaugų teikėjas"@lt, "Service provider"@en ;
    rdfs:domain ltlod:CampaignExpense ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :CampaignServicesProvided ;
    rdfs:isDefinedBy : .

ltlod:campaignName a owl:DatatypeProperty ;
    rdfs:label "Politinė kampanija"@lt, "Campaign"@en ;
    rdfs:domain ltlod:CampaignParticipant ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

ltlod:vrkCandidateId a owl:DatatypeProperty ;
    rdfs:label "VRK kandidato ID"@lt, "VRK candidate id"@en ;
    rdfs:domain ltlod:CampaignParticipant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

ltlod:donorName a owl:DatatypeProperty ;
    rdfs:label "Aukotojas (kaip paskelbta)"@lt, "Donor (as published)"@en ;
    rdfs:domain ltlod:CampaignDonation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

ltlod:donorCode a owl:DatatypeProperty ;
    rdfs:label "Aukotojo kodas"@lt, "Donor code"@en ;
    rdfs:domain ltlod:CampaignDonation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

ltlod:providerName a owl:DatatypeProperty ;
    rdfs:label "Paslaugų teikėjas (kaip paskelbta)"@lt, "Provider (as published)"@en ;
    rdfs:domain ltlod:CampaignExpense ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

ltlod:providerCode a owl:DatatypeProperty ;
    rdfs:label "Paslaugų teikėjo kodas"@lt, "Provider code"@en ;
    rdfs:domain ltlod:CampaignExpense ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

ltlod:fundsForm a owl:DatatypeProperty ;
    rdfs:label "Lėšų forma"@lt, "Form of funds"@en ;
    rdfs:domain ltlod:CampaignDonation ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

ltlod:count a owl:DatatypeProperty ;
    rdfs:label "Įrašų skaičius"@lt, "Number of records"@en ;
    rdfs:domain [ owl:unionOf ( ltlod:CampaignIncomeTotal ltlod:CampaignExpenseTotal ) ] ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

dct:date a owl:DatatypeProperty ;
    rdfs:label "Data"@lt, "Date"@en ;
    rdfs:isDefinedBy : .

dct:issued a owl:DatatypeProperty ;
    rdfs:label "Pateikta"@lt, "Filed"@en ;
    rdfs:isDefinedBy : .

dct:modified a owl:DatatypeProperty ;
    rdfs:label "Atnaujinta"@lt, "Updated"@en ;
    rdfs:isDefinedBy : .

# Sodra employer data: the employer dimension -> the legal entity (JAR code); its inverse
# view shows an organisation's headcount and wage (latest month + window aggregates, and
# the monthly series when built with SODRA_CUBE=1). The latest-month measures are as Sodra
# publishes them; the wage and the contributions are in EUR.
ltlod:employer a owl:ObjectProperty, qb:DimensionProperty ;
    rdfs:label "Darbdavys"@lt, "Employer"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :EmployerObservations ;
    rdfs:isDefinedBy : .

ltlod:insuredCount a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Apdraustųjų skaičius"@lt, "Insured persons"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:averageWage a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Vidutinis darbo užmokestis, EUR"@lt, "Average wage, EUR"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

ltlod:contributions a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Socialinio draudimo įmokos, EUR"@lt, "Social insurance contributions, EUR"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

# window aggregates of the per-employer summary, over the months (of the latest
# SODRA_MONTHS, default 12) in which the employer reported
ltlod:monthsReported a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Mėnesių su duomenimis"@lt, "Months reported"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

ltlod:meanInsuredCount a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Vidutinis apdraustųjų skaičius per 12 mėn."@lt, "Mean insured persons, 12 months"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

ltlod:meanAverageWage a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Vidutinis darbo užmokestis per 12 mėn., EUR"@lt, "Mean wage, 12 months, EUR"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

ltlod:totalContributions a owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Įmokos per 12 mėn., EUR"@lt, "Contributions, 12 months, EUR"@en ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

sdmx-dimension:refArea a owl:ObjectProperty ;
    rdfs:label "Savivaldybė"@lt, "Reference area"@en ;
    rdfs:isDefinedBy : .

# the observation month as a literal (xsd:gYearMonth), for sorting
dct:date a owl:DatatypeProperty ;
    rdfs:label "Mėnuo"@lt, "Month"@en ;
    rdfs:isDefinedBy : .

# org:member points from an n-ary org:Membership to the person; its inverse view
# gathers a person's memberships into one table (rdfs:range foaf:Person is the
# view-discovery hint — LDH surfaces :Memberships on every foaf:Person instance).
org:member a owl:ObjectProperty ;
    rdfs:label "Narys"@lt, "Member"@en ;
    rdfs:domain org:Membership ;
    rdfs:range foaf:Person ;
    ldh:inverseView :Memberships, :PersonTerms ;
    rdfs:isDefinedBy : .

# org:role / org:memberDuring carry no view but are labelled so the memberships
# table (files/client.xsl) shows Lithuanian column headers next to org:organization.
org:role a owl:ObjectProperty ;
    rdfs:label "Pareigos"@lt, "Role"@en ;
    rdfs:domain org:Membership ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy : .

org:memberDuring a owl:ObjectProperty ;
    rdfs:label "Laikotarpis"@lt, "During"@en ;
    rdfs:domain org:Membership ;
    rdfs:range time:Interval ;
    rdfs:isDefinedBy : .

# Seimas calendar links. Each carries its own view, and none reuses
# dct:isPartOf: LDH attaches every inverseView of a property to every type in its
# rdfs:range, and dct:isPartOf already carries :SubUnits for admin units.

# sessions/sittings/votes -> the Seimas; the view lists the Seimas' terms
eli-dl:had_responsible_organization a owl:ObjectProperty ;
    rdfs:label "Atsakinga institucija"@lt, "Responsible organization"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range cv:PublicOrganisation ;
    ldh:inverseView :Terms ;
    rdfs:isDefinedBy : .

# sessions/sittings/votes -> their term; the view lists the term's sessions
eli-dl:parliamentary_term a owl:ObjectProperty ;
    rdfs:label "Kadencija"@lt, "Parliamentary term"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range eli-dl:ParliamentaryTerm ;
    ldh:inverseView :Sessions ;
    rdfs:isDefinedBy : .

# an MP's seat (tenure org:Membership) -> its term (persons.rq); the view lists
# the members who held a seat in the term
epvoc:memberDuringParliamentaryTerm a owl:ObjectProperty ;
    rdfs:label "Kadencija"@lt, "Parliamentary term"@en ;
    rdfs:domain org:Membership ;
    rdfs:range eli-dl:ParliamentaryTerm ;
    ldh:inverseView :TermMembers ;
    rdfs:isDefinedBy : .

# sitting -> its session; the view lists the session's sittings
eli-dl:forms_part_of a owl:ObjectProperty ;
    rdfs:label "Sesija"@lt, "Forms part of"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range schema:EventSeries ;
    ldh:inverseView :Sittings ;
    rdfs:isDefinedBy : .

# session/sitting -> its type concept; the views list the activities of a type.
# The range keeps them off other SKOS concept pages (activity-types concepts are
# skos:Concept + eli-dl:ActivityType); a type is either a session or a sitting
# type, so only one of the two (non-empty) views shows.
eli-dl:had_activity_type a owl:ObjectProperty ;
    rdfs:label "Tipas"@lt, "Activity type"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range eli-dl:ActivityType ;
    ldh:inverseView :SittingsOfType, :SessionsOfType ;
    rdfs:isDefinedBy : .

# Seimas votes. vote -> its sitting is schema:superEvent rather than
# eli-dl:forms_part_of, which already carries :Sittings (session -> sittings).
eli-dl:decision_method a owl:ObjectProperty ;
    rdfs:label "Balsavimo būdas"@lt, "Decision method"@en ;
    rdfs:domain eli-dl:Decision ;
    rdfs:range eli-dl:DecisionMethod ;
    ldh:inverseView :VotesOfMethod ;
    rdfs:isDefinedBy : .

# vote -> sitting, agenda item -> sitting, and vote -> the agenda item it was held
# on. eli-dl:Activity in the range puts both views on agenda item pages too (an
# item is a plain eli-dl:Activity): :SittingVotes then lists the item's votes, and
# :SittingAgendaItems finds nothing there and stays hidden (on sessions, also
# eli-dl:Activity, both stay hidden).
schema:superEvent a owl:ObjectProperty ;
    rdfs:label "Posėdis"@lt, "Super event"@en ;
    rdfs:domain [ owl:unionOf ( eli-dl:Vote eli-dl:Activity ) ] ;
    rdfs:range schema:Event, eli-dl:Activity ;
    ldh:inverseView :SittingVotes, :SittingAgendaItems ;
    rdfs:isDefinedBy : .

# agenda item -> the bill(s) it considers; the bill page lists the items and,
# through them, the votes
eli-dl:involved_work a owl:ObjectProperty ;
    rdfs:label "Svarstomas projektas"@lt, "Bill considered"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range eli-dl:DraftLegislationWork ;
    ldh:inverseView :BillAgendaItems, :BillVotes ;
    rdfs:isDefinedBy : .

# bill -> the members who initiated it
eli-dl:legislative_process_work_creator a owl:ObjectProperty ;
    rdfs:label "Iniciatorius"@lt, "Initiator"@en ;
    rdfs:domain eli-dl:DraftLegislationWork ;
    rdfs:range foaf:Person ;
    ldh:inverseView :PersonBills ;
    rdfs:isDefinedBy : .

# agenda item -> the members who spoke on it
eli-dl:had_participant_person a owl:ObjectProperty ;
    rdfs:label "Kalbėjo"@lt, "Speaker"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range foaf:Person ;
    ldh:inverseView :PersonSpeeches ;
    rdfs:isDefinedBy : .

eli-dl:occured_at_stage a owl:ObjectProperty ;
    rdfs:label "Stadija"@lt, "Stage"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range eli-dl:ProcessStage ;
    ldh:inverseView :StageAgendaItems ;
    rdfs:isDefinedBy : .

# vote -> person, one property per choice, so each choice gets its own view on
# the person page (open votes only, see votes.rq)
eli-dl:had_voter_favor a owl:ObjectProperty ;
    rdfs:label "Balsavo už"@lt, "Voted in favor"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range foaf:Person ;
    ldh:inverseView :VotesInFavor ;
    rdfs:isDefinedBy : .

eli-dl:had_voter_against a owl:ObjectProperty ;
    rdfs:label "Balsavo prieš"@lt, "Voted against"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range foaf:Person ;
    ldh:inverseView :VotesAgainst ;
    rdfs:isDefinedBy : .

eli-dl:had_voter_abstention a owl:ObjectProperty ;
    rdfs:label "Susilaikė"@lt, "Abstained"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range foaf:Person ;
    ldh:inverseView :VotesAbstained ;
    rdfs:isDefinedBy : .

# Calendar links. A dated sitting or vote -> its calendar day (both views show on
# every dct:PeriodOfTime; on a month or year they find nothing and stay hidden).
# day -> month -> year is time:intervalIn, which carries the sub-period listing.
# Also every start/end time:Instant (terms, sessions, memberships, facility register
# periods and health-care licences) -> its day; those views reach the term/session/
# person/facility through the instant.
dct:temporal a owl:ObjectProperty ;
    rdfs:label "Laikas"@lt, "Time"@en ;
    rdfs:domain [ owl:unionOf ( schema:Event eli-dl:Vote eli-dl:Activity eli-dl:DraftLegislationWork time:Instant ltlod:AssetDeclaration ltlod:CampaignDonation ltlod:CampaignExpense epo:Contract ltlod:LobbyingDeclaration ltlod:Lobbyist qb:Observation ltlod:LandAcquisitionApplication ltlod:LandAcquisitionDecision ) ] ;
    rdfs:range dct:PeriodOfTime ;
    ldh:inverseView :DaySittings, :DayVotes, :DayAgendaItems, :DayBills, :DayTerms, :DaySessions, :DayMembershipsBegan, :DayMembershipsEnded, :YearDeclarations, :DayRegistrations, :DayDeregistrations, :DayElections, :DayCampaignDonations, :DayCampaignExpenses, :DayFacilityRegistrations, :DayContracts, :DayLobbying, :DayLobbyistRegistrations, :DayInterestTies, :MonthEmployers, :DayLandApplications, :DayLandDecisions, :YearLandTotals ;
    rdfs:isDefinedBy : .

time:intervalIn a owl:ObjectProperty ;
    rdfs:label "Priklauso laikotarpiui"@lt, "Interval in"@en ;
    rdfs:domain time:DateTimeInterval ;
    rdfs:range time:DateTimeInterval ;
    ldh:inverseView :CalendarDays ;
    rdfs:isDefinedBy : .

# label-only (facet pills, sort options, property columns)

eli-dl:activity_date a owl:DatatypeProperty ;
    rdfs:label "Data"@lt, "Date"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

# a session's start/end is a day, a sitting's and a vote's a time of day
eli-dl:activity_start_date a owl:DatatypeProperty ;
    rdfs:label "Pradžia"@lt, "Start"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:date xsd:dateTime ) ] ;
    rdfs:isDefinedBy : .

eli-dl:activity_end_date a owl:DatatypeProperty ;
    rdfs:label "Pabaiga"@lt, "End"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:date xsd:dateTime ) ] ;
    rdfs:isDefinedBy : .

eli-dl:activity_order a owl:DatatypeProperty ;
    rdfs:label "Numeris"@lt, "Number"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

eli-dl:recorded_in_a_realization_of a owl:ObjectProperty ;
    rdfs:label "Užfiksuota dokumente"@lt, "Recorded in"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:isDefinedBy : .

# language-tagged (ELI-DL's own range is xsd:string)
eli-dl:activity_label a owl:DatatypeProperty ;
    rdfs:label "Svarstomas klausimas"@lt, "Agenda item"@en ;
    rdfs:domain eli-dl:Activity ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

eli-dl:legislative_process_work_date a owl:DatatypeProperty ;
    rdfs:label "Užregistruotas"@lt, "Registered"@en ;
    rdfs:domain eli-dl:DraftLegislationWork ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

eli-dl:number_of_attendees a owl:DatatypeProperty ;
    rdfs:label "Balsavo"@lt, "Voted"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

eli-dl:number_of_votes_favor a owl:DatatypeProperty ;
    rdfs:label "Už"@lt, "In favor"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

eli-dl:number_of_votes_against a owl:DatatypeProperty ;
    rdfs:label "Prieš"@lt, "Against"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

eli-dl:number_of_votes_abstention a owl:DatatypeProperty ;
    rdfs:label "Susilaikė"@lt, "Abstained"@en ;
    rdfs:domain eli-dl:Vote ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy : .

time:hasTime a owl:ObjectProperty ;
    rdfs:label "Laikotarpis"@lt, "Time"@en ;
    rdfs:domain [ owl:unionOf ( eli-dl:ParliamentaryTerm rov:RegisteredOrganization schema:EducationalOrganization schema:Permit schema:LandmarksOrHistoricalBuildings ) ] ;
    rdfs:range time:Interval ;
    rdfs:isDefinedBy : .

time:hasBeginning a owl:ObjectProperty ;
    rdfs:label "Pradžia"@lt, "Beginning"@en ;
    rdfs:domain time:Interval ;
    rdfs:range time:Instant ;
    rdfs:isDefinedBy : .

time:hasEnd a owl:ObjectProperty ;
    rdfs:label "Pabaiga"@lt, "End"@en ;
    rdfs:domain time:Interval ;
    rdfs:range time:Instant ;
    rdfs:isDefinedBy : .

time:inXSDDate a owl:DatatypeProperty ;
    rdfs:label "Data"@lt, "Date"@en ;
    rdfs:domain time:Instant ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

time:hasDateTimeDescription a owl:ObjectProperty ;
    rdfs:label "Datos aprašas"@lt, "Date-time description"@en ;
    rdfs:domain time:DateTimeInterval ;
    rdfs:range time:DateTimeDescription ;
    rdfs:isDefinedBy : .

time:unitType a owl:ObjectProperty ;
    rdfs:label "Laiko vienetas"@lt, "Temporal unit"@en ;
    rdfs:domain time:DateTimeDescription ;
    rdfs:isDefinedBy : .

time:year a owl:DatatypeProperty ;
    rdfs:label "Metai"@lt, "Year"@en ;
    rdfs:domain time:DateTimeDescription ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy : .

time:month a owl:DatatypeProperty ;
    rdfs:label "Mėnuo"@lt, "Month"@en ;
    rdfs:domain time:DateTimeDescription ;
    rdfs:range xsd:gMonth ;
    rdfs:isDefinedBy : .

time:day a owl:DatatypeProperty ;
    rdfs:label "Diena"@lt, "Day"@en ;
    rdfs:domain time:DateTimeDescription ;
    rdfs:range xsd:gDay ;
    rdfs:isDefinedBy : .

time:dayOfWeek a owl:ObjectProperty ;
    rdfs:label "Savaitės diena"@lt, "Day of week"@en ;
    rdfs:domain time:DateTimeDescription ;
    rdfs:isDefinedBy : .

# standard-vocabulary property labels (no view). LDH resolves the
# property-column label of every predicate on a page by DESCRIBE-ing it against
# this ontology ({base}ns) and language-negotiating the rdfs:label — so a bare
# rdfs:label here is enough to Lithuanianise a FOAF/DC/schema.org/… predicate that
# otherwise falls back to its (English) source-vocab label or capitalised local
# name. Bilingual on purpose: Lithuanian to lt clients, English to en clients.

foaf:depiction a rdf:Property ;
    rdfs:label "Atvaizdas"@lt, "Depiction"@en ;
    rdfs:isDefinedBy : .

foaf:img a rdf:Property ;
    rdfs:label "Paveikslėlis"@lt, "Image"@en ;
    rdfs:isDefinedBy : .

foaf:name a rdf:Property ;
    rdfs:label "Vardas ir pavardė"@lt, "Name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

foaf:givenName a rdf:Property ;
    rdfs:label "Vardas"@lt, "Given name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

foaf:familyName a rdf:Property ;
    rdfs:label "Pavardė"@lt, "Family name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

foaf:gender a rdf:Property ;
    rdfs:label "Lytis"@lt, "Gender"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

foaf:mbox a rdf:Property ;
    rdfs:label "El. paštas"@lt, "Personal mailbox"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy : .

foaf:phone a rdf:Property ;
    rdfs:label "Telefonas"@lt, "Phone"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy : .

foaf:homepage a rdf:Property ;
    rdfs:label "Svetainė"@lt, "Homepage"@en ;
    rdfs:isDefinedBy : .

foaf:isPrimaryTopicOf a rdf:Property ;
    rdfs:label "Aprašoma dokumente"@lt, "Is primary topic of"@en ;
    rdfs:isDefinedBy : .

foaf:primaryTopic a rdf:Property ;
    rdfs:label "Pagrindinė tema"@lt, "Primary topic"@en ;
    rdfs:isDefinedBy : .

foaf:topic a rdf:Property ;
    rdfs:label "Tema"@lt, "Topic"@en ;
    rdfs:isDefinedBy : .

owl:sameAs a rdf:Property ;
    rdfs:label "Sutampa su"@lt, "Same as"@en ;
    rdfs:isDefinedBy : .

dct:identifier a rdf:Property ;
    rdfs:label "Identifikatorius"@lt, "Identifier"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

dct:title a rdf:Property ;
    rdfs:label "Pavadinimas"@lt, "Title"@en ;
    rdfs:isDefinedBy : .

dct:description a rdf:Property ;
    rdfs:label "Aprašymas"@lt, "Description"@en ;
    rdfs:isDefinedBy : .

# also a calendar day -> its public holiday (taxonomies/holidays/), which carries
# the holiday's :HolidayDays view; on any other concept it finds nothing and stays
# hidden
dct:type a rdf:Property ;
    rdfs:label "Tipas"@lt, "Type"@en ;
    rdfs:range skos:Concept ;
    ldh:inverseView :HolidayDays, :EducationOfType, :HeritageOfKind ;
    rdfs:isDefinedBy : .

# objects are either taxonomies/ concepts or the EU atu-type IRIs, on purpose
cv:level a rdf:Property ;
    rdfs:label "Lygmuo"@lt, "Level"@en ;
    rdfs:domain cv:AdminUnit ;
    rdfs:isDefinedBy : .

geo:lat a rdf:Property ;
    rdfs:label "Platuma"@lt, "Latitude"@en ;
    rdfs:domain [ owl:unionOf ( cv:AdminUnit schema:EducationalOrganization ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

geo:long a rdf:Property ;
    rdfs:label "Ilguma"@lt, "Longitude"@en ;
    rdfs:domain [ owl:unionOf ( cv:AdminUnit schema:EducationalOrganization ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

gsp:asWKT a rdf:Property ;
    rdfs:label "Geometrija (WKT)"@lt, "Geometry (WKT)"@en ;
    rdfs:domain cv:AdminUnit ;
    rdfs:range gsp:wktLiteral ;
    rdfs:isDefinedBy : .

schema:validFrom a rdf:Property ;
    rdfs:label "Galioja nuo"@lt, "Valid from"@en ;
    rdfs:domain [ owl:unionOf ( cv:AdminUnit dct:Location schema:Permit ) ] ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

schema:validThrough a rdf:Property ;
    rdfs:label "Galioja iki"@lt, "Valid through"@en ;
    rdfs:domain [ owl:unionOf ( cv:AdminUnit dct:Location ) ] ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

schema:foundingDate a rdf:Property ;
    rdfs:label "Įsteigimo data"@lt, "Founding date"@en ;
    rdfs:domain rov:RegisteredOrganization ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

schema:dissolutionDate a rdf:Property ;
    rdfs:label "Likvidavimo data"@lt, "Dissolution date"@en ;
    rdfs:domain rov:RegisteredOrganization ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

skos:prefLabel a rdf:Property ;
    rdfs:label "Pavadinimas"@lt, "Preferred label"@en ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

skos:altLabel a rdf:Property ;
    rdfs:label "Alternatyvusis pavadinimas"@lt, "Alternative label"@en ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

skos:notation a rdf:Property ;
    rdfs:label "Žymuo"@lt, "Notation"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

skos:exactMatch a rdf:Property ;
    rdfs:label "Tikslus atitikmuo"@lt, "Exact match"@en ;
    rdfs:isDefinedBy : .

skos:scopeNote a rdf:Property ;
    rdfs:label "Taikymo pastaba"@lt, "Scope note"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

skos:inScheme a rdf:Property ;
    rdfs:label "Priklauso schemai"@lt, "In scheme"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:ConceptScheme ;
    rdfs:isDefinedBy : .

skos:topConceptOf a rdf:Property ;
    rdfs:label "Viršutinė schemos sąvoka"@lt, "Top concept of"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:ConceptScheme ;
    rdfs:isDefinedBy : .

rov:legalName a rdf:Property ;
    rdfs:label "Registruotas pavadinimas"@lt, "Legal name"@en ;
    rdfs:domain rov:RegisteredOrganization ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy : .

rov:orgStatus a rdf:Property ;
    rdfs:label "Teisinis statusas"@lt, "Organization status"@en ;
    rdfs:domain rov:RegisteredOrganization ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy : .

rov:companyType a rdf:Property ;
    rdfs:label "Teisinė forma"@lt, "Company type"@en ;
    rdfs:domain rov:RegisteredOrganization ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy : .

org:hasRegisteredSite a rdf:Property ;
    rdfs:label "Registruota buveinė"@lt, "Has registered site"@en ;
    rdfs:domain rov:RegisteredOrganization ;
    rdfs:range org:Site ;
    rdfs:isDefinedBy : .

# Public procurement contracts (ePO role pattern): contract -> epo:bindsBuyer /
# epo:bindsContractor -> role -> epo:playedBy -> the organisation. The organisation's
# two contract views hang off epo:playedBy (the property whose object is the
# organisation); each finds only its own role and stays hidden when empty. The range
# targets legal entities (JAR) — the described non-JAR -org fragments get no view.
epo:playedBy a owl:ObjectProperty ;
    rdfs:label "Vaidmenį atlieka"@lt, "Played by"@en ;
    rdfs:domain [ owl:unionOf ( epo:Buyer epo:Contractor ) ] ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :ContractsAsBuyer, :ContractsAsContractor ;
    rdfs:isDefinedBy : .

epo:bindsBuyer a owl:ObjectProperty ;
    rdfs:label "Perkančioji organizacija"@lt, "Buyer"@en ;
    rdfs:domain epo:Contract ;
    rdfs:range epo:Buyer ;
    rdfs:isDefinedBy : .

epo:bindsContractor a owl:ObjectProperty ;
    rdfs:label "Tiekėjas"@lt, "Contractor"@en ;
    rdfs:domain epo:Contract ;
    rdfs:range epo:Contractor ;
    rdfs:isDefinedBy : .

epo:hasContractConclusionDate a owl:DatatypeProperty ;
    rdfs:label "Sudarymo data"@lt, "Conclusion date"@en ;
    rdfs:domain epo:Contract ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy : .

epo:hasContractValue a owl:ObjectProperty ;
    rdfs:label "Sutarties vertė"@lt, "Contract value"@en ;
    rdfs:domain epo:Contract ;
    rdfs:range epo:MonetaryValue ;
    rdfs:isDefinedBy : .

epo:hasAmountValue a owl:DatatypeProperty ;
    rdfs:label "Suma"@lt, "Amount"@en ;
    rdfs:domain epo:MonetaryValue ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy : .

epo:hasCurrency a owl:ObjectProperty ;
    rdfs:label "Valiuta"@lt, "Currency"@en ;
    rdfs:domain epo:MonetaryValue ;
    rdfs:isDefinedBy : .

epo:hasPurpose a owl:ObjectProperty ;
    rdfs:label "Pirkimo objektas"@lt, "Purpose"@en ;
    rdfs:domain epo:Contract ;
    rdfs:range epo:Purpose ;
    rdfs:isDefinedBy : .

# objects are OP CPV concepts (http://data.europa.eu/cpv/cpv/{8 digits})
epo:hasMainClassification a owl:ObjectProperty ;
    rdfs:label "BVPŽ kodas"@lt, "CPV code"@en ;
    rdfs:domain epo:Purpose ;
    rdfs:isDefinedBy : .

epo:hasLegalName a owl:DatatypeProperty ;
    rdfs:label "Pavadinimas"@lt, "Legal name"@en ;
    rdfs:domain org:Organization ;
    rdfs:isDefinedBy : .

# --- facility registers (etl/facilities/) ---

# facility -> the JAR legal entity that runs it (for a school branch without its own
# JAR code: the parent institution's). Its own term so the legal entity's view
# attaches to this relationship only (views attach per property).
ltlod:legalEntity a owl:ObjectProperty ;
    rdfs:label "Juridinis asmuo"@lt, "Legal entity"@en ;
    rdfs:subPropertyOf org:linkedTo ;
    rdfs:domain [ owl:unionOf ( schema:EducationalOrganization schema:MedicalOrganization ) ] ;
    rdfs:range rov:RegisteredOrganization ;
    ldh:inverseView :LegalEntityFacilities ;
    rdfs:isDefinedBy : .

ltlod:licence a owl:ObjectProperty ;
    rdfs:label "Licencija"@lt, "Licence"@en ;
    rdfs:domain schema:MedicalOrganization ;
    rdfs:range schema:Permit ;
    rdfs:isDefinedBy : .

ltlod:protectionStatus a owl:ObjectProperty ;
    rdfs:label "Apsaugos statusas"@lt, "Protection status"@en ;
    rdfs:domain schema:LandmarksOrHistoricalBuildings ;
    rdfs:range skos:Concept ;
    ldh:inverseView :HeritageOfStatus ;
    rdfs:isDefinedBy : .

ltlod:significance a owl:ObjectProperty ;
    rdfs:label "Reikšmingumo lygmuo"@lt, "Level of significance"@en ;
    rdfs:domain schema:LandmarksOrHistoricalBuildings ;
    rdfs:range skos:Concept ;
    ldh:inverseView :HeritageOfSignificance ;
    rdfs:isDefinedBy : .

# heritage object -> its valuable-property kinds (taxonomies/heritage-values/)
dct:subject a rdf:Property ;
    rdfs:label "Vertingųjų savybių pobūdis"@lt, "Valuable properties"@en ;
    rdfs:range skos:Concept ;
    ldh:inverseView :HeritageWithValue ;
    rdfs:isDefinedBy : .

# school branch -> its parent institution
org:subOrganizationOf a owl:ObjectProperty ;
    rdfs:label "Priklauso organizacijai"@lt, "Sub-organization of"@en ;
    rdfs:domain schema:EducationalOrganization ;
    rdfs:range schema:EducationalOrganization ;
    ldh:inverseView :Branches ;
    rdfs:isDefinedBy : .

# member of a heritage complex -> the complex
schema:containedInPlace a owl:ObjectProperty ;
    rdfs:label "Komplekso dalis"@lt, "Contained in place"@en ;
    rdfs:domain schema:LandmarksOrHistoricalBuildings ;
    rdfs:range schema:LandmarksOrHistoricalBuildings ;
    ldh:inverseView :ComplexParts ;
    rdfs:isDefinedBy : .

locn:address a owl:ObjectProperty ;
    rdfs:label "Adresas"@lt, "Address"@en ;
    rdfs:domain [ owl:unionOf ( schema:EducationalOrganization schema:LandmarksOrHistoricalBuildings ) ] ;
    rdfs:range locn:Address ;
    rdfs:isDefinedBy : .

org:hasSite a owl:ObjectProperty ;
    rdfs:label "Veiklos vieta"@lt, "Site"@en ;
    rdfs:domain schema:MedicalOrganization ;
    rdfs:range org:Site ;
    rdfs:isDefinedBy : .

locn:fullAddress a rdf:Property ;
    rdfs:label "Adresas"@lt, "Full address"@en ;
    rdfs:domain locn:Address ;
    rdfs:isDefinedBy : .

locn:thoroughfare a rdf:Property ;
    rdfs:label "Gatvė"@lt, "Thoroughfare"@en ;
    rdfs:domain locn:Address ;
    rdfs:isDefinedBy : .

locn:locatorDesignator a rdf:Property ;
    rdfs:label "Namo numeris"@lt, "Locator designator"@en ;
    rdfs:domain locn:Address ;
    rdfs:isDefinedBy : .

schema:category a rdf:Property ;
    rdfs:label "Klasifikacija"@lt, "Category"@en ;
    rdfs:domain schema:LandmarksOrHistoricalBuildings ;
    rdfs:isDefinedBy : .

org:siteAddress a rdf:Property ;
    rdfs:label "Adresas"@lt, "Site address"@en ;
    rdfs:domain org:Site ;
    rdfs:range locn:Address ;
    rdfs:isDefinedBy : .

locn:addressId a rdf:Property ;
    rdfs:label "Adreso kodas"@lt, "Address ID"@en ;
    rdfs:domain locn:Address ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

locn:postCode a rdf:Property ;
    rdfs:label "Pašto kodas"@lt, "Post code"@en ;
    rdfs:domain locn:Address ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy : .

# views
# Territorial hierarchy: children point up via dct:isPartOf, every parent is a
# cv:AdminUnit, so one view covers county→municipalities, municipality→
# elderships, eldership→settlements and settlement→streets.

:SubUnits a ldh:View ;
    dct:title "Sudedamieji vienetai"@lt, "Constituent units"@en ;
    spin:query :SelectSubUnits ;
    ac:mode ac:MapMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSubUnits a sp:Select ;
    rdfs:label "Select sub-units" ;
    sp:text """
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX gsp: <http://www.opengis.net/ont/geosparql#>

SELECT DISTINCT ?unit
WHERE
  { GRAPH ?graph
      { ?unit  dct:isPartOf  $about
        FILTER EXISTS { { ?unit  geo:lat  ?lat }
                        UNION
                        { ?unit  gsp:asWKT  ?wkt } }
      }
  }
ORDER BY ?unit
""" ;
    rdfs:isDefinedBy : .

# Organizations whose registered office resolves to this admin unit. Imageless
# targets (legal entities) keep the default list layout.

:OrganizationsHere a ldh:View ;
    dct:title "Čia registruotos organizacijos"@lt, "Organizations registered here"@en ;
    spin:query :SelectOrganizationsHere ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectOrganizationsHere a sp:Select ;
    rdfs:label "Select organizations registered in this admin unit" ;
    sp:text """
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX locn: <http://www.w3.org/ns/locn#>

PREFIX rov:  <http://www.w3.org/ns/regorg#>

SELECT DISTINCT ?org
WHERE
  { GRAPH ?graph
      { ?org org:hasRegisteredSite/org:siteAddress/locn:adminUnit $about ;
            rov:companyType ?companyType
      }
  }
ORDER BY ?org
""" ;
    rdfs:isDefinedBy : .

# Organizations whose registered office is on this street (dct:spatial), filterable
# by legal form like :OrganizationsHere.

:OrganizationsOnStreet a ldh:View ;
    dct:title "Šioje gatvėje registruotos organizacijos"@lt, "Organizations registered on this street"@en ;
    spin:query :SelectOrganizationsOnStreet ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectOrganizationsOnStreet a sp:Select ;
    rdfs:label "Select organizations registered on this street" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX rov:  <http://www.w3.org/ns/regorg#>

SELECT DISTINCT ?org
WHERE
  { GRAPH ?graph
      { ?org org:hasRegisteredSite/org:siteAddress/dct:spatial $about ;
            rov:companyType ?companyType
      }
  }
ORDER BY ?org
""" ;
    rdfs:isDefinedBy : .

# Memberships are n-ary org:Membership fragments in the person's graph; the
# interval and the person's own attributes live in the same graph, so one GRAPH
# block suffices. Current membership = org:memberDuring interval without
# time:hasEnd. A person with an ended stint and a current one appears in both
# lists — accepted.

:CurrentMembers a ldh:View ;
    dct:title "Dabartiniai nariai"@lt, "Current members"@en ;
    spin:query :SelectCurrentMembers ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectCurrentMembers a sp:Select ;
    rdfs:label "Select current members" ;
    sp:text """
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX time:  <http://www.w3.org/2006/time#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:organization $about ;
            org:member ?person ;
            org:memberDuring ?interval .
        ?person foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender ;
            ltlod:nominatedBy ?party
        FILTER NOT EXISTS { ?interval time:hasEnd ?end }
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

:FormerMembers a ldh:View ;
    dct:title "Buvę nariai"@lt, "Former members"@en ;
    spin:query :SelectFormerMembers ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectFormerMembers a sp:Select ;
    rdfs:label "Select former members" ;
    sp:text """
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX time:  <http://www.w3.org/2006/time#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:organization $about ;
            org:member ?person ;
            org:memberDuring/time:hasEnd ?end .
        ?person foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender ;
            ltlod:nominatedBy ?party
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

# Public offices held in an organization (etl/officials/): the President, the
# Government's members, the MEPs elected in Lithuania, a municipality's mayors — one
# table row per office (holder, position, period), so a person who held several
# portfolios or terms appears once per office. Seimas seats (the tenures, carrying
# epvoc:memberDuringParliamentaryTerm) are :CurrentMembers / :FormerMembers' job, and
# Seimas structural units are excluded altogether, so this view stays hidden on the
# Seimas and its units.
:Officeholders a ldh:View ;
    dct:title "Pareigas ėjo"@lt, "Office holders"@en ;
    spin:query :SelectOfficeholders ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectOfficeholders a sp:Select ;
    rdfs:label "Select the offices held in the organization" ;
    sp:text """
PREFIX epvoc: <https://data.europarl.europa.eu/def/epvoc#>
PREFIX org:   <http://www.w3.org/ns/org#>

SELECT DISTINCT ?membership
WHERE
  { GRAPH ?graph
      { ?membership org:organization $about ;
            org:member ?person ;
            org:role ?role ;
            org:memberDuring ?interval
        FILTER NOT EXISTS { ?membership epvoc:memberDuringParliamentaryTerm ?term }
      }
    FILTER NOT EXISTS { GRAPH ?unitGraph { $about a org:OrganizationalUnit } }
  }
ORDER BY ?membership
""" ;
    rdfs:isDefinedBy : .

:Units a ldh:View ;
    dct:title "Padaliniai"@lt, "Units"@en ;
    spin:query :SelectUnits ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectUnits a sp:Select ;
    rdfs:label "Select organizational units" ;
    sp:text """
PREFIX org: <http://www.w3.org/ns/org#>

SELECT DISTINCT ?unit
WHERE
  { GRAPH ?graph
      { ?unit org:unitOf $about }
  }
ORDER BY ?unit
""" ;
    rdfs:isDefinedBy : .

:NominatedMembers a ldh:View ;
    dct:title "Iškelti Seimo nariai"@lt, "Nominated members of the Seimas"@en ;
    spin:query :SelectNominatedMembers ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectNominatedMembers a sp:Select ;
    rdfs:label "Select persons nominated by party" ;
    sp:text """
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?person ltlod:nominatedBy $about ;
            foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

# Members elected in this electoral district: the single-member seat membership
# (org:Membership) carries ltlod:electoralDistrict; persons have photos -> grid.

:MembersElectedHere a ldh:View ;
    dct:title "Šioje apygardoje išrinkti Seimo nariai"@lt, "Members elected in this district"@en ;
    spin:query :SelectMembersElectedHere ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectMembersElectedHere a sp:Select ;
    rdfs:label "Select members elected in this district" ;
    sp:text """
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:member ?person ;
            ltlod:electoralDistrict $about .
        ?person foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender ;
            ltlod:nominatedBy ?party
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

# The terms in which the person held a Seimas seat: the seat (tenure)
# org:Membership points at its term via epvoc:memberDuringParliamentaryTerm
# (persons.rq); the term page lists the term's sessions and members.
:PersonTerms a ldh:View ;
    dct:title "Kadencijos"@lt, "Parliamentary terms"@en ;
    spin:query :SelectPersonTerms ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPersonTerms a sp:Select ;
    rdfs:label "Select the terms in which the person held a seat" ;
    sp:text """
PREFIX epvoc: <https://data.europarl.europa.eu/def/epvoc#>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?term
WHERE
  { GRAPH ?graph
      { ?membership org:member $about ;
            epvoc:memberDuringParliamentaryTerm ?term }
    GRAPH ?termGraph
      { ?term skos:prefLabel ?label }
  }
ORDER BY DESC(?label)
""" ;
    rdfs:isDefinedBy : .

# A person's positions and memberships as one table (replaces the ~30 raw
# org:Membership blocks, which the client-side XSLT override suppresses). LDH
# renders a view by DESCRIBE-ing the projected term, so project only the
# membership URI: the table columns become its predicates (org:role,
# org:organization resolve to links; org:memberDuring shows the interval's
# dct:title period from the persons.rq mapping).

:Memberships a ldh:View ;
    dct:title "Pareigos ir narystės"@lt, "Positions and memberships"@en ;
    spin:query :SelectMemberships ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectMemberships a sp:Select ;
    rdfs:label "Select the person's memberships" ;
    sp:text """
PREFIX org: <http://www.w3.org/ns/org#>

SELECT DISTINCT ?membership
WHERE
  { GRAPH ?graph
      { ?membership a org:Membership ;
            org:member $about }
  }
ORDER BY ?membership
""" ;
    rdfs:isDefinedBy : .

# Seimas calendar views. Activities sort by their ELI-DL date, which sits on the
# activity itself (not in a time:Interval) precisely so it can be a sort column.

# The Seimas' terms, newest first. Terms carry no link to the Seimas themselves,
# so they are reached through the sessions held in them.
:Terms a ldh:View ;
    dct:title "Kadencijos"@lt, "Parliamentary terms"@en ;
    spin:query :SelectTerms ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectTerms a sp:Select ;
    rdfs:label "Select the organization's parliamentary terms" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?term
WHERE
  { GRAPH ?graph
      { ?term a eli-dl:ParliamentaryTerm ;
            skos:prefLabel ?label }
    GRAPH ?sessionGraph
      { ?session eli-dl:parliamentary_term ?term ;
            eli-dl:had_responsible_organization $about }
  }
ORDER BY DESC(?label)
""" ;
    rdfs:isDefinedBy : .

# The term's sessions in order. Sittings also carry eli-dl:parliamentary_term,
# hence the schema:EventSeries restriction.
:Sessions a ldh:View ;
    dct:title "Sesijos"@lt, "Sessions"@en ;
    spin:query :SelectSessions ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSessions a sp:Select ;
    rdfs:label "Select the term's sessions" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?session
WHERE
  { GRAPH ?graph
      { ?session a schema:EventSeries ;
            eli-dl:parliamentary_term $about ;
            eli-dl:had_activity_type ?type ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY ?start
""" ;
    rdfs:isDefinedBy : .

# Members who held a seat in the term: the tenure membership (persons.rq) points
# at the term; same person columns as :CurrentMembers. Persons cover the members
# of every term since 1990 (one tenure per term served).
:TermMembers a ldh:View ;
    dct:title "Kadencijos Seimo nariai"@lt, "Members of the Seimas in this term"@en ;
    spin:query :SelectTermMembers ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectTermMembers a sp:Select ;
    rdfs:label "Select members who held a seat in the term" ;
    sp:text """
PREFIX epvoc: <https://data.europarl.europa.eu/def/epvoc#>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>
SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:member ?person ;
            epvoc:memberDuringParliamentaryTerm $about .
        ?person foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender ;
            ltlod:nominatedBy ?party
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

# The session's plenary sittings in order: by day, then by sitting id (ids grow
# through the day, so a morning sitting precedes the evening one).
:Sittings a ldh:View ;
    dct:title "Plenariniai posėdžiai"@lt, "Plenary sittings"@en ;
    spin:query :SelectSittings ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSittings a sp:Select ;
    rdfs:label "Select the session's plenary sittings" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?sitting
WHERE
  { GRAPH ?graph
      { ?sitting eli-dl:forms_part_of $about ;
            eli-dl:had_activity_type ?type ;
            eli-dl:activity_date ?date
      }
  }
ORDER BY ?date ?sitting
""" ;
    rdfs:isDefinedBy : .

# Sittings / sessions of an activity type, newest first, filterable by term.
:SittingsOfType a ldh:View ;
    dct:title "Šio tipo posėdžiai"@lt, "Sittings of this type"@en ;
    spin:query :SelectSittingsOfType ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSittingsOfType a sp:Select ;
    rdfs:label "Select the sittings of the activity type" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?sitting
WHERE
  { GRAPH ?graph
      { ?sitting a schema:Event ;
            eli-dl:had_activity_type $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_date ?date
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

:SessionsOfType a ldh:View ;
    dct:title "Šio tipo sesijos"@lt, "Sessions of this type"@en ;
    spin:query :SelectSessionsOfType ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSessionsOfType a sp:Select ;
    rdfs:label "Select the sessions of the activity type" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?session
WHERE
  { GRAPH ?graph
      { ?session a schema:EventSeries ;
            eli-dl:had_activity_type $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY DESC(?start)
""" ;
    rdfs:isDefinedBy : .

# The sitting's votes in the order they were held, filterable by voting method.
:SittingVotes a ldh:View ;
    dct:title "Balsavimai"@lt, "Votes"@en ;
    spin:query :SelectSittingVotes ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSittingVotes a sp:Select ;
    rdfs:label "Select the sitting's votes" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote schema:superEvent $about ;
            eli-dl:decision_method ?method ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY ?start
""" ;
    rdfs:isDefinedBy : .

# Votes held by a voting method, newest first, filterable by term.
:VotesOfMethod a ldh:View ;
    dct:title "Šiuo būdu priimti sprendimai"@lt, "Votes by this method"@en ;
    spin:query :SelectVotesOfMethod ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectVotesOfMethod a sp:Select ;
    rdfs:label "Select the votes of the decision method" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote eli-dl:decision_method $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY DESC(?start)
""" ;
    rdfs:isDefinedBy : .

# A member's open votes with this choice (eli-dl:had_voter_favor), newest first, filterable by term.
:VotesInFavor a ldh:View ;
    dct:title "Balsavo už"@lt, "Voted in favor"@en ;
    spin:query :SelectVotesInFavor ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectVotesInFavor a sp:Select ;
    rdfs:label "Select the votes the person voted in favor of" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote eli-dl:had_voter_favor $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY DESC(?start)
""" ;
    rdfs:isDefinedBy : .

# as :VotesInFavor, for eli-dl:had_voter_against
:VotesAgainst a ldh:View ;
    dct:title "Balsavo prieš"@lt, "Voted against"@en ;
    spin:query :SelectVotesAgainst ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectVotesAgainst a sp:Select ;
    rdfs:label "Select the votes the person voted against" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote eli-dl:had_voter_against $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY DESC(?start)
""" ;
    rdfs:isDefinedBy : .

# as :VotesInFavor, for eli-dl:had_voter_abstention
:VotesAbstained a ldh:View ;
    dct:title "Susilaikė"@lt, "Abstained"@en ;
    spin:query :SelectVotesAbstained ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectVotesAbstained a sp:Select ;
    rdfs:label "Select the votes the person abstained in" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote eli-dl:had_voter_abstention $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY DESC(?start)
""" ;
    rdfs:isDefinedBy : .

# The days of a month or of a year, drawn as month grids by the LTLOD calendar
# layout mode (files/calendar-mode.xsl): one grid on a month page, twelve on a
# year page. Days only (unitDay): on a year page the first branch matches its
# months, which the unit filter drops, and the second reaches the days through
# the month graphs. ORDER BY ?id places each day (dct:identifier "2026-10-17");
# the mode requests the view unpaged (up to 1000), so a whole year is drawn.
:CalendarDays a ldh:View ;
    dct:title "Kalendorius"@lt, "Calendar"@en ;
    spin:query :SelectCalendarDays ;
    ac:mode ltlod:CalendarMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectCalendarDays a sp:Select ;
    rdfs:label "Select the days of the month / year" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?day
WHERE
  {   { GRAPH ?graph
          { ?day time:intervalIn $about ;
                time:hasDateTimeDescription/time:unitType time:unitDay ;
                dct:identifier ?id
          }
      }
    UNION
      { GRAPH ?graph
          { ?day time:intervalIn ?month ;
                dct:identifier ?id
          }
        GRAPH ?monthGraph
          { ?month time:intervalIn $about }
      }
  }
ORDER BY ?id
""" ;
    rdfs:isDefinedBy : .

# the calendar view layout mode (files/calendar-mode.xsl), next to LDH's ac: modes
ltlod:CalendarMode a ac:Mode ;
    rdfs:label "Kalendorius"@lt, "Calendar"@en ;
    rdfs:comment "Draws a view's results as month grids, each placed on the date of the view's ORDER BY predicate."@en ;
    rdfs:isDefinedBy : .

# The day's plenary sittings, in the order held (ids grow through the day, as
# in :Sittings).
:DaySittings a ldh:View ;
    dct:title "Plenariniai posėdžiai"@lt, "Plenary sittings"@en ;
    spin:query :SelectDaySittings ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDaySittings a sp:Select ;
    rdfs:label "Select the day's plenary sittings" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?sitting
WHERE
  { GRAPH ?graph
      { ?sitting dct:temporal $about ;
            a schema:Event ;
            eli-dl:had_activity_type ?type
      }
  }
ORDER BY ?sitting
""" ;
    rdfs:isDefinedBy : .

# The day's votes in the order held, filterable by voting method (as
# :SittingVotes).
:DayVotes a ldh:View ;
    dct:title "Balsavimai"@lt, "Votes"@en ;
    spin:query :SelectDayVotes ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayVotes a sp:Select ;
    rdfs:label "Select the day's votes" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote dct:temporal $about ;
            eli-dl:decision_method ?method ;
            eli-dl:activity_start_date ?start
      }
  }
ORDER BY ?start
""" ;
    rdfs:isDefinedBy : .

# The days a public holiday fell on, newest first.
:HolidayDays a ldh:View ;
    dct:title "Dienos"@lt, "Days"@en ;
    spin:query :SelectHolidayDays ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectHolidayDays a sp:Select ;
    rdfs:label "Select the days of the public holiday" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?day
WHERE
  { GRAPH ?graph
      { ?day a time:DateTimeInterval ;
            dct:type $about ;
            dct:identifier ?id
      }
  }
ORDER BY DESC(?id)
""" ;
    rdfs:isDefinedBy : .

# Seimas terms that began or ended on the day.
:DayTerms a ldh:View ;
    dct:title "Kadencijos pradžia ar pabaiga"@lt, "Terms beginning or ending"@en ;
    spin:query :SelectDayTerms ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayTerms a sp:Select ;
    rdfs:label "Select the terms that began or ended on the day" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?term
WHERE
  { GRAPH ?graph
      { ?term a eli-dl:ParliamentaryTerm ;
            time:hasTime/(time:hasBeginning|time:hasEnd) ?instant .
        ?instant dct:temporal $about
      }
  }
ORDER BY ?term
""" ;
    rdfs:isDefinedBy : .

# Seimas sessions that began or ended on the day.
:DaySessions a ldh:View ;
    dct:title "Sesijų pradžia ar pabaiga"@lt, "Sessions beginning or ending"@en ;
    spin:query :SelectDaySessions ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDaySessions a sp:Select ;
    rdfs:label "Select the sessions that began or ended on the day" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX schema: <https://schema.org/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?session
WHERE
  { GRAPH ?graph
      { ?session a schema:EventSeries ;
            eli-dl:had_activity_type ?type ;
            time:hasTime/(time:hasBeginning|time:hasEnd) ?instant .
        ?instant dct:temporal $about
      }
  }
ORDER BY ?session
""" ;
    rdfs:isDefinedBy : .

# Persons whose membership (Seimas seat, unit position or parliamentary group)
# began / ended on the day — the person, not the n-ary membership, is what the
# view renders; same filter/sort columns as the other person views.
:DayMembershipsBegan a ldh:View ;
    dct:title "Pradėjo narystę ar pareigas"@lt, "Memberships begun"@en ;
    spin:query :SelectDayMembershipsBegan ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayMembershipsBegan a sp:Select ;
    rdfs:label "Select the persons whose membership began on the day" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?start dct:temporal $about .
        ?interval time:hasBeginning ?start .
        ?membership org:memberDuring ?interval ;
            org:member ?person .
        ?person foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

:DayMembershipsEnded a ldh:View ;
    dct:title "Baigė narystę ar pareigas"@lt, "Memberships ended"@en ;
    spin:query :SelectDayMembershipsEnded ;
    ac:mode ac:GridMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayMembershipsEnded a sp:Select ;
    rdfs:label "Select the persons whose membership ended on the day" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?end dct:temporal $about .
        ?interval time:hasEnd ?end .
        ?membership org:memberDuring ?interval ;
            org:member ?person .
        ?person foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:gender ?gender
      }
  }
ORDER BY ?familyName ?givenName
""" ;
    rdfs:isDefinedBy : .

# Legal entities registered / deregistered on the day (JAR reg_data / isreg_data):
# the entity's time:hasTime interval begins / ends with an instant linked to the
# day. Filterable by legal form; a busy day lists hundreds, paged.
:DayRegistrations a ldh:View ;
    dct:title "Įregistruoti juridiniai asmenys"@lt, "Legal entities registered"@en ;
    spin:query :SelectDayRegistrations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayRegistrations a sp:Select ;
    rdfs:label "Select the legal entities registered on the day" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rov:  <http://www.w3.org/ns/regorg#>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?org
WHERE
  { GRAPH ?graph
      { ?start dct:temporal $about .
        ?interval time:hasBeginning ?start .
        ?org time:hasTime ?interval ;
            rov:companyType ?companyType
      }
  }
ORDER BY ?org
""" ;
    rdfs:isDefinedBy : .

:DayDeregistrations a ldh:View ;
    dct:title "Išregistruoti juridiniai asmenys"@lt, "Legal entities deregistered"@en ;
    spin:query :SelectDayDeregistrations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayDeregistrations a sp:Select ;
    rdfs:label "Select the legal entities deregistered on the day" ;
    sp:text """
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rov:  <http://www.w3.org/ns/regorg#>
PREFIX time: <http://www.w3.org/2006/time#>
SELECT DISTINCT ?org
WHERE
  { GRAPH ?graph
      { ?end dct:temporal $about .
        ?interval time:hasEnd ?end .
        ?org time:hasTime ?interval ;
            rov:companyType ?companyType
      }
  }
ORDER BY ?org
""" ;
    rdfs:isDefinedBy : .

# A person's property declarations, newest reporting year first (ltlod:declarant), and a
# calendar year's declarations (dct:temporal -> the year document; the view stays
# hidden on days and months, which no declaration points at). Filterable by
# declarant group (dct:type).
:PersonDeclarations a ldh:View ;
    dct:title "Turto deklaracijos"@lt, "Property declarations"@en ;
    spin:query :SelectPersonDeclarations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPersonDeclarations a sp:Select ;
    rdfs:label "Select the person's property declarations" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?declaration
WHERE
  { GRAPH ?graph
      { ?declaration ltlod:declarant $about ;
            a ltlod:AssetDeclaration ;
            dct:temporal ?year ;
            dct:type ?group
      }
  }
ORDER BY DESC(?year)
""" ;
    rdfs:isDefinedBy : .

:YearDeclarations a ldh:View ;
    dct:title "Turto deklaracijos"@lt, "Property declarations"@en ;
    spin:query :SelectYearDeclarations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectYearDeclarations a sp:Select ;
    rdfs:label "Select the year's property declarations" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?declaration
WHERE
  { GRAPH ?graph
      { ?declaration dct:temporal $about ;
            a ltlod:AssetDeclaration ;
            ltlod:declarant ?declarant ;
            dct:type ?group
      }
  }
ORDER BY ?declarant
""" ;
    rdfs:isDefinedBy : .

# --- Seimas bills and agenda items (bills.rq, agenda-items.rq; `make -C etl/seimas bills`) ---

# The sitting's agenda items in the order considered. activity_order marks items:
# votes (the other subjects of schema:superEvent) have none.
:SittingAgendaItems a ldh:View ;
    dct:title "Svarstyti klausimai"@lt, "Agenda items"@en ;
    spin:query :SelectSittingAgendaItems ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectSittingAgendaItems a sp:Select ;
    rdfs:label "Select the sitting's agenda items" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?item
WHERE
  { GRAPH ?graph
      { ?item schema:superEvent $about ;
            eli-dl:activity_order ?order
      }
  }
ORDER BY ?order
""" ;
    rdfs:isDefinedBy : .

# The bill's considerations in plenary, oldest first, filterable by stage.
:BillAgendaItems a ldh:View ;
    dct:title "Svarstymas Seimo posėdžiuose"@lt, "Considered in plenary"@en ;
    spin:query :SelectBillAgendaItems ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectBillAgendaItems a sp:Select ;
    rdfs:label "Select the agenda items that considered the bill" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?item
WHERE
  { GRAPH ?graph
      { ?item eli-dl:involved_work $about ;
            eli-dl:occured_at_stage ?stage ;
            eli-dl:activity_date ?date
      }
  }
ORDER BY ?date
""" ;
    rdfs:isDefinedBy : .

# The votes held on the bill's agenda items (vote -> item -> bill), oldest first,
# filterable by voting method.
:BillVotes a ldh:View ;
    dct:title "Balsavimai"@lt, "Votes"@en ;
    spin:query :SelectBillVotes ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectBillVotes a sp:Select ;
    rdfs:label "Select the votes held on the bill" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?vote
WHERE
  { GRAPH ?graph
      { ?vote schema:superEvent ?item ;
            eli-dl:decision_method ?method ;
            eli-dl:activity_start_date ?start
      }
    GRAPH ?itemGraph
      { ?item eli-dl:involved_work $about }
  }
ORDER BY ?start
""" ;
    rdfs:isDefinedBy : .

# The bills the member initiated (alone or in a group), newest first.
:PersonBills a ldh:View ;
    dct:title "Inicijuoti teisės aktų projektai"@lt, "Bills initiated"@en ;
    spin:query :SelectPersonBills ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPersonBills a sp:Select ;
    rdfs:label "Select the bills the person initiated" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?bill
WHERE
  { GRAPH ?graph
      { ?bill eli-dl:legislative_process_work_creator $about ;
            eli-dl:legislative_process_work_date ?date
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# The agenda items the member spoke on, newest first, filterable by term.
:PersonSpeeches a ldh:View ;
    dct:title "Kalbėjo svarstant"@lt, "Spoke on"@en ;
    spin:query :SelectPersonSpeeches ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPersonSpeeches a sp:Select ;
    rdfs:label "Select the agenda items the person spoke on" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?item
WHERE
  { GRAPH ?graph
      { ?item eli-dl:had_participant_person $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_date ?date
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# The agenda items considered at this stage, newest first, filterable by term.
:StageAgendaItems a ldh:View ;
    dct:title "Šioje stadijoje svarstyti klausimai"@lt, "Agenda items at this stage"@en ;
    spin:query :SelectStageAgendaItems ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectStageAgendaItems a sp:Select ;
    rdfs:label "Select the agenda items considered at the stage" ;
    sp:text """
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?item
WHERE
  { GRAPH ?graph
      { ?item eli-dl:occured_at_stage $about ;
            eli-dl:parliamentary_term ?term ;
            eli-dl:activity_date ?date
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# The day's agenda items, by sitting and order. Items carry both schema:superEvent
# and activity_order; sittings have no superEvent, votes no activity_order.
:DayAgendaItems a ldh:View ;
    dct:title "Svarstyti klausimai"@lt, "Agenda items"@en ;
    spin:query :SelectDayAgendaItems ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayAgendaItems a sp:Select ;
    rdfs:label "Select the day's agenda items" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?item
WHERE
  { GRAPH ?graph
      { ?item dct:temporal $about ;
            schema:superEvent ?sitting ;
            eli-dl:activity_order ?order
      }
  }
ORDER BY ?sitting ?order
""" ;
    rdfs:isDefinedBy : .

# The bills members registered on the day, filterable by initiator.
:DayBills a ldh:View ;
    dct:title "Užregistruoti teisės aktų projektai"@lt, "Bills registered"@en ;
    spin:query :SelectDayBills ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayBills a sp:Select ;
    rdfs:label "Select the bills registered on the day" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT DISTINCT ?bill
WHERE
  { GRAPH ?graph
      { ?bill dct:temporal $about ;
            eli-dl:legislative_process_work_creator ?initiator
      }
  }
ORDER BY ?bill
""" ;
    rdfs:isDefinedBy : .

# Seimas election results (etl/elections/). Candidate and party-list results are
# fragments of their contest document, so these views list them as table rows.

# The election that elected the term.
:TermElections a ldh:View ;
    dct:title "Rinkimai"@lt, "Elections"@en ;
    spin:query :SelectTermElections ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectTermElections a sp:Select ;
    rdfs:label "Select the election of the term" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?election
WHERE
  { GRAPH ?graph
      { ?election ltlod:electedTerm $about }
  }
""" ;
    rdfs:isDefinedBy : .

# The election's 71 constituency contests, filterable by the round that decided them.
:ElectionContests a ldh:View ;
    dct:title "Rinkimai apygardose"@lt, "Constituency contests"@en ;
    spin:query :SelectElectionContests ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectElectionContests a sp:Select ;
    rdfs:label "Select the election's constituency contests" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?contest
WHERE
  { GRAPH ?graph
      { ?contest ltlod:election $about ;
            ltlod:constituency ?constituency ;
            ltlod:decidedInRound ?decidedInRound
      }
  }
ORDER BY ?constituency
""" ;
    rdfs:isDefinedBy : .

# The contest held in a constituency (one: constituencies are per term).
:ConstituencyContests a ldh:View ;
    dct:title "Rinkimų rezultatai"@lt, "Election results"@en ;
    spin:query :SelectConstituencyContests ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectConstituencyContests a sp:Select ;
    rdfs:label "Select the contests held in the constituency" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?contest
WHERE
  { GRAPH ?graph
      { ?contest ltlod:constituency $about ;
            ltlod:election ?election
      }
  }
ORDER BY ?election
""" ;
    rdfs:isDefinedBy : .

# The person's results as a single-member candidate (self-nominated ones have no
# party, so the nominating party cannot be a required column).
:PersonCandidacies a ldh:View ;
    dct:title "Kandidatavimas vienmandatėse apygardose"@lt, "Single-member candidacies"@en ;
    spin:query :SelectPersonCandidacies ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPersonCandidacies a sp:Select ;
    rdfs:label "Select the person's candidate results" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?result
WHERE
  { GRAPH ?graph
      { ?result ltlod:candidate $about ;
            ltlod:contestRound ?round ;
            ltlod:votes ?votes ;
            ltlod:voteShare ?voteShare
      }
  }
ORDER BY ?round
""" ;
    rdfs:isDefinedBy : .

# The party's list vote in every constituency, strongest first.
:PartyListResults a ldh:View ;
    dct:title "Sąrašo rezultatai apygardose"@lt, "Party-list results by constituency"@en ;
    spin:query :SelectPartyListResults ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPartyListResults a sp:Select ;
    rdfs:label "Select the party's list results by constituency" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?result
WHERE
  { GRAPH ?graph
      { ?result ltlod:party $about ;
            ltlod:votes ?votes ;
            ltlod:voteShare ?voteShare
      }
  }
ORDER BY DESC(?voteShare)
""" ;
    rdfs:isDefinedBy : .

# Election rounds held on the day.
:DayElections a ldh:View ;
    dct:title "Rinkimai"@lt, "Elections"@en ;
    spin:query :SelectDayElections ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayElections a sp:Select ;
    rdfs:label "Select the election rounds held on the day" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?round
WHERE
  { GRAPH ?graph
      { ?round dct:temporal $about ;
            a ltlod:ElectionRound
      }
  }
""" ;
    rdfs:isDefinedBy : .

# VRK campaign finance (etl/elections/, campaign-finance/).

# The election's campaign participants, filterable by participant type.
:ElectionCampaigns a ldh:View ;
    dct:title "Politinės kampanijos dalyviai"@lt, "Campaign participants"@en ;
    spin:query :SelectElectionCampaigns ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectElectionCampaigns a sp:Select ;
    rdfs:label "Select the election's campaign participants" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?participant
WHERE
  { GRAPH ?graph
      { ?participant ltlod:inElection $about ;
            dct:type ?type
      }
  }
ORDER BY ?participant
""" ;
    rdfs:isDefinedBy : .

# A person's or party's campaign accounts, one per campaign.
:Campaigns a ldh:View ;
    dct:title "Politinių kampanijų finansai"@lt, "Campaign finance"@en ;
    spin:query :SelectCampaigns ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectCampaigns a sp:Select ;
    rdfs:label "Select the campaigns of the person or party" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?participant
WHERE
  { GRAPH ?graph
      { ?participant ltlod:campaignOf $about ;
            ltlod:campaignName ?campaign
      }
  }
ORDER BY DESC(?campaign)
""" ;
    rdfs:isDefinedBy : .

# The participant's income: legal-person contributions and natural-person totals,
# largest first, filterable by funding source.
:ParticipantIncome a ldh:View ;
    dct:title "Pajamos"@lt, "Income"@en ;
    spin:query :SelectParticipantIncome ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectParticipantIncome a sp:Select ;
    rdfs:label "Select the participant's income" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?income
WHERE
  { GRAPH ?graph
      { ?income ltlod:recipient $about ;
            dct:type ?source ;
            schema:value ?value
      }
  }
ORDER BY DESC(?value)
""" ;
    rdfs:isDefinedBy : .

# The participant's expenses, largest first, filterable by purpose.
:ParticipantExpenses a ldh:View ;
    dct:title "Išlaidos"@lt, "Expenses"@en ;
    spin:query :SelectParticipantExpenses ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectParticipantExpenses a sp:Select ;
    rdfs:label "Select the participant's expenses" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?expense
WHERE
  { GRAPH ?graph
      { ?expense ltlod:payer $about ;
            dct:type ?purpose ;
            schema:value ?value
      }
  }
ORDER BY DESC(?value)
""" ;
    rdfs:isDefinedBy : .

# A company's contributions to campaigns (a legal-entities/ page).
:CampaignDonationsMade a ldh:View ;
    dct:title "Įnašai į politines kampanijas"@lt, "Contributions to political campaigns"@en ;
    spin:query :SelectCampaignDonationsMade ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectCampaignDonationsMade a sp:Select ;
    rdfs:label "Select the organization's campaign contributions" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?donation
WHERE
  { GRAPH ?graph
      { ?donation ltlod:donor $about ;
            ltlod:recipient ?recipient ;
            dct:type ?source ;
            schema:value ?value
      }
  }
ORDER BY DESC(?value)
""" ;
    rdfs:isDefinedBy : .

# A company's paid services to campaigns (a legal-entities/ page).
:CampaignServicesProvided a ldh:View ;
    dct:title "Paslaugos politinėms kampanijoms"@lt, "Services to political campaigns"@en ;
    spin:query :SelectCampaignServicesProvided ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectCampaignServicesProvided a sp:Select ;
    rdfs:label "Select the organization's services to campaigns" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?expense
WHERE
  { GRAPH ?graph
      { ?expense ltlod:provider $about ;
            ltlod:payer ?payer ;
            dct:type ?purpose ;
            schema:value ?value
      }
  }
ORDER BY DESC(?value)
""" ;
    rdfs:isDefinedBy : .

