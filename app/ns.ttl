ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

:DayLobbying a ldh:View ;
    dct:title "Lobistinė veikla"@lt, "Lobbying"@en ;
    spin:query :SelectDayLobbying ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayLobbying a sp:Select ;
