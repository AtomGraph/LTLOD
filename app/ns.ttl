# LTLOD namespace ontology — the LinkedDataHub app ontology served at {base}ns.
# app/import-ns.sh prepends "@base <{base}ns> ." at install time, so the :
# prefix (<#>) resolves to the end-user namespace.
#
# 1:N views: <property> ldh:inverseView <View> surfaces the View block on every
# instance whose rdf:type matches the property's declared rdfs:range; LDH
# replaces $about in the sp:text query with the instance URI at render time.
# Multiple rdfs:range values are LDH view-discovery metadata, not strict OWL
# semantics (same approach as the northwind-traders demo app).
#
# ac:mode picks the layout LDH renders the projected entities with (ac:ListMode
# default, else Table/Grid/Map/…). Views that project image-bearing entities —
# persons (foaf:depiction portraits from lrs.lt) and admin units (Wikimedia
# photos/coats of arms via the Wikidata alignment) — use ac:GridMode so LDH lays
# them out as a thumbnail grid (bs2:ContainerGrid → foaf:depiction per card).
# Imageless targets (Seimas org-units) keep the default list.

@prefix :       <#> .
@prefix ldh:    <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix ac:     <https://w3id.org/atomgraph/client#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix sp:     <http://spinrdf.org/sp#> .
@prefix spin:   <http://spinrdf.org/spin#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix cv:     <http://data.europa.eu/m8g/> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix locn:   <http://www.w3.org/ns/locn#> .
@prefix ltlod:  <http://linkeddata.lt/ns#> .

: a owl:Ontology ;
    rdfs:label "LTLOD namespace" .

# classes

cv:AdminUnit a owl:Class ;
    rdfs:label "Administracinis vienetas"@lt, "Administrative unit"@en ;
    rdfs:isDefinedBy : .

cv:PublicOrganisation a owl:Class ;
    rdfs:label "Viešojo sektoriaus organizacija"@lt, "Public organisation"@en ;
    rdfs:isDefinedBy : .

org:OrganizationalUnit a owl:Class ;
    rdfs:label "Padalinys"@lt, "Organizational unit"@en ;
    rdfs:isDefinedBy : .

schema:PoliticalParty a owl:Class ;
    rdfs:label "Politinė partija"@lt, "Political party"@en ;
    rdfs:isDefinedBy : .

foaf:Person a owl:Class ;
    rdfs:label "Asmuo"@lt, "Person"@en ;
    rdfs:isDefinedBy : .

ltlod:ElectoralDistrict a owl:Class ;
    rdfs:label "Rinkimų apygarda"@lt, "Electoral district"@en ;
    rdfs:isDefinedBy : .

# properties

dct:isPartOf a owl:ObjectProperty ;
    rdfs:label "Priklauso vienetui"@lt, "Is part of"@en ;
    rdfs:range cv:AdminUnit ;
    ldh:inverseView :SubUnits ;
    rdfs:isDefinedBy : .

# A registered office's address points at its municipality (locn:Address ->
# locn:adminUnit -> admin-units/{sav}/#this); the inverse view lists the
# organizations registered in a given admin unit (legal-entities institutions.rq).
locn:adminUnit a owl:ObjectProperty ;
    rdfs:label "Administracinis vienetas"@lt, "Administrative unit"@en ;
    rdfs:range cv:AdminUnit ;
    ldh:inverseView :OrganizationsHere ;
    rdfs:isDefinedBy : .

org:organization a owl:ObjectProperty ;
    rdfs:label "Organizacija"@lt, "Organization"@en ;
    rdfs:range org:OrganizationalUnit, cv:PublicOrganisation ;
    ldh:inverseView :CurrentMembers, :FormerMembers ;
    rdfs:isDefinedBy : .

org:unitOf a owl:ObjectProperty ;
    rdfs:label "Padalinys organizacijoje"@lt, "Unit of"@en ;
    rdfs:range cv:PublicOrganisation ;
    ldh:inverseView :Units ;
    rdfs:isDefinedBy : .

ltlod:nominatedBy a owl:ObjectProperty ;
    rdfs:label "Iškelta partijos"@lt, "Nominated by"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range schema:PoliticalParty ;
    ldh:inverseView :NominatedMembers ;
    rdfs:isDefinedBy : .

# A single-member seat (org:Membership tenure) points at its electoral district;
# the inverse view lists the members elected in a given apygarda (persons.rq).
ltlod:electoralDistrict a owl:ObjectProperty ;
    rdfs:label "Rinkimų apygarda"@lt, "Electoral district"@en ;
    rdfs:range ltlod:ElectoralDistrict ;
    ldh:inverseView :MembersElectedHere ;
    rdfs:isDefinedBy : .

# org:member points from an n-ary org:Membership to the person; its inverse view
# gathers a person's memberships into one table (rdfs:range foaf:Person is the
# view-discovery hint — LDH surfaces :Memberships on every foaf:Person instance).
org:member a owl:ObjectProperty ;
    rdfs:label "Narys"@lt, "Member"@en ;
    rdfs:domain org:Membership ;
    rdfs:range foaf:Person ;
    ldh:inverseView :Memberships ;
    rdfs:isDefinedBy : .

# org:role / org:memberDuring carry no view but are labelled so the memberships
# table (files/client.xsl) shows Lithuanian column headers next to org:organization.
org:role a owl:ObjectProperty ;
    rdfs:label "Pareigos"@lt, "Role"@en ;
    rdfs:isDefinedBy : .

org:memberDuring a owl:ObjectProperty ;
    rdfs:label "Laikotarpis"@lt, "During"@en ;
    rdfs:isDefinedBy : .

# views
# Territorial hierarchy: children point up via dct:isPartOf, every parent is a
# cv:AdminUnit, so one view covers county→municipalities, municipality→
# elderships, eldership→settlements and settlement→streets.

:SubUnits a ldh:View ;
    dct:title "Sudedamieji vienetai"@lt, "Constituent units"@en ;
    spin:query :SelectSubUnits ;
    ac:mode ac:GridMode ;
    rdfs:isDefinedBy : .

:SelectSubUnits a sp:Select ;
    rdfs:label "Select sub-units" ;
    sp:text """
PREFIX dct: <http://purl.org/dc/terms/>

SELECT DISTINCT ?unit
WHERE
  { GRAPH ?graph
      { ?unit dct:isPartOf $about }
  }
ORDER BY ?unit
""" ;
    rdfs:isDefinedBy : .

# Organizations whose registered office resolves to this admin unit. Imageless
# targets (legal entities) keep the default list layout.

:OrganizationsHere a ldh:View ;
    dct:title "Čia registruotos organizacijos"@lt, "Organizations registered here"@en ;
    spin:query :SelectOrganizationsHere ;
    rdfs:isDefinedBy : .

:SelectOrganizationsHere a sp:Select ;
    rdfs:label "Select organizations registered in this admin unit" ;
    sp:text """
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX locn: <http://www.w3.org/ns/locn#>

SELECT DISTINCT ?org
WHERE
  { GRAPH ?graph
      { ?org org:hasRegisteredSite/org:siteAddress/locn:adminUnit $about }
  }
ORDER BY ?org
""" ;
    rdfs:isDefinedBy : .

# Memberships are n-ary org:Membership fragments in the person's graph; the
# interval lives in the same graph, so one GRAPH block suffices. Current
# membership = org:memberDuring interval without time:hasEnd. A person with an
# ended stint and a current one appears in both lists — accepted.

:CurrentMembers a ldh:View ;
    dct:title "Dabartiniai nariai"@lt, "Current members"@en ;
    spin:query :SelectCurrentMembers ;
    ac:mode ac:GridMode ;
    rdfs:isDefinedBy : .

:SelectCurrentMembers a sp:Select ;
    rdfs:label "Select current members" ;
    sp:text """
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX time: <http://www.w3.org/2006/time#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:organization $about ;
            org:member ?person ;
            org:memberDuring ?interval
        FILTER NOT EXISTS { ?interval time:hasEnd ?end }
      }
  }
ORDER BY ?person
""" ;
    rdfs:isDefinedBy : .

:FormerMembers a ldh:View ;
    dct:title "Buvę nariai"@lt, "Former members"@en ;
    spin:query :SelectFormerMembers ;
    ac:mode ac:GridMode ;
    rdfs:isDefinedBy : .

:SelectFormerMembers a sp:Select ;
    rdfs:label "Select former members" ;
    sp:text """
PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX time: <http://www.w3.org/2006/time#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:organization $about ;
            org:member ?person ;
            org:memberDuring/time:hasEnd ?end }
  }
ORDER BY ?person
""" ;
    rdfs:isDefinedBy : .

:Units a ldh:View ;
    dct:title "Padaliniai"@lt, "Units"@en ;
    spin:query :SelectUnits ;
    rdfs:isDefinedBy : .

:SelectUnits a sp:Select ;
    rdfs:label "Select organizational units" ;
    sp:text """
PREFIX org: <http://www.w3.org/ns/org#>

SELECT DISTINCT ?unit
WHERE
  { GRAPH ?graph
      { ?unit org:unitOf $about }
  }
ORDER BY ?unit
""" ;
    rdfs:isDefinedBy : .

:NominatedMembers a ldh:View ;
    dct:title "Iškelti Seimo nariai"@lt, "Nominated members of the Seimas"@en ;
    spin:query :SelectNominatedMembers ;
    ac:mode ac:GridMode ;
    rdfs:isDefinedBy : .

:SelectNominatedMembers a sp:Select ;
    rdfs:label "Select persons nominated by party" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?person ltlod:nominatedBy $about }
  }
ORDER BY ?person
""" ;
    rdfs:isDefinedBy : .

# Members elected in this electoral district: the single-member seat membership
# (org:Membership) carries ltlod:electoralDistrict; persons have photos -> grid.

:MembersElectedHere a ldh:View ;
    dct:title "Šioje apygardoje išrinkti Seimo nariai"@lt, "Members elected in this district"@en ;
    spin:query :SelectMembersElectedHere ;
    ac:mode ac:GridMode ;
    rdfs:isDefinedBy : .

:SelectMembersElectedHere a sp:Select ;
    rdfs:label "Select members elected in this district" ;
    sp:text """
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX ltlod: <http://linkeddata.lt/ns#>

SELECT DISTINCT ?person
WHERE
  { GRAPH ?graph
      { ?membership org:member ?person ;
            ltlod:electoralDistrict $about }
  }
ORDER BY ?person
""" ;
    rdfs:isDefinedBy : .

# A person's positions and memberships as one table (replaces the ~30 raw
# org:Membership blocks, which the client-side XSLT override suppresses). LDH
# renders a view by DESCRIBE-ing the projected term, so project only the
# membership URI: the table columns become its predicates (org:role,
# org:organization resolve to links; org:memberDuring shows the interval's
# dct:title period from the persons.rq mapping).

:Memberships a ldh:View ;
    dct:title "Pareigos ir narystės"@lt, "Positions and memberships"@en ;
    spin:query :SelectMemberships ;
    ac:mode ac:TableMode ;
    rdfs:isDefinedBy : .

:SelectMemberships a sp:Select ;
    rdfs:label "Select the person's memberships" ;
    sp:text """
PREFIX org: <http://www.w3.org/ns/org#>

SELECT DISTINCT ?membership
WHERE
  { GRAPH ?graph
      { ?membership a org:Membership ;
            org:member $about }
  }
ORDER BY ?membership
""" ;
    rdfs:isDefinedBy : .
