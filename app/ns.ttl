      }
  }
ORDER BY ?name
""" ;
    rdfs:isDefinedBy : .

# The members of a heritage complex (schema:containedInPlace).
:ComplexParts a ldh:View ;
    dct:title "Komplekso dalys"@lt, "Parts of the complex"@en ;
    spin:query :SelectComplexParts ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectComplexParts a sp:Select ;
