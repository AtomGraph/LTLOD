# Facilities whose register period (education, heritage) or health-care licence began
# or ended on the day — reached through the period's time:Instant (same document).
:DayFacilityRegistrations a ldh:View ;
    dct:title "Įregistruotos ar išregistruotos įstaigos ir objektai"@lt, "Facilities registered or deregistered"@en ;
    spin:query :SelectDayFacilityRegistrations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayFacilityRegistrations a sp:Select ;
    rdfs:label "Select the facilities registered, licensed or deregistered on the day" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX schema: <https://schema.org/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?facility
WHERE
  { GRAPH ?graph
      { ?instant dct:temporal $about .
        { ?facility a schema:EducationalOrganization ;
              time:hasTime/(time:hasBeginning|time:hasEnd) ?instant }
        UNION
        { ?facility a schema:LandmarksOrHistoricalBuildings ;
              time:hasTime/time:hasBeginning ?instant }
        UNION
        { ?facility a schema:MedicalOrganization ;
              ltlod:licence/time:hasTime/time:hasBeginning ?instant }
      }
  }
ORDER BY ?facility
""" ;
    rdfs:isDefinedBy : .

# Public procurement contracts of an organisation, newest first: as the buyer, and as a
# contractor. The role is reached by a path from the projected ?contract (the role node
# itself would otherwise become a useless facet pill); the nature (goods/services/works)
# is the filter pill and the conclusion date the sort column.
:ContractsAsBuyer a ldh:View ;
    dct:title "Pirkimų sutartys (perkančioji organizacija)"@lt, "Procurement contracts (as buyer)"@en ;
    spin:query :SelectContractsAsBuyer ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectContractsAsBuyer a sp:Select ;
    rdfs:label "Select the organisation's procurement contracts as buyer" ;
    sp:text """
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX epo: <http://data.europa.eu/a4g/ontology#>
SELECT DISTINCT ?contract
WHERE
  { GRAPH ?graph
      { ?contract epo:bindsBuyer/epo:playedBy $about ;
            epo:hasContractConclusionDate ?date ;
            dct:type ?nature
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

:ContractsAsContractor a ldh:View ;
    dct:title "Pirkimų sutartys (tiekėjas)"@lt, "Procurement contracts (as contractor)"@en ;
    spin:query :SelectContractsAsContractor ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectContractsAsContractor a sp:Select ;
    rdfs:label "Select the organisation's procurement contracts as contractor" ;
    sp:text """
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX epo: <http://data.europa.eu/a4g/ontology#>
SELECT DISTINCT ?contract
WHERE
  { GRAPH ?graph
      { ?contract epo:bindsContractor/epo:playedBy $about ;
            epo:hasContractConclusionDate ?date ;
            dct:type ?nature
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# The procurement contracts concluded on the day.
:DayContracts a ldh:View ;
    dct:title "Pirkimų sutartys"@lt, "Procurement contracts"@en ;
    spin:query :SelectDayContracts ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayContracts a sp:Select ;
    rdfs:label "Select the procurement contracts concluded on the day" ;
    sp:text """
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX epo: <http://data.europa.eu/a4g/ontology#>
SELECT DISTINCT ?contract
WHERE
  { GRAPH ?graph
      { ?contract dct:temporal $about ;
            a epo:Contract ;
            dct:type ?nature ;
            dct:title ?title
      }
  }
ORDER BY ?title
""" ;
    rdfs:isDefinedBy : .

# VTEK lobbying views (etl/vtek/). Declarations sort newest lobbying date first; the
# date is on the declaration itself, so it can be the sort column.

:LobbyistDeclarations a ldh:View ;
    dct:title "Lobistinės veiklos deklaracijos"@lt, "Lobbying declarations"@en ;
    spin:query :SelectLobbyistDeclarations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectLobbyistDeclarations a sp:Select ;
    rdfs:label "Select the lobbyist's declarations" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?declaration
WHERE
  { GRAPH ?graph
      { ?declaration ltlod:lobbyist $about ;
            ltlod:activityDate ?date
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# on a legal entity or person: their lobbyist register entry (ltlod:agent)
:AgentLobbyistRegistrations a ldh:View ;
    dct:title "Lobistų sąraše"@lt, "In the lobbyist register"@en ;
    spin:query :SelectAgentLobbyistRegistrations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectAgentLobbyistRegistrations a sp:Select ;
    rdfs:label "Select the lobbyist register entries of this agent" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?lobbyist
WHERE
  { GRAPH ?graph
      { ?lobbyist ltlod:agent $about }
  }
ORDER BY ?lobbyist
""" ;
    rdfs:isDefinedBy : .

# a person named as lobbied in a declaration (the contact fragment is in the
# declaration's own graph, so one GRAPH block suffices)
:PersonLobbiedBy a ldh:View ;
    dct:title "Patirta lobistinė įtaka"@lt, "Lobbied by"@en ;
    spin:query :SelectPersonLobbiedBy ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectPersonLobbiedBy a sp:Select ;
    rdfs:label "Select the lobbying declarations naming the person" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?declaration
WHERE
  { GRAPH ?graph
      { ?declaration ltlod:contact ?contact ;
            ltlod:activityDate ?date ;
            ltlod:lobbyist ?lobbyist .
        ?contact ltlod:influencedPerson $about
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

:InstitutionLobbiedBy a ldh:View ;
    dct:title "Lobistinė veikla"@lt, "Lobbying"@en ;
    spin:query :SelectInstitutionLobbiedBy ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectInstitutionLobbiedBy a sp:Select ;
    rdfs:label "Select the lobbying declarations naming the institution" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?declaration
WHERE
  { GRAPH ?graph
      { ?declaration ltlod:contact ?contact ;
            ltlod:activityDate ?date ;
            ltlod:lobbyist ?lobbyist .
        ?contact ltlod:institution $about
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# a Seimas bill (etl/seimas bills) -> the lobbying declarations that cite it
