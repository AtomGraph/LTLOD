SELECT DISTINCT ?part
WHERE
  { GRAPH ?graph
      { ?part schema:containedInPlace $about ;
            ltlod:protectionStatus ?status ;
            skos:prefLabel ?name
      }
  }
ORDER BY ?name
""" ;
    rdfs:isDefinedBy : .

