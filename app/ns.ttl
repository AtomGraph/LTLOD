# --- facility registers (etl/facilities/) ---
#
# Facilities in an admin unit (locn:adminUnit on the facility's address — a
# municipality, eldership or settlement). Schools carry WGS84 points, so their view
# defaults to the map; only institutions still on the register (no time:hasEnd).
# Each view's facet column is the facility's own type/status concept.

:EducationHere a ldh:View ;
    dct:title "Švietimo įstaigos"@lt, "Educational institutions"@en ;
    spin:query :SelectEducationHere ;
    ac:mode ac:MapMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectEducationHere a sp:Select ;
    rdfs:label "Select the active educational institutions in this admin unit" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX locn:   <http://www.w3.org/ns/locn#>
PREFIX schema: <https://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX time:   <http://www.w3.org/2006/time#>
SELECT DISTINCT ?institution
WHERE
  { GRAPH ?graph
      { ?institution a schema:EducationalOrganization ;
            locn:address/locn:adminUnit $about ;
            dct:type ?type ;
            skos:prefLabel ?name ;
            time:hasTime ?registration
        FILTER NOT EXISTS { ?registration time:hasEnd ?end }
      }
  }
ORDER BY ?name
""" ;
    rdfs:isDefinedBy : .

:HealthCareHere a ldh:View ;
    dct:title "Sveikatos priežiūros įstaigos"@lt, "Health-care institutions"@en ;
    spin:query :SelectHealthCareHere ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectHealthCareHere a sp:Select ;
    rdfs:label "Select the licensed health-care institutions with an activity address in this admin unit" ;
    sp:text """
PREFIX org:    <http://www.w3.org/ns/org#>
PREFIX rov:    <http://www.w3.org/ns/regorg#>
PREFIX locn:   <http://www.w3.org/ns/locn#>
PREFIX schema: <https://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?institution
WHERE
  { GRAPH ?graph
      { ?institution a schema:MedicalOrganization ;
            org:hasSite/org:siteAddress/locn:adminUnit $about ;
            rov:companyType ?form ;
            skos:prefLabel ?name
      }
  }
ORDER BY ?name
""" ;
    rdfs:isDefinedBy : .

:HeritageHere a ldh:View ;
    dct:title "Kultūros paveldas"@lt, "Cultural heritage"@en ;
    spin:query :SelectHeritageHere ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectHeritageHere a sp:Select ;
    rdfs:label "Select the cultural heritage objects in this admin unit" ;
    sp:text """
PREFIX locn:   <http://www.w3.org/ns/locn#>
PREFIX schema: <https://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?object
WHERE
  { GRAPH ?graph
      { ?object a schema:LandmarksOrHistoricalBuildings ;
            locn:address/locn:adminUnit $about ;
            ltlod:protectionStatus ?status ;
            skos:prefLabel ?name
      }
  }
ORDER BY ?name
""" ;
    rdfs:isDefinedBy : .

# The schools and health-care institutions a legal entity runs (ltlod:legalEntity).
:LegalEntityFacilities a ldh:View ;
    dct:title "Įstaigos"@lt, "Facilities"@en ;
    spin:query :SelectLegalEntityFacilities ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectLegalEntityFacilities a sp:Select ;
    rdfs:label "Select the facilities run by the legal entity" ;
