    rdfs:isDefinedBy : .

:DayLobbyistRegistrations a ldh:View ;
    dct:title "Įrašyti į lobistų sąrašą"@lt, "Lobbyists registered"@en ;
    spin:query :SelectDayLobbyistRegistrations ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayLobbyistRegistrations a sp:Select ;
    rdfs:label "Select the lobbyists registered on the day" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?lobbyist
WHERE
  { GRAPH ?graph
      { ?lobbyist dct:temporal $about ;
            a ltlod:Lobbyist
      }
  }
ORDER BY ?lobbyist
""" ;
    rdfs:isDefinedBy : .

# VTEK private-interest views. Ties are n-ary org:Membership fragments of the
# declaration's graph; tables project the tie, so its columns are its predicates
# (member, role, legal entity, period, procurement flag).

:InterestedOfficials a ldh:View ;
    dct:title "Deklaravę ryšį su šiuo juridiniu asmeniu"@lt, "Officials who declared a tie"@en ;
    spin:query :SelectInterestedOfficials ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectInterestedOfficials a sp:Select ;
    rdfs:label "Select the declared ties to the legal entity" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>
SELECT DISTINCT ?tie
WHERE
  { GRAPH ?graph
      { ?tie ltlod:interestOrganization $about ;
            org:role ?role ;
            org:member ?member
      }
  }
ORDER BY ?role
""" ;
    rdfs:isDefinedBy : .

:DeclaredTies a ldh:View ;
    dct:title "Darbovietės ir ryšiai su juridiniais asmenimis"@lt, "Workplaces and ties to legal entities"@en ;
    spin:query :SelectDeclaredTies ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDeclaredTies a sp:Select ;
    rdfs:label "Select the declaration's ties" ;
    sp:text """
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>
SELECT DISTINCT ?tie
WHERE
  { GRAPH ?graph
      { ?tie ltlod:declaredIn $about ;
            org:role ?role
      }
  }
ORDER BY ?role
""" ;
    rdfs:isDefinedBy : .

# ties that began or ended on the day (through the interval's instants)
:DayInterestTies a ldh:View ;
    dct:title "Deklaruoti ryšiai su juridiniais asmenimis"@lt, "Declared ties to legal entities"@en ;
    spin:query :SelectDayInterestTies ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayInterestTies a sp:Select ;
    rdfs:label "Select the declared ties that began or ended on the day" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX time:  <http://www.w3.org/2006/time#>
SELECT DISTINCT ?tie
WHERE
  { GRAPH ?graph
      { ?tie ltlod:declaredIn ?declaration ;
            org:role ?role ;
            org:memberDuring ?interval .
          { ?interval time:hasBeginning ?instant }
        UNION
          { ?interval time:hasEnd ?instant }
        ?instant dct:temporal $about
      }
  }
ORDER BY ?role
""" ;
    rdfs:isDefinedBy : .

# Sodra employer data (etl/sodra/). An organisation's figures, newest month first
# (ltlod:employer -> the legal entity: the summary observation, plus the monthly series
# when built with SODRA_CUBE=1), and a calendar month's employers, largest
# headcount first, filterable by municipality (dct:temporal -> the month document; the
# view stays hidden on days and years, which no observation points at). The month view
# lists SUMMARY observations only (ltlod:monthsReported): an employer's summary points at
# its latest month, so the view shows on the latest month (and, for employers that
# stopped reporting, their last month), and the monthly series never lists an employer
# twice. Without the cube, earlier months have no employers view at all.
:EmployerObservations a ldh:View ;
    dct:title "Apdraustieji ir darbo užmokestis (Sodra)"@lt, "Insured persons and wages (Sodra)"@en ;
    spin:query :SelectEmployerObservations ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectEmployerObservations a sp:Select ;
    rdfs:label "Select the employer's observations" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX qb:    <http://purl.org/linked-data/cube#>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?observation
WHERE
  { GRAPH ?graph
      { ?observation ltlod:employer $about ;
            a qb:Observation ;
            dct:date ?month
      }
  }
ORDER BY DESC(?month)
""" ;
    rdfs:isDefinedBy : .

:MonthEmployers a ldh:View ;
    dct:title "Darbdaviai (Sodra)"@lt, "Employers (Sodra)"@en ;
    spin:query :SelectMonthEmployers ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectMonthEmployers a sp:Select ;
    rdfs:label "Select the month's employer observations" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX qb:    <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?observation
WHERE
  { GRAPH ?graph
      { ?observation dct:temporal $about ;
            a qb:Observation ;
            ltlod:monthsReported ?months ;
            ltlod:insuredCount ?insured ;
            sdmx-dimension:refArea ?area
      }
  }
ORDER BY DESC(?insured)
""" ;
    rdfs:isDefinedBy : .

# --- NŽT land-acquisition applications (etl/land-acquisitions/) ---

# a legal entity's applications to acquire agricultural or forest land, newest first,
# filterable by land purpose
:LandApplications a ldh:View ;
    dct:title "Prašymai įsigyti žemės ūkio ar miškų ūkio paskirties žemę"@lt, "Applications to acquire agricultural or forest land"@en ;
    spin:query :SelectLandApplications ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectLandApplications a sp:Select ;
    rdfs:label "Select the legal entity's land-acquisition applications" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?application
WHERE
  { GRAPH ?graph
      { ?application ltlod:applicant $about ;
            dct:date ?date ;
            dct:type ?purpose
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# legal entities' applications for land in this municipality, newest first, filterable by
# land purpose and by how the published name agrees with the code
:MunicipalityLandApplications a ldh:View ;
    dct:title "Juridinių asmenų prašymai įsigyti žemės"@lt, "Legal entities' land-acquisition applications"@en ;
    spin:query :SelectMunicipalityLandApplications ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectMunicipalityLandApplications a sp:Select ;
    rdfs:label "Select the legal entities' land-acquisition applications in the municipality" ;
    sp:text """
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
SELECT DISTINCT ?application
WHERE
  { GRAPH ?graph
      { ?application schema:location $about ;
            dct:date ?date ;
            dct:type ?purpose ;
            ltlod:applicantCheck ?check
      }
  }
ORDER BY DESC(?date)
""" ;
    rdfs:isDefinedBy : .

# the applications submitted on the day
:DayLandApplications a ldh:View ;
    dct:title "Pateikti prašymai įsigyti žemės"@lt, "Land-acquisition applications submitted"@en ;
    spin:query :SelectDayLandApplications ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayLandApplications a sp:Select ;
    rdfs:label "Select the land-acquisition applications submitted on the day" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?application
WHERE
  { GRAPH ?graph
      { ?application dct:temporal $about ;
            a ltlod:LandAcquisitionApplication ;
            dct:type ?purpose
      }
  }
ORDER BY ?application
""" ;
    rdfs:isDefinedBy : .

# the applications NŽT decided on the day (the decision is a fragment of its application's
# document, so one GRAPH block reaches the application)
:DayLandDecisions a ldh:View ;
    dct:title "NŽT sprendimai dėl žemės įsigijimo"@lt, "NŽT land-acquisition decisions"@en ;
    spin:query :SelectDayLandDecisions ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectDayLandDecisions a sp:Select ;
    rdfs:label "Select the land-acquisition applications decided on the day" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?application
WHERE
  { GRAPH ?graph
      { ?decision dct:temporal $about ;
            a ltlod:LandAcquisitionDecision .
        ?application ltlod:decision ?decision ;
            dct:type ?purpose
      }
  }
ORDER BY ?application
""" ;
    rdfs:isDefinedBy : .

# natural persons' applications in the year, per municipality and land purpose
:YearLandTotals a ldh:View ;
    dct:title "Fizinių asmenų prašymai įsigyti žemės"@lt, "Natural persons' land-acquisition applications"@en ;
    spin:query :SelectYearLandTotals ;
    ac:mode ac:TableMode ;
    ldh:showWhenEmpty false ;
    rdfs:isDefinedBy : .

:SelectYearLandTotals a sp:Select ;
    rdfs:label "Select the natural-person land-acquisition totals of the year" ;
    sp:text """
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX qb:    <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX ltlod: <http://linkeddata.lt/ns#>
SELECT DISTINCT ?observation
WHERE
  { GRAPH ?graph
      { ?observation dct:temporal $about ;
            a qb:Observation ;
            ltlod:applicationCount ?applications ;
            dct:type ?purpose
      }
  }
ORDER BY DESC(?applications)
""" ;
    rdfs:isDefinedBy : .
