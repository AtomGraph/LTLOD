PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?facility
WHERE
  { GRAPH ?graph
      { ?facility ltlod:legalEntity $about ;
            skos:prefLabel ?name
      }
  }
ORDER BY ?name
""" ;
    rdfs:isDefinedBy : .

# A school's branches (org:subOrganizationOf).
:Branches a ldh:View ;
    dct:title "Skyriai"@lt, "Branches"@en ;
    spin:query :SelectBranches ;
    ac:mode ac:MapMode ;
    ldh:showWhenEmpty false ;
