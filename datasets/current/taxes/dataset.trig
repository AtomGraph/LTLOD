PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dh: <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<taxes/dataset/> {
    <taxes/dataset/#component-taxes-paid>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:taxesPaid .
    <taxes/dataset/#component-deferred-overdue>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:deferredOverdueArrears .
    <taxes/dataset/#component-deferred>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:deferredArrears .
    <taxes/dataset/#component-overdue>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:overdueArrears .
    <taxes/dataset/#component-arrears>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:arrears .
    <taxes/dataset/#component-area>
            a             qb:ComponentSpecification;
            qb:dimension  sdmx-dimension:refArea;
            qb:order      3 .
    <taxes/dataset/#component-temporal>
            a             qb:ComponentSpecification;
            qb:dimension  dct:temporal;
            qb:order      2 .
    <taxes/dataset/#component-taxpayer>
            a             qb:ComponentSpecification;
            qb:dimension  ltlod:taxpayer;
            qb:order      1 .
    <taxes/dataset/#paid-structure>
            a             qb:DataStructureDefinition;
            qb:component  <taxes/dataset/#component-taxes-paid>;
            qb:component  <taxes/dataset/#component-temporal>;
            qb:component  <taxes/dataset/#component-taxpayer> .
    <taxes/dataset/#structure>
            a             qb:DataStructureDefinition;
            qb:component  <taxes/dataset/#component-deferred-overdue>;
            qb:component  <taxes/dataset/#component-deferred>;
            qb:component  <taxes/dataset/#component-overdue>;
            qb:component  <taxes/dataset/#component-arrears>;
            qb:component  <taxes/dataset/#component-area>;
            qb:component  <taxes/dataset/#component-temporal>;
            qb:component  <taxes/dataset/#component-taxpayer> .
    <taxes/dataset/#paid>
            a                qb:DataSet;
            dct:description  "Kiekvieno juridinio asmens per metus sumokėtų mokesčių suma (EUR), kaip ją skelbia Valstybinė mokesčių inspekcija. Vienas stebėjimas vienam juridiniam asmeniui ir kalendoriniams metams."@lt;
            dct:source       <https://get.data.gov.lt/datasets/gov/vmi/ja_mokesciai>;
            dct:title        "VMI: taxes paid by legal entities"@en;
            dct:title        "VMI: juridinių asmenų sumokėti mokesčiai"@lt;
            qb:structure     <taxes/dataset/#paid-structure> .
    <taxes/dataset/#this>
            a                qb:DataSet;
            dct:description  "Kiekvieno juridinio asmens, turinčio mokestinę nepriemoką, Valstybinei mokesčių inspekcijai skelbiama nepriemokos suma (EUR): bendra, pradelsta, atidėta ir atidėta pradelsta, kartu su registracijos savivaldybe ir snapšoto data. Vienas stebėjimas vienam juridiniam asmeniui — tai kiekvieno mokesčių mokėtojo dokumento pagrindinis objektas."@lt;
            dct:source       <https://get.data.gov.lt/datasets/gov/vmi/ja_nepriemokos>;
            dct:title        "VMI: tax arrears of legal entities"@en;
            dct:title        "VMI: juridinių asmenų mokesčių nepriemokos"@lt;
            qb:structure     <taxes/dataset/#structure> .
    <taxes/dataset/>  a         dh:Item;
            dct:created         "2026-10-25T12:46:34.346+01:00"^^xsd:dateTime;
            dct:title           "VMI: juridinių asmenų mokesčių nepriemokos"@lt;
            sioc:has_container  <taxes/>;
            foaf:primaryTopic   <taxes/dataset/#this> .
}
