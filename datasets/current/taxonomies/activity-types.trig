PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dh: <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<taxonomies/activity-types/neeiline-sesija/> {
    <taxonomies/activity-types/neeiline-sesija/#this>
            rdf:type           eli-dl:ActivityType;
            rdf:type           skos:Concept;
            skos:inScheme      <taxonomies/activity-types/#this>;
            skos:notation      "neeiline-sesija";
            skos:prefLabel     "Neeilinė sesija"@lt;
            skos:topConceptOf  <taxonomies/activity-types/#this> .
    <taxonomies/activity-types/neeiline-sesija/>
            rdf:type            dh:Item;
            dct:title           "Neeilinė sesija"@lt;
            sioc:has_container  <taxonomies/activity-types/>;
            foaf:primaryTopic   <taxonomies/activity-types/neeiline-sesija/#this> .
}

<taxonomies/activity-types/eiline-sesija/> {
    <taxonomies/activity-types/eiline-sesija/#this>
            rdf:type           eli-dl:ActivityType;
            rdf:type           skos:Concept;
            skos:inScheme      <taxonomies/activity-types/#this>;
            skos:notation      "eiline-sesija";
            skos:prefLabel     "Eilinė sesija"@lt;
            skos:topConceptOf  <taxonomies/activity-types/#this> .
    <taxonomies/activity-types/eiline-sesija/>
            rdf:type            dh:Item;
            dct:title           "Eilinė sesija"@lt;
            sioc:has_container  <taxonomies/activity-types/>;
            foaf:primaryTopic   <taxonomies/activity-types/eiline-sesija/#this> .
}
