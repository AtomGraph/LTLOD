PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dh: <https://www.w3.org/ns/ldt/document-hierarchy#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sioc: <http://rdfs.org/sioc/ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<taxonomies/org-unit-types/valdyba/> {
    <taxonomies/org-unit-types/valdyba/#this>
            a                  skos:Concept;
            skos:inScheme      <taxonomies/org-unit-types/#this>;
            skos:notation      "valdyba";
            skos:prefLabel     "Board"@en;
            skos:prefLabel     "Valdyba"@lt;
            skos:topConceptOf  <taxonomies/org-unit-types/#this> .
    <taxonomies/org-unit-types/valdyba/>
            a                   dh:Item;
            dct:title           "Valdyba"@lt;
            sioc:has_container  <taxonomies/org-unit-types/>;
            foaf:primaryTopic   <taxonomies/org-unit-types/valdyba/#this> .
}

