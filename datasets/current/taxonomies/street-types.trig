PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dh: <https://www.w3.org/ns/ldt/document-hierarchy#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sioc: <http://rdfs.org/sioc/ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<taxonomies/street-types/skveras/> {
    <taxonomies/street-types/skveras/#this>
            a                  skos:Concept;
            skos:inScheme      <taxonomies/street-types/#this>;
            skos:notation      "skveras";
            skos:prefLabel     "Public garden"@en;
            skos:prefLabel     "Skveras"@lt;
            skos:topConceptOf  <taxonomies/street-types/#this> .
    <taxonomies/street-types/skveras/>
            a                   dh:Item;
            dct:title           "Skveras"@lt;
            sioc:has_container  <taxonomies/street-types/>;
            foaf:primaryTopic   <taxonomies/street-types/skveras/#this> .
}

