PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dh: <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

<land-acquisitions/natural-persons/> {
    <land-acquisitions/natural-persons/#component-consented>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:consentedArea .
    <land-acquisitions/natural-persons/#component-applied>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:appliedArea .
    <land-acquisitions/natural-persons/#component-refusals>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:refusalCount .
    <land-acquisitions/natural-persons/#component-consents>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:consentCount .
    <land-acquisitions/natural-persons/#component-applications>
            a           qb:ComponentSpecification;
            qb:measure  ltlod:applicationCount .
    <land-acquisitions/natural-persons/#component-purpose>
            a             qb:ComponentSpecification;
            qb:dimension  dct:type;
            qb:order      3 .
    <land-acquisitions/natural-persons/#component-year>
            a             qb:ComponentSpecification;
            qb:dimension  dct:temporal;
            qb:order      2 .
    <land-acquisitions/natural-persons/#component-area>
            a             qb:ComponentSpecification;
            qb:dimension  sdmx-dimension:refArea;
            qb:order      1 .
    <land-acquisitions/natural-persons/#structure>
            a             qb:DataStructureDefinition;
            qb:component  <land-acquisitions/natural-persons/#component-consented>;
            qb:component  <land-acquisitions/natural-persons/#component-applied>;
            qb:component  <land-acquisitions/natural-persons/#component-refusals>;
            qb:component  <land-acquisitions/natural-persons/#component-consents>;
            qb:component  <land-acquisitions/natural-persons/#component-applications>;
            qb:component  <land-acquisitions/natural-persons/#component-purpose>;
            qb:component  <land-acquisitions/natural-persons/#component-year>;
            qb:component  <land-acquisitions/natural-persons/#component-area> .
    <land-acquisitions/natural-persons/#this>
            a                qb:DataSet;
            dct:description  "Fizinių asmenų (taip pat sutuoktinių ir užsieniečių) prašymai, kuriuos Nacionalinė žemės tarnyba gavo pagal Žemės ūkio paskirties žemės įsigijimo įstatymą, suskaičiuoti pagal savivaldybę, pateikimo metus ir žemės paskirtį: prašymų, sutikimų ir atmestų prašymų skaičius, prašomas ir sutikimais leistas įsigyti plotas (ha). Pavieniai pareiškėjai neskelbiami: NŽT jų kodus ir vardus užšifruoja, o mažiau nei 3 prašymų langeliai praleidžiami."@lt;
            dct:source       <https://get.data.gov.lt/datasets/gov/nzt/paraiskos/Paraiska>;
            dct:title        "Natural persons' applications to acquire agricultural and forest land"@en;
            dct:title        "Fizinių asmenų prašymai įsigyti žemės ūkio ir miškų ūkio paskirties žemę"@lt;
            qb:structure     <land-acquisitions/natural-persons/#structure> .
    <land-acquisitions/natural-persons/>
            a                   dh:Item;
            dct:created         "2026-10-20T22:06:17.172+02:00"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
            dct:title           "Fizinių asmenų prašymai įsigyti žemės ūkio ir miškų ūkio paskirties žemę"@lt;
            sioc:has_container  <land-acquisitions/>;
            foaf:primaryTopic   <land-acquisitions/natural-persons/#this> .
}
