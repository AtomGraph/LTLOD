# The .env of the production deployment on the shared host (kgdev.net): copy to .env there.
# Keep everything prod-specific here, not in .env - BASE_URI is derived from PROTOCOL, HOST and HTTPS_PORT.
COMPOSE_PROJECT_NAME=ltlod
# docker-compose.prod.yml: nginx stubbed out behind nginx-shared, prod memory limits
# prod runs the compose default (docker-compose.yml + docker-compose.override.yml); on the server
# docker-compose.override.yml is a copy of the repo's self-contained docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml

PROTOCOL=https
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_CLIENT_CERT_PORT=5443
HOST=linkeddata.lt

# the secret nginx sends to the platform with every request; required. `make secrets` appends one, or use `openssl rand -hex 32`
# PROXY_SECRET=

OWNER_MBOX=martynas@atomgraph.com
OWNER_GIVEN_NAME=Martynas
OWNER_FAMILY_NAME=Jusevičius
OWNER_ORG_UNIT=LTLOD
OWNER_ORGANIZATION=AtomGraph
OWNER_LOCALITY=Copenhagen
OWNER_STATE_OR_PROVINCE=Denmark
OWNER_COUNTRY_NAME=DK

MAX_CONTENT_LENGTH=4194304

OPENAI_MODEL=gpt-5.5
# starts the web-algebra sidecar, and makes the UI offer the assistant
# the assistant is off in prod (docker-compose.prod.yml keeps web-algebra from starting regardless)
# COMPOSE_PROFILES=assistant

# serves each dataspace's /sitemap.xml and lets robots.txt allow crawling; off unless set
ENABLE_SITEMAP=true

# the longest result, in bytes, the /sparql endpoint answers a query with; a longer one is refused with 502. Counted on the
# store's response to the platform, not on what the caller receives. 5242880 (5 MiB) when unset
# MAX_QUERY_RESPONSE_LENGTH=5242880

# the store each Varnish in front of the triplestore keeps SPARQL results in, apart from its main one. A result too large
# for it ends the fetch, and the triplestore abandons the query, so it also bounds what one runaway query costs. 64M when unset
# VARNISH_SPARQL_STORAGE=64M

# the assistant's plan service image tag (ghcr.io/atomgraph/webalgebra-server-ldh); `local` for an image built from a REST-VKG checkout
# WEBALGEBRA_VERSION=latest
