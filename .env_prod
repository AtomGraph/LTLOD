# The .env of the production deployment on the shared host (kgdev.net): copy to .env there.
# Keep everything prod-specific here, not in .env - BASE_URI is derived from PROTOCOL, HOST and HTTPS_PORT.
COMPOSE_PROJECT_NAME=ltlod
# docker-compose.prod.yml: nginx stubbed out behind nginx-shared, prod memory limits
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.prod.yml

PROTOCOL=https
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_CLIENT_CERT_PORT=5443
HOST=linkeddata.lt

OWNER_MBOX=martynas@atomgraph.com
OWNER_GIVEN_NAME=Martynas
OWNER_FAMILY_NAME=Jusevičius
OWNER_ORG_UNIT=LTLOD
OWNER_ORGANIZATION=AtomGraph
OWNER_LOCALITY=Copenhagen
OWNER_STATE_OR_PROVINCE=Denmark
OWNER_COUNTRY_NAME=DK

MAX_CONTENT_LENGTH=4194304

OPENAI_MODEL=gpt-5.5
# starts the web-algebra sidecar, and makes the UI offer the assistant
# the assistant is off in prod (docker-compose.prod.yml keeps web-algebra from starting regardless)
# COMPOSE_PROFILES=assistant

# serves each dataspace's /sitemap.xml and lets robots.txt allow crawling; off unless set
ENABLE_SITEMAP=true
