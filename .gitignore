# the deployment's own settings, kept out of git: copy .env_sample to .env (LinkedDataHub's
# convention). .env_prod is committed - it is what the production server's .env is copied from
/.env

# ETL working files
etl/*/cache/
etl/tools/.venv/

# bulk generated data — regenerate with `make -C etl admin-units`
datasets/current/admin-units/settlements.trig
datasets/current/admin-units/settlements-geo.trig
datasets/current/admin-units/streets.trig
datasets/current/admin-units/streets-geo.trig

# full Legal Entities Register (~541k entities, ~14.4M quads, ~1 GB) — regenerate with
# `make -C etl/legal-entities entities`; the budget institutions stay committed
datasets/current/legal-entities/entities.trig
# bulk KVR heritage objects (~26k graphs, ~43 MB) — regenerate with `make -C etl facilities`
datasets/current/facilities/heritage.trig

# bulk Seimas votes — regenerate with `make -C etl/seimas votes`
datasets/current/seimas/votes.trig
# bulk Seimas agenda items (~10 MB per term) — regenerate with `make -C etl/seimas bills`
datasets/current/seimas/agenda-items.trig

# VRK campaign finance: the browser-harvested source CSVs (~60 MB, re-harvest with the
# harvest-vrk skill) and the bulk expense rows (~21 MB) — regenerate with
# `make -C etl/elections finance`
etl/elections/data/vrk-*.csv
datasets/current/elections/campaign-expenses.trig

# bulk procurement contracts (~56k a year, ~120 MB) — regenerate with `make -C etl procurement`
datasets/current/procurement/contracts.trig

# VTEK browser harvests (SKAIDRIS lobbying, PINREG private interests) — re-harvest with the
# harvest-vtek skill, never edit; data/institution-aliases.csv (curated) IS committed
etl/vtek/data/*.json

# Sodra employer data (~1.9M quads / 125 MB per-employer summary; the opt-in monthly cube
# ~14M quads / ~900 MB) and the browser-harvested source zips — regenerate with
# `make -C etl/sodra` after the harvest (.claude/skills/harvest-sodra/); the cube
# definitions dataset.trig are committed
datasets/current/employment/employers.trig
datasets/current/employment/observations-*.trig
etl/sodra/data/

# calendar (~243k quads, offline, ~15 s) — regenerate with `make -C etl calendar`
datasets/current/calendar/calendar.trig
__pycache__/

# compiled Saxon-JS SEF for the client-side XSLT override — regenerate with `make sef`
files/client.xsl.sef.json

# LinkedDataHub runtime state (bootstrapped by `make up`)
/ssl/
/secrets/
/fuseki/
/uploads/
/sef/
/packages/
/settings/
/datasets/owner/
/datasets/secretary/
docker-compose.override.yml
