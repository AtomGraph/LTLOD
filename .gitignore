# the deployment's own settings, kept out of git: copy .env_sample to .env (LinkedDataHub's
# convention). .env_prod is committed - it is what the production server's .env is copied from
/.env

# ETL working files
etl/*/cache/
etl/tools/.venv/

# bulk generated data — regenerate with `make -C etl admin-units`
datasets/current/admin-units/settlements.trig
datasets/current/admin-units/settlements-geo.trig
datasets/current/admin-units/streets.trig
datasets/current/admin-units/streets-geo.trig

# bulk Seimas votes — regenerate with `make -C etl/seimas votes`
datasets/current/seimas/votes.trig

# Sodra employer observations (~10M quads per year of months) and the browser-harvested
# source zips — regenerate with `make -C etl/sodra` after the harvest
# (.claude/skills/harvest-sodra/); the cube definition dataset.trig is committed
datasets/current/employment/observations-*.trig
etl/sodra/data/

# calendar (~243k quads, offline, ~15 s) — regenerate with `make -C etl calendar`
datasets/current/calendar/calendar.trig
__pycache__/

# compiled Saxon-JS SEF for the client-side XSLT override — regenerate with `make sef`
files/client.xsl.sef.json

# LinkedDataHub runtime state (bootstrapped by `make up`)
/ssl/
/secrets/
/fuseki/
/uploads/
/sef/
/packages/
/settings/
/datasets/owner/
/datasets/secretary/
docker-compose.override.yml
