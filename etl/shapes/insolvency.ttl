# SHACL shapes for insolvency proceedings (datasets/current/insolvency/*.trig,
# etl/insolvency/mappings/proceedings.rq). One ltlod:InsolvencyProceeding per document, keyed
# by {imones_kodas}-{start}; every proceeding carries a type, a start date, the company link
# and code, and a lifecycle interval beginning on a calendar day. Municipality, court,
# initiator, end instant and the flags/milestone dates are optional in the source.

PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX rov:    <http://www.w3.org/ns/regorg#>
PREFIX cv:     <http://data.europa.eu/m8g/>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
PREFIX :       <http://linkeddata.lt/shapes#>

:InsolvencyProceedingShape a sh:NodeShape ;
    sh:targetClass ltlod:InsolvencyProceeding ;
    sh:property
        [ sh:path dct:title ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:type ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/insolvency-types/[a-z]+/#this$" ] ,
        [ sh:path dct:date ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:insolvent ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[^/]+/#this$" ] ,
        [ sh:path ltlod:companyCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:companyName ; sh:datatype rdf:langString ; sh:maxCount 1 ] ,
        [ sh:path sdmx-dimension:refArea ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/admin-units/[0-9]+/#this$" ] ,
        [ sh:path ltlod:court ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/courts/[a-z]+/#this$" ] ,
        [ sh:path ltlod:initiatedBy ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/insolvency-initiators/[a-z-]+/#this$" ] ,
        [ sh:path ltlod:outOfCourt ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path ltlod:simplified ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path ltlod:intentional ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path ltlod:intentionalDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path ltlod:liquidationDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path ltlod:deregistrationDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path time:hasTime ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "#period$" ] .

# The proceeding's lifecycle: #start (court or out-of-court declaration) -> #end
# (deregistration or termination, absent while the proceeding is open), each on a calendar day.
:InsolvencyIntervalShape a sh:NodeShape ;
    sh:targetClass time:Interval ;
    sh:property
        [ sh:path time:hasBeginning ; sh:class time:Instant ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "#start$" ] ,
        [ sh:path time:hasEnd ; sh:class time:Instant ;
          sh:maxCount 1 ; sh:pattern "#end$" ] ,
        # readable period label ("2024-09-04 – 2025-07-15", "2024-09-04 – dabar")
        [ sh:path dct:title ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

:InsolvencyInstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:property
        [ sh:path time:inXSDDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] .
