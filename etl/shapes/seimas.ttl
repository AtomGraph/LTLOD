# SHACL shapes for the Seimas domain (datasets/current/seimas/*.trig).
# Membership -> interval -> instant chains live in the same graph/file, so
# sh:class applies; org:organization/org:role targets are cross-file -> IRI
# patterns only. foaf name properties are plain strings (NO language tag) by
# design — do not copy the langString pattern from labels.

PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX time:  <http://www.w3.org/2006/time#>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX epvoc: <https://data.europarl.europa.eu/def/epvoc#>
PREFIX schema: <https://schema.org/>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
PREFIX :      <http://linkeddata.lt/shapes#>

:PersonShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    sh:property
        [ sh:path foaf:givenName ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path foaf:familyName ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path foaf:name ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path foaf:gender ; sh:in ("male" "female") ; sh:maxCount 1 ] ,
        [ sh:path foaf:mbox ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "^mailto:" ] ,
        # normalized E.164 (Lithuanian numbers)
        [ sh:path foaf:phone ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "^tel:\\+370" ] ,
        [ sh:path foaf:isPrimaryTopicOf ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
        # no maxCount: every party that nominated the person in any term (the
        # per-term nomination sits on the tenure membership)
        [ sh:path ltlod:nominatedBy ; sh:nodeKind sh:IRI ;
          sh:pattern "/parties/[^/]+/#this$" ] .

:MembershipShape a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:property
        [ sh:path org:member ; sh:class foaf:Person ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        # the organization is the Seimas itself, or one of its structural units
        # / parliamentary groups nested under it (organizations/<org>/…)
        [ sh:path org:organization ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+(/org-units/[^/]+|/groups/[^/]+)?/#this$" ] ,
        # no maxCount: concurrent roles in one unit exist (chair + member)
        [ sh:path org:role ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
          sh:pattern "/taxonomies/position-types/[^/]+/#this$" ] ,
        [ sh:path org:memberDuring ; sh:class time:Interval ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        # Seimas seats only (tenure memberships); terms.trig is another file
        [ sh:path epvoc:memberDuringParliamentaryTerm ; sh:nodeKind sh:IRI ;
          sh:maxCount 1 ; sh:pattern "/organizations/[^/]+/terms/[^/]+/#this$" ] ,
        # the party that nominated the member for that seat (tenures only)
        [ sh:path ltlod:nominatedBy ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/parties/[^/]+/#this$" ] ,
        # single-member seats only; term-scoped district (constituencies/{term}-{nr}/)
        [ sh:path ltlod:electoralDistrict ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/constituencies/[0-9]+-[0-9]+/#this$" ] .

:IntervalShape a sh:NodeShape ;
    sh:targetClass time:Interval ;
    sh:property
        # mapping allows an open start; open end = current membership
        [ sh:path time:hasBeginning ; sh:class time:Instant ; sh:maxCount 1 ] ,
        [ sh:path time:hasEnd ; sh:class time:Instant ; sh:maxCount 1 ] ,
        # readable period label (e.g. "2024-11-14 – dabar"); absent when the
        # interval has no begin date. Plain string, no language tag. No maxCount:
        # a membership keyed on unit+start that holds concurrent roles with
        # differing per-role spans (same collision org:role allows) yields one
        # period label per span.
        [ sh:path dct:title ; sh:datatype xsd:string ] .

:InstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:property
        [ sh:path time:inXSDDate ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        # the calendar day of inXSDDate (calendar.trig is its own file)
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] .

:OrgUnitShape a sh:NodeShape ;
    sh:targetClass org:OrganizationalUnit ;
    sh:property
        # no maxCount: renamed units keep every name the feeds used
        # (e.g. org-units/8 "Ekonomikos komitetas" / "Ekonomikos ir inovacijų komitetas",
        # now at organizations/lietuvos-respublikos-seimas/org-units/8/)
        [ sh:path skos:prefLabel ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ] ,
        [ sh:path skos:altLabel ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        # type is inferred from the unit name for units absent from current
        # feeds — relax to maxCount-only if the heuristic misses a future unit
        [ sh:path dct:type ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/org-unit-types/[a-z-]+/#this$" ] ,
        [ sh:path org:unitOf ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/#this$" ] .

# calendar (terms.trig / sessions.trig / sittings.trig). Parent links cross
# files -> IRI patterns only; the term interval is in-file (Interval/Instant
# shapes above apply).
:ParliamentaryTermShape a sh:NodeShape ;
    sh:targetClass eli-dl:ParliamentaryTerm ;
    sh:property
        [ sh:path skos:prefLabel ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path time:hasTime ; sh:class time:Interval ;
          sh:minCount 1 ; sh:maxCount 1 ] .

# shared by sessions, sittings and agenda items (all eli-dl:Activity); the
# activity type only on sessions and sittings (:SessionShape, :SittingShape)
:ActivityShape a sh:NodeShape ;
    sh:targetClass eli-dl:Activity ;
    sh:property
        [ sh:path dct:title ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:had_activity_type ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/activity-types/[a-z-]+/#this$" ] ,
        [ sh:path eli-dl:parliamentary_term ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/terms/[^/]+/#this$" ] ,
        [ sh:path eli-dl:had_responsible_organization ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/#this$" ] .

# a session: whole-day dates; only the ongoing session lacks an end
:SessionShape a sh:NodeShape ;
    sh:targetClass schema:EventSeries ;
    sh:property
        [ sh:path eli-dl:had_activity_type ; sh:minCount 1 ] ,
        [ sh:path eli-dl:activity_start_date ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:activity_end_date ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        # the same period as a W3C Time interval (start/end instants -> days)
        [ sh:path time:hasTime ; sh:class time:Interval ; sh:minCount 1 ; sh:maxCount 1 ] .

# a plenary sitting: the day is always known except for a handful of
# scheduled-but-undated rows; start/end times only from ~1998 on
:SittingShape a sh:NodeShape ;
    sh:targetClass schema:Event ;
    sh:property
        [ sh:path eli-dl:had_activity_type ; sh:minCount 1 ] ,
        [ sh:path eli-dl:forms_part_of ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/sessions/[^/]+/#this$" ] ,
        [ sh:path eli-dl:activity_date ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        # the calendar day of activity_date (calendar.trig is its own file)
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path eli-dl:activity_start_date ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:activity_end_date ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:activity_order ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ,
        # protocol and stenogram in the e-seimas legal acts register
        [ sh:path eli-dl:recorded_in_a_realization_of ; sh:nodeKind sh:IRI ;
          sh:maxCount 2 ; sh:pattern "^https://e-seimas\\.lrs\\.lt/" ] .

# parties (parties.trig); the Seimas itself is app/ scaffolding, not ETL output
:FormalOrganizationShape a sh:NodeShape ;
    sh:targetClass org:FormalOrganization ;
    sh:property
        [ sh:path skos:prefLabel ; sh:datatype rdf:langString ;
          sh:languageIn ("lt" "en") ; sh:uniqueLang true ; sh:minCount 1 ] ,
        [ sh:path skos:prefLabel ;
          sh:qualifiedValueShape [ sh:languageIn ("lt") ] ; sh:qualifiedMinCount 1 ] ,
        [ sh:path foaf:homepage ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

# LinkedDataHub document hierarchy: every entity/concept document is a dh:Item
# attached to its container (sioc:has_container).
PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

:ItemShape a sh:NodeShape ;
    sh:targetClass dh:Item ;
    sh:property
        [ sh:path sioc:has_container ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ] .

# a plenary vote (votes.trig). eli-dl:Vote only — not also eli-dl:Activity, so
# :ActivityShape (activity type required) does not apply. Turnout only when
# someone voted; the favor/against/abstention counts and voters only in open
# votes (see mappings/votes.rq). Voters link to persons by IRI pattern (the
# persons are in persons.trig).
:VoteShape a sh:NodeShape ;
    sh:targetClass eli-dl:Vote ;
    sh:property
        [ sh:path dct:title ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path foaf:isPrimaryTopicOf ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "^https://www\\.lrs\\.lt/sip/portal\\.show\\?.*p_bals_id=" ] ,
        [ sh:path eli-dl:activity_label ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:decision_method ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/decision-methods/[a-z-]+/#this$" ] ,
        # the sitting, and the agenda item the vote was held on (agenda-items.trig)
        [ sh:path schema:superEvent ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 2 ;
          sh:pattern "/organizations/[^/]+/(sittings|agenda-items)/[^/]+/#this$" ] ,
        [ sh:path eli-dl:parliamentary_term ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/terms/[^/]+/#this$" ] ,
        [ sh:path eli-dl:had_responsible_organization ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/#this$" ] ,
        [ sh:path eli-dl:activity_date ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path eli-dl:activity_start_date ; sh:datatype xsd:dateTime ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:number_of_attendees ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:number_of_votes_favor ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:number_of_votes_against ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:number_of_votes_abstention ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:had_voter_favor ; sh:nodeKind sh:IRI ;
          sh:pattern "/persons/[^/]+/#this$" ] ,
        [ sh:path eli-dl:had_voter_against ; sh:nodeKind sh:IRI ;
          sh:pattern "/persons/[^/]+/#this$" ] ,
        [ sh:path eli-dl:had_voter_abstention ; sh:nodeKind sh:IRI ;
          sh:pattern "/persons/[^/]+/#this$" ] .

# a plenary agenda item (agenda-items.trig): eli-dl:Activity with no class of its
# own, so targeted by the properties only items carry; :ActivityShape covers the
# title, identifier, term and organization. Bills, stages and speakers are in other
# files -> IRI patterns.
:AgendaItemShape a sh:NodeShape ;
    sh:targetSubjectsOf eli-dl:occured_at_stage, eli-dl:involved_work, eli-dl:had_participant_person ;
    sh:property
        [ sh:path schema:superEvent ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/organizations/[^/]+/sittings/[^/]+/#this$" ] ,
        [ sh:path eli-dl:activity_label ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:activity_order ; sh:datatype xsd:decimal ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:occured_at_stage ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/process-stages/[a-z0-9-]+/#this$" ] ,
        [ sh:path eli-dl:activity_date ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path eli-dl:activity_start_date ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ,
        [ sh:path eli-dl:involved_work ; sh:nodeKind sh:IRI ;
          sh:pattern "/organizations/[^/]+/bills/[^/]+/#this$" ] ,
        [ sh:path eli-dl:had_participant_person ; sh:nodeKind sh:IRI ;
          sh:pattern "/persons/[^/]+/#this$" ] ,
        # the e-seimas document (TAP) on the planned agenda
        [ sh:path rdfs:seeAlso ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "^https://e-seimas\\.lrs\\.lt/" ] .

# a bill (bills.trig): registration date and initiators only for bills members
# initiated; Government/committee bills are known from the agenda only
:BillShape a sh:NodeShape ;
    sh:targetClass eli-dl:DraftLegislationWork ;
    sh:property
        [ sh:path dct:title ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "^[IVXL]+P-[0-9]+[A-Z]*$" ] ,
        [ sh:path eli-dl:legislative_process_work_date ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path eli-dl:legislative_process_work_creator ; sh:nodeKind sh:IRI ;
          sh:pattern "/persons/[^/]+/#this$" ] .
