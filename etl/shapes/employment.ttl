# SHACL shapes for the Sodra employer cube (datasets/current/employment/*.trig).
# Employers (legal-entities/), months (calendar/) and municipalities (admin-units/) are
# other files: IRI path-suffix patterns only, never sh:class. Observations are fragments
# of their employer's own graph, so sh:class applies to them.

PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX qb:     <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
PREFIX dh:     <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc:   <http://rdfs.org/sioc/ns#>
PREFIX :       <http://linkeddata.lt/shapes#>

:EmployerSliceShape a sh:NodeShape ;
    sh:targetClass qb:Slice ;
    sh:property
        [ sh:path ltlod:employer ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[0-9]{9}/#this$" ] ,
        [ sh:path qb:sliceStructure ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/employment/dataset/#slice-by-employer$" ] ,
        [ sh:path qb:observation ; sh:class qb:Observation ; sh:minCount 1 ] .

:ObservationShape a sh:NodeShape ;
    sh:targetClass qb:Observation ;
    sh:property
        [ sh:path qb:dataSet ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/employment/dataset/#this$" ] ,
        [ sh:path ltlod:employer ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[0-9]{9}/#this$" ] ,
        # the reference month: a calendar MONTH document, not a day
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/#this$" ] ,
        [ sh:path dct:date ; sh:datatype xsd:gYearMonth ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        # the registered municipality (AR sav_kodas); absent when Sodra's does not resolve
        [ sh:path sdmx-dimension:refArea ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/admin-units/[0-9]{2}/#this$" ] ,
        # measures: each may be unpublished (absent), never repeated
        [ sh:path ltlod:insuredCount ; sh:datatype xsd:integer ; sh:maxCount 1 ;
          sh:minInclusive 0 ] ,
        [ sh:path ltlod:averageWage ; sh:datatype xsd:decimal ; sh:maxCount 1 ;
          sh:minInclusive 0 ] ,
        [ sh:path ltlod:contributions ; sh:datatype xsd:decimal ; sh:maxCount 1 ] .

:DataSetShape a sh:NodeShape ;
    sh:targetClass qb:DataSet ;
    sh:property
        [ sh:path qb:structure ; sh:class qb:DataStructureDefinition ;
          sh:minCount 1 ; sh:maxCount 1 ] .

:ItemShape a sh:NodeShape ;
    sh:targetClass dh:Item ;
    sh:property
        [ sh:path sioc:has_container ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/employment/$" ] .
