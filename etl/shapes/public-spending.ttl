# SHACL shapes for public-sector invoice aggregates (datasets/current/public-spending/*.trig,
# etl/public-spending/mappings/aggregates.rq). One ltlod:SpendingAggregate per document, keyed
# by buyer-supplier-year; every one carries both parties (JAR codes), the calendar year, the
# invoice count and the billed / net totals.

PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
PREFIX :       <http://linkeddata.lt/shapes#>

:SpendingAggregateShape a sh:NodeShape ;
    sh:targetClass ltlod:SpendingAggregate ;
    sh:property
        [ sh:path dct:title ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:spendingBuyer ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[^/]+/#this$" ] ,
        [ sh:path ltlod:spendingSupplier ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[^/]+/#this$" ] ,
        [ sh:path dct:date ; sh:datatype xsd:gYear ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/#this$" ] ,
        [ sh:path ltlod:invoiceCount ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:billedTotal ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:billedNet ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] .
