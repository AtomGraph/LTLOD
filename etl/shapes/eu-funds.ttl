# SHACL shapes for 2014-2020 EU structural-funds contracts (datasets/current/eu-funds/*.trig,
# etl/eu-funds/mappings/contracts.rq). One ltlod:EUFundingContract per document, keyed by the
# source _id; every one carries a title, a beneficiary code and name. The project code,
# beneficiary legal-entity link, municipality, amounts, aid flags, start day and dates are
# present only where the source has them (most contracts are code-less instrument payouts).

PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
PREFIX :       <http://linkeddata.lt/shapes#>

:EUFundingContractShape a sh:NodeShape ;
    sh:targetClass ltlod:EUFundingContract ;
    sh:property
        [ sh:path dct:title ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
        [ sh:path ltlod:beneficiary ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[^/]+/#this$" ] ,
        [ sh:path ltlod:beneficiaryCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:beneficiaryName ; sh:datatype rdf:langString ; sh:maxCount 1 ] ,
        [ sh:path sdmx-dimension:refArea ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/admin-units/[0-9]+/#this$" ] ,
        [ sh:path ltlod:euAmount ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ,
        [ sh:path ltlod:totalAmount ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ,
        [ sh:path ltlod:decidedEuAmount ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ,
        [ sh:path ltlod:stateAid ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path ltlod:deMinimisAid ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path dct:date ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path ltlod:implementationFrom ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path ltlod:implementationTill ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path ltlod:fundingPartner ; sh:nodeKind sh:IRI ;
          sh:pattern "/legal-entities/[^/]+/#this$" ] .
