# SHACL shapes for the VTEK registers (datasets/current/vtek/*.trig): lobbyists,
# lobbying declarations (SKAIDRIS) and private-interest declarations (PINREG).
# Persons, legal entities, Seimas bills/org-units, calendar days and taxonomy concepts
# are other files: IRI path-suffix patterns only, never sh:class. Contacts, ties,
# intervals and instants are fragments of their own document, so sh:class applies.

PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX org:    <http://www.w3.org/ns/org#>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
PREFIX dh:     <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc:   <http://rdfs.org/sioc/ns#>
PREFIX :       <http://linkeddata.lt/shapes#>

:LobbyistShape a sh:NodeShape ;
    sh:targetClass ltlod:Lobbyist ;
    sh:property
        [ sh:path foaf:name ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "^LOB-(JA|FA)-[0-9]{4}-[0-9]{4}$" ] ,
        # the same agent elsewhere: a legal entity (by JAR) or a person (by unique name)
        [ sh:path ltlod:agent ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/(legal-entities/[0-9]{7,9}|persons/[^/]+)/#this$" ] ,
        [ sh:path ltlod:registrationDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path ltlod:registerStatus ; sh:in ("ACTIVE" "BLOCKED" "UNLISTED") ;
          sh:minCount 1 ; sh:maxCount 1 ] .

:LobbyingDeclarationShape a sh:NodeShape ;
    sh:targetClass ltlod:LobbyingDeclaration ;
    sh:property
        [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:lobbyist ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/lobbyists/LOB-(JA|FA)-[0-9]{4}-[0-9]{4}/#this$" ] ,
        [ sh:path ltlod:activityDate ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] ,
        [ sh:path dct:issued ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
        [ sh:path dct:subject ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/lobbying-areas/[a-z-]+/#this$" ] ,
        [ sh:path ltlod:draftAct ; sh:nodeKind sh:IRI ;
          sh:pattern "/organizations/lietuvos-respublikos-seimas/bills/X[IVX]*P-[0-9]+/#this$" ] ,
        [ sh:path ltlod:contact ; sh:class ltlod:LobbyingContact ] .

:LobbyingContactShape a sh:NodeShape ;
    sh:targetClass ltlod:LobbyingContact ;
    sh:property
        [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:influencedPerson ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/persons/[^/]+/#this$" ] ,
        [ sh:path ltlod:institution ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/(legal-entities/[0-9]{7,9}|organizations/lietuvos-respublikos-seimas(/org-units/[0-9-]+)?)/#this$" ] ,
        [ sh:path ltlod:influenceMode ; sh:in ("žodžiu"@lt "raštu"@lt) ; sh:maxCount 1 ] ,
        [ sh:path ltlod:counterpartDeclaration ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/lobbying-declarations/[^/]+/#this$" ] .

:InterestDeclarationShape a sh:NodeShape ;
    sh:targetClass ltlod:InterestDeclaration ;
    sh:property
        # a resolved person, else the declaration's own #declarant fragment
        [ sh:path ltlod:declarant ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "(/persons/[^/]+/#this|/interest-declarations/[^/]+/#declarant)$" ] ,
        [ sh:path dct:issued ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] .

# a PINREG tie (n-ary org:Membership); Seimas memberships live in other files
:InterestTieShape a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:property
        [ sh:path ltlod:declaredIn ; sh:class ltlod:InterestDeclaration ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path org:member ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path ltlod:organizationName ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path org:organization ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[0-9]{7,9}/#this$" ] ,
        [ sh:path ltlod:interestOrganization ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          sh:pattern "/legal-entities/[0-9]{7,9}/#this$" ] ,
        [ sh:path org:role ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/interest-roles/[a-z-]+/#this$" ] ,
        [ sh:path ltlod:inPublicProcurement ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path org:memberDuring ; sh:class time:Interval ; sh:maxCount 1 ] .

:IntervalShape a sh:NodeShape ;
    sh:targetClass time:Interval ;
    sh:property
        [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path time:hasBeginning ; sh:class time:Instant ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path time:hasEnd ; sh:class time:Instant ; sh:maxCount 1 ] .

:InstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:property
        [ sh:path time:inXSDDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] .

:ItemShape a sh:NodeShape ;
    sh:targetClass dh:Item ;
    sh:property
        [ sh:path sioc:has_container ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/(lobbyists|lobbying-declarations|interest-declarations)/$" ] .
