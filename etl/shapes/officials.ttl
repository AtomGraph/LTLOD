# SHACL shapes for the public officials (datasets/current/officials/*.trig).
# The file holds the new (non-Seimas) persons in full, plus office memberships that
# also land in Seimas persons' graphs (persons/{asmens_id}/, typed in
# seimas/persons.trig) — so org:member is an IRI pattern, not sh:class.
# Organizations, roles and calendar days are other files: IRI path-suffix patterns.
# foaf name properties are plain strings (NO language tag), as in seimas.ttl.

PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX owl:   <http://www.w3.org/2002/07/owl#>
PREFIX time:  <http://www.w3.org/2006/time#>
PREFIX dh:    <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc:  <http://rdfs.org/sioc/ns#>
PREFIX :      <http://linkeddata.lt/shapes#>

:OfficialShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    sh:property
        [ sh:path foaf:givenName ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path foaf:familyName ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path foaf:name ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        # Wikidata P21 / EP hasGender; absent where neither states it
        [ sh:path foaf:gender ; sh:in ("male" "female") ; sh:maxCount 1 ] ,
        # Wikidata item and/or EP person
        [ sh:path owl:sameAs ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
          sh:pattern "^(http://www\\.wikidata\\.org/entity/Q[0-9]+|https://data\\.europarl\\.europa\\.eu/person/[0-9]+)$" ] .

:OfficeShape a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:property
        [ sh:path org:member ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/persons/([0-9]+|Q[0-9]+|ep-[0-9]+)/#this$" ] ,
        # the Government / the President / the European Parliament, or a municipality
        [ sh:path org:organization ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "(/organizations/[^/]+|/admin-units/[0-9]{2})/#this$" ] ,
        [ sh:path org:role ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/taxonomies/position-types/[a-z-]+/#this$" ] ,
        [ sh:path org:memberDuring ; sh:class time:Interval ;
          sh:minCount 1 ; sh:maxCount 1 ] .

:OfficeIntervalShape a sh:NodeShape ;
    sh:targetClass time:Interval ;
    sh:property
        # every office has a start (undated ones are dropped); open end = current
        [ sh:path time:hasBeginning ; sh:class time:Instant ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path time:hasEnd ; sh:class time:Instant ; sh:maxCount 1 ] ,
        [ sh:path dct:title ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ] .

:OfficeInstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:property
        [ sh:path time:inXSDDate ; sh:datatype xsd:date ;
          sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:temporal ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/calendar/[0-9]{4}/[0-9]{2}/[0-9]{2}/#this$" ] .

:OfficialItemShape a sh:NodeShape ;
    sh:targetClass dh:Item ;
    sh:property
        [ sh:path sioc:has_container ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "/persons/$" ] .
