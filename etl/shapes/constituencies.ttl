# SHACL shapes for Seimas electoral districts
# (datasets/current/constituencies/*.trig). Apygardos are a controlled set
# keyed by district number, derived from the Seimas members feed — NOT
# administrative units (no dct:isPartOf into admin-units/).

PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX ltlod: <http://linkeddata.lt/ns#>
PREFIX :      <http://linkeddata.lt/shapes#>

:ElectoralDistrictShape a sh:NodeShape ;
    sh:targetClass ltlod:ElectoralDistrict ;
    sh:property
        [ sh:path skos:prefLabel ; sh:datatype rdf:langString ;
          sh:languageIn ("lt") ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path skos:notation ; sh:datatype xsd:string ;
          sh:pattern "^[0-9]+$" ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dct:identifier ; sh:datatype xsd:string ;
          sh:minCount 1 ; sh:maxCount 1 ; sh:equals skos:notation ] .

PREFIX dh:   <https://www.w3.org/ns/ldt/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

:ItemShape a sh:NodeShape ;
    sh:targetClass dh:Item ;
    sh:property
        [ sh:path sioc:has_container ; sh:nodeKind sh:IRI ;
          sh:minCount 1 ; sh:maxCount 1 ] .
