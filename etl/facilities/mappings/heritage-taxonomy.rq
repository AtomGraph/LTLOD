# The four SKOS schemes of the Cultural Property Register (KVR) facets, derived
# from the register itself by `ltlod-facilities heritage`:
#   heritage-statuses      legal protection status (statusas: Registrinis, Valstybės saugomas, …)
#   heritage-significance  level of significance (reikšmingumas: Nacionalinis, Regioninis, Vietinis)
#   heritage-kinds         object kind (potipis: Vieta, Statinys, Kitas nekilnojamas daiktas)
#   heritage-values        valuable-property kinds (vertingųjų savybių pobūdis: Archeologinis, …)
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            dct:created ?now ;
            sioc:has_container ?schemeGraph ;
            dct:title ?label ;
            foaf:primaryTopic ?concept .
        ?concept a skos:Concept ;
            skos:prefLabel ?label ;
            skos:notation ?slug ;
            skos:inScheme ?scheme ;
            skos:topConceptOf ?scheme .
    }
}
WHERE
{
    ?row <#scheme> ?schemeSlug ;
        <#slug> ?slug ;
        <#label> ?name .

    BIND(STRLANG(?name, "lt") AS ?label)
    BIND(uri(concat(str($base), "taxonomies/", ?schemeSlug, "/")) AS ?schemeGraph)
    BIND(uri(concat(str(?schemeGraph), "#this")) AS ?scheme)
    BIND(uri(concat(str(?schemeGraph), ?slug, "/")) AS ?graph)
    BIND(uri(concat(str(?graph), "#this")) AS ?concept)

    BIND(NOW() AS ?now)
}
