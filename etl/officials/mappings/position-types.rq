# The officials' positions as concepts of the existing position-types scheme
# (taxonomies/position-types/, whose Seimas concepts come from
# etl/seimas/mappings/position-types.rq): the President, the Prime Minister, one
# concept per ministerial portfolio, mayor and MEP. Input is the CSV2RDF output of
# cache/roles.csv — data/positions.csv plus the fixed mayor/MEP rows — one row per
# Wikidata position, several positions sharing a slug (Wikidata splits a portfolio
# whose ministry was renamed), each an skos:exactMatch of the concept.
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            dct:created ?now ;
            sioc:has_container ?schemeGraph ;
            dct:title ?labelLt ;
            foaf:primaryTopic ?concept .
        ?concept a skos:Concept ;
            skos:prefLabel ?labelLt, ?labelEn ;
            skos:notation ?slug ;
            skos:inScheme ?scheme ;
            skos:topConceptOf ?scheme ;
            skos:exactMatch ?wikidata .
    }
}
WHERE
{
    ?row <#slug> ?slug ;
        <#label_lt> ?lt ;
        <#label_en> ?en ;
        <#wikidata> ?qid .

    BIND(STRLANG(?lt, "lt") AS ?labelLt)
    BIND(STRLANG(?en, "en") AS ?labelEn)
    BIND(uri(concat("http://www.wikidata.org/entity/", ?qid)) AS ?wikidata)
    BIND(uri(concat(str($base), "taxonomies/position-types/")) AS ?schemeGraph)
    BIND(uri(concat(str(?schemeGraph), "#this")) AS ?scheme)
    BIND(uri(concat(str(?schemeGraph), ?slug, "/")) AS ?graph)
    BIND(uri(concat(str(?graph), "#this")) AS ?concept)

    BIND(NOW() AS ?now)
}
