# SKOS scheme of Seimas voting methods — the ELI-DL eli-dl:DecisionMethod list
# ("Atviras", "Pritarta bendru sutarimu", "Alternatyvus balsavimas", "Slaptas"), derived
# from the distinct values in the vote feeds, so it stays in sync with the data.
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>

PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            sioc:has_container ?schemeGraph ;
            dct:title ?label ;
            foaf:primaryTopic ?concept .
        ?concept a skos:Concept, eli-dl:DecisionMethod ;
            skos:prefLabel ?label ;
            skos:notation ?slug ;
            skos:inScheme ?scheme ;
            skos:topConceptOf ?scheme .
    }
}
WHERE
{
    ?row <#balsavimo_tipo_slug> ?slug ;
        <#balsavimo_tipas> ?name .

    BIND(STRLANG(CONCAT(UCASE(SUBSTR(?name, 1, 1)), SUBSTR(?name, 2)), "lt") AS ?label)
    BIND(uri(concat(str($base), "taxonomies/decision-methods/")) AS ?schemeGraph)
    BIND(uri(concat(str(?schemeGraph), "#this")) AS ?scheme)
    BIND(uri(concat(str(?schemeGraph), ?slug, "/")) AS ?graph)
    BIND(uri(concat(str(?graph), "#this")) AS ?concept)
}
