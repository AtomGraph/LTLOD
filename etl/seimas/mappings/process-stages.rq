# SKOS scheme of the stages at which the Seimas considers an agenda item — the
# ELI-DL eli-dl:ProcessStage list ("Pateikimas", "Svarstymas", "Priėmimas",
# "Grąžinto įstatymo pateikimas", …), derived from the distinct values in the agenda
# feeds (agenda-items.xsl), so it stays in sync with the data.
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>

PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            dct:created ?now ;
            sioc:has_container ?schemeGraph ;
            dct:title ?label ;
            foaf:primaryTopic ?concept .
        ?concept a skos:Concept, eli-dl:ProcessStage ;
            skos:prefLabel ?label ;
            skos:notation ?slug ;
            skos:inScheme ?scheme ;
            skos:topConceptOf ?scheme .
    }
}
WHERE
{
    ?row <#stadijos_slug> ?slug ;
        <#stadija> ?name .

    BIND(STRLANG(CONCAT(UCASE(SUBSTR(?name, 1, 1)), SUBSTR(?name, 2)), "lt") AS ?label)
    BIND(uri(concat(str($base), "taxonomies/process-stages/")) AS ?schemeGraph)
    BIND(uri(concat(str(?schemeGraph), "#this")) AS ?scheme)
    BIND(uri(concat(str(?schemeGraph), ?slug, "/")) AS ?graph)
    BIND(uri(concat(str(?graph), "#this")) AS ?concept)

    BIND(NOW() AS ?now)
}
