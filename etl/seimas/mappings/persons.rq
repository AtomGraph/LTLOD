# Seimas members as foaf:Person, one per named graph, with org:Membership
# resources (n-ary pattern + time:Interval — no reification) for the Seimas seat,
# committee/commission/faction positions, and parliamentary-group memberships.
# The input holds one member row per term served (all terms since 1990), so a
# person gets one seat (tenure) per term, each with its own nominating party;
# the person-level ltlod:nominatedBy collects every party that ever nominated
# them. The member rows, position rows and group rows are matched in three
# independent UNION branches — joining them on ?id in one pattern would multiply
# every term row by every position by every group.
# Every start/end time:Instant also links to its calendar day (dct:temporal ->
# calendar/{yyyy}/{mm}/{dd}/#this, minted from the date; etl/calendar/), so the
# day page lists whose memberships began or ended on it.
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX org:    <http://www.w3.org/ns/org#>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX ltlod:  <http://linkeddata.lt/ns#>
PREFIX epvoc:  <https://data.europarl.europa.eu/def/epvoc#>

PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            dct:created ?now ;
            sioc:has_container ?container ;
            dct:title ?fullName ;
            foaf:primaryTopic ?person ;
            foaf:topic ?tenure, ?membership, ?pgMembership .

        ?person a foaf:Person ;
            foaf:givenName ?givenName ;
            foaf:familyName ?familyName ;
            foaf:name ?fullName ;
            foaf:gender ?gender ;
            foaf:mbox ?mbox ;
            foaf:phone ?phone ;
            foaf:isPrimaryTopicOf ?bio ;
            ltlod:nominatedBy ?party .

        ?tenure a org:Membership ;
            org:member ?person ;
            org:organization ?seimas ;
            org:role ?mpRole ;
            org:memberDuring ?tenureInterval ;
            epvoc:memberDuringParliamentaryTerm ?parliamentaryTerm ;
            ltlod:electoralDistrict ?district ;
            ltlod:nominatedBy ?party .
        ?tenureInterval a time:Interval ;
            dct:title ?tenureIntervalTitle ;
            time:hasBeginning ?tenureStart ;
            time:hasEnd ?tenureEnd .
        ?tenureStart a time:Instant ; time:inXSDDate ?tenureFrom ; dct:temporal ?tenureFromDay .
        ?tenureEnd a time:Instant ; time:inXSDDate ?tenureTo ; dct:temporal ?tenureToDay .

        ?membership a org:Membership ;
            org:member ?person ;
            org:organization ?unit ;
            org:role ?role ;
            org:memberDuring ?mInterval .
        ?mInterval a time:Interval ;
            dct:title ?mIntervalTitle ;
            time:hasBeginning ?mStart ;
            time:hasEnd ?mEnd .
        ?mStart a time:Instant ; time:inXSDDate ?mFrom ; dct:temporal ?mFromDay .
        ?mEnd a time:Instant ; time:inXSDDate ?mTo ; dct:temporal ?mToDay .

        ?pgMembership a org:Membership ;
            org:member ?person ;
            org:organization ?pgroup ;
            org:role ?pgRole ;
            org:memberDuring ?pgInterval .
        ?pgInterval a time:Interval ;
            dct:title ?pgIntervalTitle ;
            time:hasBeginning ?pgStart ;
            time:hasEnd ?pgEnd .
        ?pgStart a time:Instant ; time:inXSDDate ?pgFrom ; dct:temporal ?pgFromDay .
        ?pgEnd a time:Instant ; time:inXSDDate ?pgTo ; dct:temporal ?pgToDay .
    }
}
WHERE
{
    BIND(uri(concat(str($base), "persons/")) AS ?container)

    {
        # member rows: the person + the Seimas seat of one term
        ?row <#asmens_id> ?id ;
            <#vardas> ?givenName ;
            <#pavarde> ?familyName .
        OPTIONAL { ?row <#lytis> ?lytis }
        OPTIONAL { ?row <#el_pastas> ?email }
        OPTIONAL { ?row <#telefonas> ?phoneRaw }
        OPTIONAL { ?row <#biografijos_nuoroda> ?bioUrl }
        OPTIONAL { ?row <#partijos_slug> ?partySlug }
        OPTIONAL { ?row <#kadencijos_id> ?kadencija }
        OPTIONAL { ?row <#data_nuo> ?tenureFromRaw }
        OPTIONAL { ?row <#data_iki> ?tenureToRaw }
        OPTIONAL { ?row <#apygardos_nr> ?districtNr }

        BIND(uri(concat(str($base), "persons/", encode_for_uri(?id), "/")) AS ?graph)
        BIND(uri(concat(str(?graph), "#this")) AS ?person)
        BIND(concat(?givenName, " ", ?familyName) AS ?fullName)
        BIND(IF(?lytis = "V", "male", IF(?lytis = "M", "female", ?undef)) AS ?gender)
        BIND(IF(BOUND(?email) && ?email != "", uri(concat("mailto:", ?email)), ?undef) AS ?mbox)

        # normalize phone numbers to tel: URIs (E.164, country code +370), as in
        # LinkedDataHub-Apps ETL mappings; bare 7-digit numbers are Vilnius
        # landlines (area code 5), the national format drops the leading 8;
        # unrecognized formats yield no tel: URI
        BIND(REPLACE(COALESCE(?phoneRaw, ""), "[^0-9+]", "") AS ?phoneDigits)
        BIND(IF(STRSTARTS(?phoneDigits, "+370"), ?phoneDigits,
             IF(STRSTARTS(?phoneDigits, "370") && STRLEN(?phoneDigits) = 11, concat("+", ?phoneDigits),
             IF(STRSTARTS(?phoneDigits, "8") && STRLEN(?phoneDigits) = 9, concat("+370", SUBSTR(?phoneDigits, 2)),
             IF(STRLEN(?phoneDigits) = 7, concat("+3705", ?phoneDigits),
             ?undef)))) AS ?phoneE164)
        BIND(IF(BOUND(?phoneE164), uri(concat(str(<tel:>), ?phoneE164)), ?undef) AS ?phone)
        BIND(IF(BOUND(?bioUrl), uri(?bioUrl), ?undef) AS ?bio)
        BIND(IF(BOUND(?partySlug), uri(concat(str($base), "parties/", ?partySlug, "/#this")), ?undef) AS ?party)

        # Seimas seat as a Membership with a validity interval, keyed by term +
        # start date (a member may leave and return within one term)
        BIND(uri(concat(str($base), "organizations/lietuvos-respublikos-seimas/#this")) AS ?seimas)
        BIND(uri(concat(str($base), "taxonomies/position-types/seimo-narys/#this")) AS ?mpRole)
        # electoral district (apygarda) of a single-member seat, parsed from
        # išrinkimo_būdas by xslt/nariai.xsl (party-list seats have none).
        # District numbers are reused for different districts in every
        # election, so a district is term-scoped: constituencies/{kadencijos_id}-{nr}/
        # (constituencies.rq).
        BIND(IF(BOUND(?districtNr) && BOUND(?kadencija), uri(concat(str($base), "constituencies/", encode_for_uri(?kadencija), "-", ?districtNr, "/#this")), ?undef) AS ?district)
        BIND(uri(concat(str(?graph), "#tenure-", COALESCE(?kadencija, "x"), "-",
            REPLACE(COALESCE(?tenureFromRaw, ""), "-", ""))) AS ?tenure)
        # the seat's term (terms.rq), minted from the bare kadencijos_id
        BIND(IF(BOUND(?kadencija), uri(concat(str($base), "organizations/lietuvos-respublikos-seimas/terms/", encode_for_uri(?kadencija), "/#this")), ?undef) AS ?parliamentaryTerm)
        BIND(uri(concat(str(?tenure), "-interval")) AS ?tenureInterval)
        BIND(IF(BOUND(?tenureFromRaw) && ?tenureFromRaw != "", uri(concat(str(?tenure), "-start")), ?undef) AS ?tenureStart)
        BIND(IF(BOUND(?tenureToRaw) && ?tenureToRaw != "", uri(concat(str(?tenure), "-end")), ?undef) AS ?tenureEnd)
        BIND(IF(BOUND(?tenureStart), STRDT(?tenureFromRaw, xsd:date), ?undef) AS ?tenureFrom)
        BIND(IF(BOUND(?tenureEnd), STRDT(?tenureToRaw, xsd:date), ?undef) AS ?tenureTo)
        BIND(IF(BOUND(?tenureFrom), uri(concat(str($base), "calendar/", REPLACE(STR(?tenureFrom), "-", "/"), "/#this")), ?undef) AS ?tenureFromDay)
        BIND(IF(BOUND(?tenureTo), uri(concat(str($base), "calendar/", REPLACE(STR(?tenureTo), "-", "/"), "/#this")), ?undef) AS ?tenureToDay)
        # readable period label for the interval — surfaced as the "Laikotarpis"
        # cell in the memberships table (files/client.xsl); ongoing = no end date
        BIND(IF(BOUND(?tenureFromRaw) && ?tenureFromRaw != "",
            CONCAT(?tenureFromRaw, " – ", IF(BOUND(?tenureToRaw) && ?tenureToRaw != "", ?tenureToRaw, "dabar")),
            ?undef) AS ?tenureIntervalTitle)
    }
    UNION
    {
        # positions in Seimas structural units (committees, commissions, factions)
        ?prow <#pareigos_asmens_id> ?id ;
            <#padalinio_id> ?unitId ;
            <#pareigu_slug> ?roleSlug .
        OPTIONAL { ?prow <#pareigos_nuo> ?mFromRaw }
        OPTIONAL { ?prow <#pareigos_iki> ?mToRaw }

        BIND(uri(concat(str($base), "persons/", encode_for_uri(?id), "/")) AS ?graph)
        BIND(uri(concat(str(?graph), "#this")) AS ?person)
        BIND(uri(concat(str($base), "organizations/lietuvos-respublikos-seimas/org-units/", encode_for_uri(?unitId), "/#this")) AS ?unit)
        BIND(uri(concat(str($base), "taxonomies/position-types/", ?roleSlug, "/#this")) AS ?role)
        BIND(uri(concat(str(?graph), "#membership-", encode_for_uri(?unitId), "-",
            REPLACE(COALESCE(?mFromRaw, ""), "-", ""))) AS ?membership)
        BIND(uri(concat(str(?membership), "-interval")) AS ?mInterval)
        BIND(IF(BOUND(?mFromRaw) && ?mFromRaw != "", uri(concat(str(?membership), "-start")), ?undef) AS ?mStart)
        BIND(IF(BOUND(?mToRaw) && ?mToRaw != "", uri(concat(str(?membership), "-end")), ?undef) AS ?mEnd)
        BIND(IF(BOUND(?mStart), STRDT(?mFromRaw, xsd:date), ?undef) AS ?mFrom)
        BIND(IF(BOUND(?mEnd), STRDT(?mToRaw, xsd:date), ?undef) AS ?mTo)
        BIND(IF(BOUND(?mFrom), uri(concat(str($base), "calendar/", REPLACE(STR(?mFrom), "-", "/"), "/#this")), ?undef) AS ?mFromDay)
        BIND(IF(BOUND(?mTo), uri(concat(str($base), "calendar/", REPLACE(STR(?mTo), "-", "/"), "/#this")), ?undef) AS ?mToDay)
        BIND(IF(BOUND(?mFromRaw) && ?mFromRaw != "",
            CONCAT(?mFromRaw, " – ", IF(BOUND(?mToRaw) && ?mToRaw != "", ?mToRaw, "dabar")),
            ?undef) AS ?mIntervalTitle)
    }
    UNION
    {
        # parliamentary (interest) group memberships
        ?grow <#pareigos_asmens_id> ?id ;
            <#parlamentines_grupes_id> ?groupId ;
            <#pareigu_slug> ?pgRoleSlug .
        OPTIONAL { ?grow <#pareigos_nuo> ?pgFromRaw }
        OPTIONAL { ?grow <#pareigos_iki> ?pgToRaw }

        BIND(uri(concat(str($base), "persons/", encode_for_uri(?id), "/")) AS ?graph)
        BIND(uri(concat(str(?graph), "#this")) AS ?person)
        BIND(uri(concat(str($base), "organizations/lietuvos-respublikos-seimas/groups/", encode_for_uri(?groupId), "/#this")) AS ?pgroup)
        BIND(uri(concat(str($base), "taxonomies/position-types/", ?pgRoleSlug, "/#this")) AS ?pgRole)
        BIND(uri(concat(str(?graph), "#pg-membership-", encode_for_uri(?groupId), "-",
            REPLACE(COALESCE(?pgFromRaw, ""), "-", ""))) AS ?pgMembership)
        BIND(uri(concat(str(?pgMembership), "-interval")) AS ?pgInterval)
        BIND(IF(BOUND(?pgFromRaw) && ?pgFromRaw != "", uri(concat(str(?pgMembership), "-start")), ?undef) AS ?pgStart)
        BIND(IF(BOUND(?pgToRaw) && ?pgToRaw != "", uri(concat(str(?pgMembership), "-end")), ?undef) AS ?pgEnd)
        BIND(IF(BOUND(?pgStart), STRDT(?pgFromRaw, xsd:date), ?undef) AS ?pgFrom)
        BIND(IF(BOUND(?pgEnd), STRDT(?pgToRaw, xsd:date), ?undef) AS ?pgTo)
        BIND(IF(BOUND(?pgFrom), uri(concat(str($base), "calendar/", REPLACE(STR(?pgFrom), "-", "/"), "/#this")), ?undef) AS ?pgFromDay)
        BIND(IF(BOUND(?pgTo), uri(concat(str($base), "calendar/", REPLACE(STR(?pgTo), "-", "/"), "/#this")), ?undef) AS ?pgToDay)
        BIND(IF(BOUND(?pgFromRaw) && ?pgFromRaw != "",
            CONCAT(?pgFromRaw, " – ", IF(BOUND(?pgToRaw) && ?pgToRaw != "", ?pgToRaw, "dabar")),
            ?undef) AS ?pgIntervalTitle)
    }

    BIND(NOW() AS ?now)
}
