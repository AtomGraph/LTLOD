PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX qb:    <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX ltlod: <http://linkeddata.lt/ns#>

PREFIX dh:    <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc:  <http://rdfs.org/sioc/ns#>

# Sodra per-insurer monthly figures as W3C Data Cube observations, one document per
# employer: employment/{ja_kodas}/. Input: one chunk CSV of the ltlod-sodra normalizer
# (one row per employer and month, every employer's rows in the same chunk).
#
# #this is the employer's series — a qb:Slice of the employment/dataset/ cube with the
# employer dimension fixed (ltlod:employer -> legal-entities/{ja_kodas}/#this, minted
# from the bare JAR code). Each month is a #{yyyy-mm} qb:Observation carrying every
# dimension (normalized form: queryable without the slice): employer, the calendar
# month (dct:temporal -> calendar/{yyyy}/{mm}/#this, plus the dct:date literal for
# sorting) and the registered municipality (sdmx-dimension:refArea), and the three
# measures — insured persons, average wage (EUR) and contributions (EUR) — as published.
# Sodra leaves a value empty when it does not publish it; the measure is then absent.
CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            dct:created ?now ;
            sioc:has_container ?container ;
            dct:title ?title ;
            foaf:primaryTopic ?this .

        ?this a qb:Slice ;
            dct:title ?title ;
            qb:sliceStructure ?sliceKey ;
            ltlod:employer ?employer ;
            qb:observation ?obs .

        ?obs a qb:Observation ;
            qb:dataSet ?dataset ;
            dct:title ?obsTitle ;
            ltlod:employer ?employer ;
            dct:temporal ?month ;
            dct:date ?yearMonth ;
            sdmx-dimension:refArea ?area ;
            ltlod:insuredCount ?insured ;
            ltlod:averageWage ?wage ;
            ltlod:contributions ?contributions .
    }
}
WHERE
{
    ?row <#jar> ?jar ;
        <#name> ?name ;
        <#month> ?monthRaw .
    OPTIONAL { ?row <#municipality> ?areaCode . FILTER(?areaCode != "") }
    OPTIONAL { ?row <#insured> ?insuredRaw . FILTER(?insuredRaw != "") }
    OPTIONAL { ?row <#avg_wage> ?wageRaw . FILTER(?wageRaw != "") }
    OPTIONAL { ?row <#contributions> ?contributionsRaw . FILTER(?contributionsRaw != "") }

    BIND(uri(concat(str($base), "employment/")) AS ?container)
    BIND(uri(concat(str(?container), encode_for_uri(?jar), "/")) AS ?graph)
    BIND(uri(concat(str(?graph), "#this")) AS ?this)
    BIND(uri(concat(str(?graph), "#", ?monthRaw)) AS ?obs)
    BIND(uri(concat(str(?container), "dataset/#this")) AS ?dataset)
    BIND(uri(concat(str(?container), "dataset/#slice-by-employer")) AS ?sliceKey)
    BIND(uri(concat(str($base), "legal-entities/", encode_for_uri(?jar), "/#this")) AS ?employer)
    BIND(STRLANG(concat(?name, ": apdraustieji ir darbo užmokestis"), "lt") AS ?title)
    BIND(STRLANG(concat(?name, ", ", ?monthRaw), "lt") AS ?obsTitle)
    BIND(uri(concat(str($base), "calendar/", REPLACE(?monthRaw, "-", "/"), "/#this")) AS ?month)
    BIND(STRDT(?monthRaw, xsd:gYearMonth) AS ?yearMonth)
    BIND(IF(BOUND(?areaCode), uri(concat(str($base), "admin-units/", encode_for_uri(?areaCode), "/#this")), ?undef) AS ?area)
    BIND(IF(BOUND(?insuredRaw), xsd:integer(?insuredRaw), ?undef) AS ?insured)
    BIND(IF(BOUND(?wageRaw), xsd:decimal(?wageRaw), ?undef) AS ?wage)
    BIND(IF(BOUND(?contributionsRaw), xsd:decimal(?contributionsRaw), ?undef) AS ?contributions)

    BIND(NOW() AS ?now)
}
