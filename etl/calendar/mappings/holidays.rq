# Public holidays (švenčių dienos, Darbo kodeksas art. 123) as SKOS concepts in
# taxonomies/holidays/. Source of truth: data/holidays.csv, one row per holiday
# and validity period (a holiday abolished and later restored has two rows), so
# the concept triples repeat per row and the CONSTRUCT merges them. The calendar
# mapping (calendar.rq) reads the same CSV to mark the days (dct:type).
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

PREFIX dh:   <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#>
PREFIX sioc: <http://rdfs.org/sioc/ns#>

CONSTRUCT
{
    GRAPH ?graph
    {
        ?graph a dh:Item ;
            dct:created ?now ;
            sioc:has_container ?schemeGraph ;
            dct:title ?labelLt ;
            foaf:primaryTopic ?concept .

        ?concept a skos:Concept ;
            skos:prefLabel ?labelLt, ?labelEn ;
            skos:notation ?notation ;
            skos:scopeNote ?scope ;
            skos:inScheme ?scheme ;
            skos:topConceptOf ?scheme .
    }
}
WHERE
{
    ?row <#notation> ?notation ;
        <#label_lt> ?labelLtRaw ;
        <#label_en> ?labelEnRaw ;
        <#scope_lt> ?scopeRaw .

    BIND(STRLANG(?labelLtRaw, "lt") AS ?labelLt)
    BIND(STRLANG(?labelEnRaw, "en") AS ?labelEn)
    BIND(STRLANG(?scopeRaw, "lt") AS ?scope)
    BIND(uri(concat(str($base), "taxonomies/holidays/")) AS ?schemeGraph)
    BIND(uri(concat(str(?schemeGraph), "#this")) AS ?scheme)
    BIND(uri(concat(str(?schemeGraph), encode_for_uri(?notation), "/")) AS ?graph)
    BIND(uri(concat(str(?graph), "#this")) AS ?concept)

    BIND(NOW() AS ?now)
}
